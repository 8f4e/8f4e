{
  "name": "@8f4e/editor-plugin-project-files",
  "version": "0.1.3",
  "private": true,
  "description": "Project file access and one-shot source export plugins for the 8f4e editor",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./export": {
      "types": "./dist/export.d.ts",
      "default": "./dist/export.js"
    }
  },
  "sideEffects": false,
  "author": "Andor Polgar",
  "license": "MIT",
  "dependencies": {
    "@8f4e/editor-core": "*",
    "@8f4e/editor-state": "*",
    "@8f4e/editor-state-types": "*",
    "@8f4e/language-spec": "*",
    "@8f4e/project-preparser": "*"
  },
  "devDependencies": {
    "@8f4e/config": "*",
    "vitest": "4.1.12",
    "@8f4e/editor-state-testing": "*",
    "@8f4e/web-ui": "*"
  },
  "nx": {
    "projectType": "library",
    "targets": {
      "build": { "command": "rm -rf dist && tsc" },
      "typecheck": {},
      "lint": {},
      "test": { "command": "vitest run" }
    },
    "tags": ["type:library", "scope:editor"]
  }
}
