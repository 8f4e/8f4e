{
  "name": "@8f4e/compiler-worker",
  "version": "5.2.0",
  "private": true,
  "description": "8f4e compiler worker package",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/8f4e/8f4e.git"
  },
  "author": "Andor Polgar",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/8f4e/8f4e/issues"
  },
  "homepage": "https://github.com/8f4e/8f4e#readme",
  "dependencies": {
    "@8f4e/compiler": "*",
    "@8f4e/language-spec": "*",
    "@8f4e/compiler-diagnostics": "*"
  },
  "devDependencies": {},
  "nx": {
    "projectType": "library",
    "targets": {
      "build": { "command": "rm -rf dist && tsc" },
      "lint": {},
      "dev": { "command": "tsc --watch" },
      "test": { "executor": "@nx/vitest:test" },
      "typecheck": { "command": "tsc --noEmit" }
    },
    "tags": ["type:runtime", "scope:editor"]
  }
}
