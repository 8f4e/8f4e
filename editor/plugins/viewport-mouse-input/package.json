{
  "name": "@8f4e/editor-plugin-viewport-mouse-input",
  "version": "0.2.9",
  "private": true,
  "description": "Outside-canvas desktop mouse drag capture for the 8f4e editor",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "author": "Andor Polgar",
  "license": "MIT",
  "dependencies": {
    "@8f4e/editor-core": "*",
    "@8f4e/editor-plugin-mouse-input": "*",
    "@8f4e/editor-state-types": "*"
  },
  "devDependencies": {
    "@8f4e/config": "*"
  },
  "nx": {
    "projectType": "library",
    "targets": {
      "build": { "command": "rm -rf dist && tsc" },
      "typecheck": { "command": "tsc --noEmit" },
      "lint": {}
    },
    "tags": ["type:library", "scope:editor"]
  }
}
