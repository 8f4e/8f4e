{
  "name": "@8f4e/editor-plugin-undo-redo",
  "version": "0.1.3",
  "private": true,
  "description": "Undo and redo for authored 8f4e editor source",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "author": "Andor Polgar",
  "license": "MIT",
  "dependencies": {
    "@8f4e/editor-core": "*",
    "@8f4e/editor-state": "*",
    "@8f4e/editor-state-types": "*"
  },
  "devDependencies": {
    "@8f4e/config": "*",
    "@8f4e/editor-state-testing": "*",
    "@8f4e/language-spec": "*",
    "@8f4e/web-ui": "*",
    "@types/node": "24.13.2",
    "vitest": "4.1.12"
  },
  "nx": {
    "projectType": "library",
    "targets": {
      "build": { "command": "rm -rf dist && tsc" },
      "test": { "command": "vitest run" },
      "typecheck": {},
      "lint": {}
    },
    "tags": ["type:library", "scope:editor"]
  }
}
