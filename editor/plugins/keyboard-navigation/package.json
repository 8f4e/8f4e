  },
  "devDependencies": {
    "@8f4e/editor-state-testing": "*",
    "@8f4e/config": "*",
    "@8f4e/web-ui": "*",
    "vitest": "4.1.12",
    "@types/node": "24.19.2"
  },
  "nx": {
