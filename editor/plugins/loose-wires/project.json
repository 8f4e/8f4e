{
  "name": "@8f4e/editor-plugin-loose-wires",
  "sourceRoot": "src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": { "command": "rm -rf dist && tsc", "cwd": "{projectRoot}" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit", "cwd": "{projectRoot}" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome check --write editor/plugins/loose-wires/src",
        "cwd": "{workspaceRoot}"
      }
    },
    "test:screenshot": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": { "command": "vitest run --config vitest.browser.config.ts", "cwd": "{projectRoot}" }
    }
  },
  "tags": ["type:library", "scope:editor"]
}
