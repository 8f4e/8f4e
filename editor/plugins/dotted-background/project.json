{
  "name": "@8f4e/editor-plugin-dotted-background",
  "sourceRoot": "editor/plugins/dotted-background/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "rm -rf dist && tsc",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "vitest run",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.test.json",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome check --write src screenshot-tests",
        "cwd": "{projectRoot}"
      }
    },
    "test:screenshot": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "vitest --config=vitest.browser.config.ts --run",
        "cwd": "{projectRoot}"
      }
    }
  },
  "tags": ["type:library", "scope:editor"]
}
