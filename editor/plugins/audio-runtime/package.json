{
  "name": "@8f4e/editor-plugin-audio-runtime",
  "version": "0.3.8",
  "private": true,
  "description": "audio runtime plugin for the 8f4e editor",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "author": "Andor Polgar",
  "license": "MIT",
  "dependencies": {
    "@8f4e/editor-core": "*",
    "@8f4e/runtime-audio-worklet": "*"
  },
  "devDependencies": {
    "@8f4e/config": "*",
    "vitest": "4.1.12",
    "vite": "7.3.8",
    "@8f4e/compiler": "*",
    "@8f4e/editor-state": "*",
    "@8f4e/web-ui": "*",
    "@types/node": "24.13.2"
  },
  "nx": {
    "projectType": "library",
    "targets": {
      "build": { "command": "rm -rf dist && tsc" },
      "test": { "command": "vitest run" },
      "typecheck": {}
    },
    "tags": ["type:library", "scope:editor"]
  }
}
