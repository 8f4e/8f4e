{
  "name": "@8f4e/runtime-test-runner",
  "version": "0.4.8",
  "private": true,
  "description": "8f4e runtime that executes tests once after compilation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/8f4e/8f4e.git"
  },
  "author": "Andor Polgar",
  "license": "MIT",
  "dependencies": {
    "@8f4e/language-spec": "*",
    "@8f4e/test-runner": "*"
  },
  "devDependencies": {
    "@8f4e/compiler": "*",
    "@8f4e/config": "*",
    "@types/node": "24.19.2",
    "vitest": "4.1.12"
  },
  "nx": {
    "projectType": "library",
    "targets": {
      "build": { "command": "rm -rf dist && tsc" },
      "lint": {},
      "dev": { "command": "tsc --watch" },
      "test": { "executor": "@nx/vitest:test" },
      "typecheck": {}
    },
    "tags": ["type:runtime", "scope:testing"]
  }
}
