{
  "name": "@8f4e/runtime-test-runner",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "rm -rf dist && tsc",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome check --write src",
        "cwd": "{projectRoot}"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --watch",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": [
        "{workspaceRoot}/coverage/@8f4e/runtime-test-runner"
      ],
      "options": {
        "config": "{projectRoot}/vitest.config.ts",
        "reportsDirectory": "{workspaceRoot}/coverage/@8f4e/runtime-test-runner"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.test.json",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "^build"
      ]
    }
  },
  "tags": [
    "type:runtime",
    "scope:testing"
  ]
}
