{
  "name": "@8f4e/editor-state",
  "version": "6.2.1",
  "private": true,
  "description": "8f4e editor state management package",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "default": "./dist/memory.js"
    }
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/8f4e/8f4e.git"
  },
  "author": "Andor Polgar",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/8f4e/8f4e/issues"
  },
  "homepage": "https://github.com/8f4e/8f4e#readme",
  "dependencies": {
    "@8f4e/editor-state-types": "*",
    "@8f4e/language-spec": "*",
    "@8f4e/project-preparser": "*",
    "@8f4e/state-manager": "*",
    "@8f4e/tokenizer": "*"
  },
  "devDependencies": {
    "@8f4e/compiler": "*",
    "@8f4e/editor-state-testing": "*",
    "@types/node": "24.19.2",
    "vitest": "4.1.12"
  },
  "nx": {
    "projectType": "library",
    "targets": {
      "build": { "command": "rm -rf dist && tsc --emitDeclarationOnly && vite build" },
      "test": { "executor": "@nx/vitest:test" },
      "test-update": {
        "executor": "@nx/vitest:test",
        "options": {
          "config": "{projectRoot}/vitest.config.ts",
          "updateSnapshot": true
        }
      },
      "typecheck": { "command": "tsc --noEmit" }
    },
    "tags": ["type:library", "scope:editor"]
  }
}
