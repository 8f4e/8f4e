{
  "name": "@8f4e/editor-webmcp",
  "sourceRoot": "src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "rm -rf dist && tsc",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "^build",
        "generate-content"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "vitest run",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.tools.json",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "build"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome check --write src browser-tests scripts",
        "cwd": "{projectRoot}"
      }
    },
    "test:browser": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "vitest run --config vitest.browser.config.ts",
        "cwd": "{projectRoot}"
      }
    },
    "generate-content": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "production",
        "^production",
        { "projects": ["@8f4e/compiler", "@8f4e/editor-core"], "input": "referenceDocs" }
      ],
      "outputs": [
        "{projectRoot}/src/generated"
      ],
      "dependsOn": [
        "^build"
      ],
      "options": {
        "command": "vite build --config vite.content.config.ts && node .content-generator/generate-content.js",
        "cwd": "{projectRoot}"
      }
    }
  },
  "tags": [
    "type:library",
    "scope:editor"
  ]
}
