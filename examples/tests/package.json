{
	"name": "@8f4e/examples-integration",
	"private": true,
	"type": "module",
	"description": "Integration and behavior regression tests for 8f4e source programs",
	"devDependencies": {
		"@8f4e/cli": "*",
		"@8f4e/compiler": "*",
		"@8f4e/compiler-benchmarks": "*",
		"@8f4e/config": "*",
		"@8f4e/examples": "*",
		"@8f4e/language-spec": "*",
		"@8f4e/stdlib": "*",
		"@types/node": "24.13.2",
		"vitest": "4.1.12"
	},
	"nx": {
		"projectType": "library",
		"targets": {
			"test": {
				"executor": "nx:run-commands",
				"options": {
					"commands": [
						{
							"command": "vitest run --config vitest.config.ts",
							"forwardAllArgs": false
						}
					]
				}
			},
			"typecheck": { "command": "tsc --noEmit" },
			"lint": { "command": "biome check ." }
		},
		"tags": ["type:integration-test", "scope:examples"]
	}
}
