function noteEventKind
; @pos -146 0
; Classify note messages and
; CC123; return zero otherwise.
use midiCodes
use noteEventCodes
param int status
param int data1
param int data2

push status
and STATUS_MASK
localSet status
push status
push NOTE_ON
equal
if
push data2
if
push ON
else
push OFF
ifEnd int
else
push status
push NOTE_OFF
equal
if
push OFF
else
push status
push CONTROL_CHANGE
equal
push data1
push ALL_NOTES_OFF
equal
and
mul ALL_OFF
ifEnd int
ifEnd int
functionEnd int

function onMidiEvent
; @pos -106 0
#export onMidiEvent
#impure
; Translate MIDI into queued
; note-on, note-off, or all-off.
; @config midi.inputs.keys.port 0
; @config midi.inputs.keys.callback onMidiEvent
use noteEventCodes
param int status
param int data1
param int data2
local int kind

call noteEventKind status data1 data2
localSet kind
push kind
push ALL_OFF
equal
if
call enqueueEvent kind 0 0
else
push kind
if
call enqueueEvent kind data1 data2
ifEnd
ifEnd
functionEnd

function enqueueEvent
; @pos -49 0
#export
#impure
; Pack event kind, note, and
; velocity into one queued word.
param int kind
param int note
param int velocity

push &noteEventBuffer:writePointer
push &noteEventBuffer:events
push count(noteEventBuffer:events)
push kind
push note
shiftLeft 8
or
push velocity
shiftLeft 16
or
call queuePush
functionEnd

