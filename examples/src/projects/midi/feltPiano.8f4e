module noteOn
; @pos 134 26
; Allocate the next voice for a
; generic note-on event.
use polyphony
int*& trigger &eventInputs:on
int*& note &eventInputs:note
int*& velocity &eventInputs:velocity
int nextVoice
; @watch nextVoice
int* voiceOn &voice1:on
int* voiceOff &voice1:off
int* voiceNote &voice1:note
int* voiceVelocity &voice1:velocity

push **trigger
if
push nextVoice
push &voiceOn
push &voiceOff
push &voiceNote
push &voiceVelocity
call selectVoice
; Store note and velocity, cancel
; off, then publish on last.
push voiceVelocity
push **velocity
store
push voiceNote
push **note
store
push voiceOff
push 0
store
push voiceOn
push 1
store
push &nextVoice
push nextVoice
add 1
remainder VOICES
store
ifEnd
