module noteEventBuffer
; @pos 13 0
; @home left
; Publish one queued control
; event per audio frame.
use noteEventCodes
int[] events 128
int* readPointer &events
int* writePointer &events
int on ; @watch
int off ; @watch
int allOff ; @watch
int note ; @watch
int velocity ; @watch
local int event
local int kind

call queuePop &readPointer &events count(events)
localSet event
push event
and 0xff
localSet kind
push &on
push kind
push ON
equal
store
push &off
push kind
push OFF
equal
store
push &allOff
push kind
push ALL_OFF
equal
store
push event
if
push &note
push event
shiftRightUnsigned 8
and 0xff
store
push &velocity
push event
shiftRightUnsigned 16
store
ifEnd
moduleEnd
group feltPiano
; @pos 72 0
; Felt piano instrument: voices,
; release envelopes and PCM banks.
expose on &pianoSampler:on
expose off &pianoSampler:off
expose allOff &pianoSampler:allOff
expose note &pianoSampler:note
expose velocity &pianoSampler:velocity
expose out &pianoSampler:out
init &on &noteEventBuffer:on
init &off &noteEventBuffer:off
init &allOff &noteEventBuffer:allOff
init &note &noteEventBuffer:note
init &velocity &noteEventBuffer:velocity
pass env

template pianoSampler
template sampleVoice
function holdRelease
; @pos -55 0
#impure
; Jump to one on note-on, hold,
; then release by step per frame.
; Return this frame's level before
; advancing the release state.
param int on
param int off
param float step
param float* level
param int* releasing

push on
if
push level
push 1.0
store
push releasing
push 0
store
ifEnd
push off
if
push releasing
push 1
store
ifEnd

push *level
push *releasing
if
push level
push *level
sub step
max 0.0
store
ifEnd
functionEnd float
