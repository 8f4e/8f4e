module inputs
; @pos 0 0
; Public voice inputs.
; Set on or off to 1 to send an
; event; clear the opposite flag.
; Velocity is separate, from 1-127.
; Note is a chromatic note number.
; @home left
int on
int off
; Zero means no assigned note.
int note 0
int velocity 127
moduleEnd
module sampleSelector
; @pos 50 0
; Latch the sample bounds and
; frame count on each trigger.
int& note &inputs:note
int& velocity &inputs:velocity
int& trigger &inputs:on
int16* sampleAddress
int sampleLength
int16* sampleEnd
local int length

push *trigger
if
push &sampleAddress
call mapSample *velocity *note
localSet length
store
push &sampleLength
push length
store
push &sampleEnd
push sampleAddress
push length
mul sizeof(*sampleAddress)
add
store
ifEnd
moduleEnd
module envelope
; @pos 100 0
; Note-on resets gain immediately.
; Note-off releases over
; RELEASE_SECONDS.
use env
use pianoSettings
int& trigger &inputs:on
int& release &inputs:off
int& velocity &inputs:velocity
float level
float velocityGain
float out
int releasing

push *trigger
if
push &velocityGain
push *velocity
castToFloat
div 127.0
store
ifEnd

push &out
push *trigger
push *release
push 1.0
div RELEASE_SECONDS*SAMPLE_RATE
push &level
push &releasing
call holdRelease
mul velocityGain
store
moduleEnd
module player
; @pos 150 0
; Read mono PCM until its end.
; A new trigger replaces playback
; immediately, at its start address.
; Hold the final value at the end.
int16*& address &sampleSelector:sampleAddress
int16*& sampleEnd &sampleSelector:sampleEnd
int& length &sampleSelector:sampleLength
int& trigger &inputs:on
int16* playhead
float out

; @wave2 *address length playhead

push *trigger
if
push &playhead
push *address
store
ifEnd

push playhead
push *sampleEnd
lessThan
if
push &out
push *playhead
castToFloat
div max(*playhead)+1.0
store
push &playhead
push playhead
add sizeof(*playhead)
store
ifEnd
moduleEnd
module amplifier
; @pos 200 0
; Apply the separate envelope to
