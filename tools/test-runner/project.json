{
	"name": "@8f4e/test-runner",
	"projectType": "library",
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "rm -rf dist && tsc --emitDeclarationOnly && vite build",
				"cwd": "{projectRoot}"
			}
		},
		"test": {
			"executor": "@nx/vitest:test",
			"options": {
				"config": "{projectRoot}/vitest.config.ts"
			}
		},
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"command": "biome check --write src vite.config.ts vitest.config.ts",
				"cwd": "{projectRoot}"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc --noEmit -p tsconfig.test.json",
				"cwd": "{projectRoot}"
			}
		}
	},
	"tags": ["type:library", "scope:testing"]
}
