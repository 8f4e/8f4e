{
	"name": "@8f4e/release",
	"targets": {
		"test": {
			"executor": "nx:run-commands",
			"outputs": [],
			"options": {
				"commands": [{ "command": "node --test scripts/*.test.mjs", "forwardAllArgs": false }],
				"cwd": "{projectRoot}"
			}
		},
		"lint": {
			"executor": "nx:run-commands",
			"options": { "command": "biome check --write scripts", "cwd": "{projectRoot}" }
		},
		"check": {
			"executor": "nx:noop",
			"cache": false,
			"dependsOn": ["build-and-metrics", "tests"]
		},
		"build-and-metrics": {
			"executor": "nx:noop",
			"cache": false,
			"dependsOn": [
				{
					"projects": ["@8f4e/compiler-benchmarks"],
					"target": "log-bytecode-size"
				},
				{
					"projects": ["@8f4e/compiler-benchmarks"],
					"target": "log-compiler-coverage-counts"
				},
				"docs-coverage",
				{
					"projects": ["@8f4e/8f4e-website"],
					"target": "build"
				},
				"bundle-sizes"
			]
		},
		"bundle-sizes": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": [
				{
					"projects": ["@8f4e/editor-webapp"],
					"target": "build"
				}
			],
			"options": {
				"command": "node {projectRoot}/scripts/log-bundle-sizes.mjs",
				"cwd": "{workspaceRoot}"
			}
		},
		"docs-coverage": {
			"executor": "nx:run-commands",
			"cache": false,
			"outputs": ["{workspaceRoot}/logs/tsdoc-coverage"],
			"options": {
				"command": "node {projectRoot}/scripts/tsdoc-coverage.mjs",
				"cwd": "{workspaceRoot}"
			}
		},
		"tests": {
			"executor": "nx:noop",
			"cache": false,
			"dependsOn": [
				{
					"projects": ["@8f4e/cli", "*", "!@8f4e/editor-webapp", "!glugglugglug", "!@8f4e/runtime-linux", "!@8f4e/runtime-command"],
					"target": "test"
				}
			]
		}
	},
	"tags": ["type:tooling", "scope:release"]
}
