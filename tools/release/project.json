{
	"name": "@8f4e/release",
	"targets": {
		"test": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					{
						"command": "node --test scripts/*.test.mjs",
						"forwardAllArgs": false
					}
				]
			}
		},
		"lint": { "command": "biome check --write scripts" },
		"check": {
			"executor": "nx:noop",
			"cache": false,
			"dependsOn": ["build-and-metrics", "tests"]
		},
		"build-and-metrics": {
			"executor": "nx:noop",
			"cache": false,
			"dependsOn": [
				{
					"projects": ["@8f4e/compiler-benchmarks"],
					"target": "log-bytecode-size"
				},
				{
					"projects": ["@8f4e/compiler-benchmarks"],
					"target": "log-compiler-coverage-counts"
				},
				"docs-coverage",
				{
					"projects": ["@8f4e/8f4e-website"],
					"target": "build"
				},
				"bundle-sizes"
			]
		},
		"bundle-sizes": {
			"cache": false,
			"dependsOn": [
				{
					"projects": ["@8f4e/editor-webapp"],
					"target": "build"
				}
			],
			"options": { "cwd": "{workspaceRoot}" },
			"command": "node {projectRoot}/scripts/log-bundle-sizes.mjs"
		},
		"docs-coverage": {
			"cache": false,
			"outputs": ["{workspaceRoot}/logs/tsdoc-coverage"],
			"options": { "cwd": "{workspaceRoot}" },
			"command": "node {projectRoot}/scripts/tsdoc-coverage.mjs"
		},
		"tests": {
			"executor": "nx:noop",
			"cache": false,
			"dependsOn": [
				{
					"projects": [
						"@8f4e/cli",
						"*",
						"!@8f4e/editor-webapp",
						"!glugglugglug",
						"!@8f4e/runtime-linux",
						"!@8f4e/runtime-command"
					],
					"target": "test"
				}
			]
		}
	},
	"tags": ["type:tooling", "scope:release"]
}
