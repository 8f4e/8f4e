{
	"name": "@8f4e/config",
	"projectType": "library",
	"targets": {
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"command": "biome check --write src tests",
				"cwd": "{projectRoot}"
			}
		},
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "rm -rf dist && tsc",
				"cwd": "{projectRoot}"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"dependsOn": ["build"],
			"options": {
				"commands": [{ "command": "node --test tests/*.test.mjs", "forwardAllArgs": false }],
				"cwd": "{projectRoot}"
			}
		}
	},
	"tags": ["type:config", "scope:tooling"]
}
