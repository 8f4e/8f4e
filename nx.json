{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "sharedGlobals": [],
    "production": [
      "default",
      "!{projectRoot}/**/*.{test,spec}.{ts,tsx,js,jsx,mjs,cjs}",
      "!{projectRoot}/**/__tests__/**/*",
      "!{projectRoot}/**/__snapshots__/**/*",
      "!{projectRoot}/tests/**/*",
      "!{projectRoot}/screenshot-tests/**/*",
      "!{projectRoot}/browser-tests/**/*",
      "!{projectRoot}/src/fixtures/**/*",
      "!{projectRoot}/**/vitest*.config.*",
      "!{projectRoot}/**/playwright.config.*",
      "!{projectRoot}/tsconfig.test.json",
      "!{projectRoot}/**/__screenshots__/**/*",
      "!{projectRoot}/jest.image.ts"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "cache": true,
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "dev": {
      "cache": false,
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "test": [
      {
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production"
        ],
        "cache": true
      },
      {
        "filter": {
          "executor": "nx:run-commands"
        },
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      {
        "filter": {
          "executor": "@nx/vitest:test"
        },
        "options": {
          "config": "{projectRoot}/vitest.config.ts"
        }
      }
    ],
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true,
      "command": "tsc --noEmit -p tsconfig.test.json",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/biome.jsonc",
        "{workspaceRoot}/.gitignore"
      ],
      "cache": true,
      "command": "biome check src",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "test:browser": {
      "inputs": [
        "default",
        "^production"
      ],
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "build"
      ]
    },
    "test:screenshot": {
      "inputs": [
        "default",
        "^production"
      ],
      "command": "vitest --config=vitest.browser.config.ts --run",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "build"
      ]
    },
    "build-deps": {
      "inputs": [
        "production",
        "^production"
      ]
    },
    "test:screenshot:*": {
      "inputs": [
        "default",
        "^production"
      ],
      "options": {
        "cwd": "{projectRoot}"
      }
    }
  },
  "generators": {
    "@nx/js:library": {
      "unitTestRunner": "vitest"
    }
  },
  "release": {
    "projects": [
      "*",
      "!@8f4e/release",
      "!@8f4e/examples-integration",
      "!@8f4e/compiler-benchmarks",
      "!@8f4e/runtime-daisy",
      "!@8f4e/runtime-linux",
      "!@8f4e/runtime-command",
      "!glugglugglug"
    ],
    "projectsRelationship": "independent",
    "releaseTag": {
      "pattern": "{projectName}@{version}"
    },
    "version": {
      "specifierSource": "conventional-commits",
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk",
      "updateDependents": "always",
      "manifestRootsToUpdate": [
        "{projectRoot}"
      ]
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": false
    },
    "git": {
      "commit": true,
      "commitMessage": "chore(release): version packages",
      "tag": true,
      "push": false
    }
  },
  "defaultBase": "main",
  "analytics": false,
  "nxCloudId": "6a172ab3f11a1d95830c5447"
}
