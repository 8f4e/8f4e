{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "sharedGlobals": [],
    "production": [
      "default",
      "!{projectRoot}/**/*.{test,spec}.{ts,tsx,js,jsx,mjs,cjs}",
      "!{projectRoot}/**/__tests__/**/*",
      "!{projectRoot}/**/__snapshots__/**/*",
      "!{projectRoot}/tests/**/*",
      "!{projectRoot}/screenshot-tests/**/*",
      "!{projectRoot}/browser-tests/**/*",
      "!{projectRoot}/src/fixtures/**/*",
      "!{projectRoot}/**/vitest*.config.*",
      "!{projectRoot}/**/playwright.config.*",
      "!{projectRoot}/tsconfig.test.json",
      "!{projectRoot}/**/__screenshots__/**/*",
      "!{projectRoot}/jest.image.ts"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "cache": true
    },
    "dev": {
      "cache": false
    },
    "test": {
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true
    },
    "lint": {
      "inputs": [
        "default",
        "^default"
      ],
      "cache": true
    },
    "test:browser": {
      "inputs": [
        "default",
        "^production"
      ]
    },
    "test:screenshot": {
      "inputs": [
        "default",
        "^production"
      ]
    },
    "test:screenshot:update": {
      "inputs": [
        "default",
        "^production"
      ]
    },
    "test:screenshot:ui": {
      "inputs": [
        "default",
        "^production"
      ]
    },
    "test:screenshot:headed": {
      "inputs": [
        "default",
        "^production"
      ]
    },
    "test:screenshot:debug": {
      "inputs": [
        "default",
        "^production"
      ]
    },
    "build-deps": {
      "inputs": [
        "production",
        "^production"
      ]
    }
  },
  "generators": {
    "@nx/js:library": {
      "unitTestRunner": "vitest"
    }
  },
  "release": {
    "projects": [
      "*",
      "!@8f4e/release",
      "!glugglugglug"
    ],
    "projectsRelationship": "independent",
    "releaseTag": {
      "pattern": "{projectName}@{version}"
    },
    "version": {
      "specifierSource": "conventional-commits",
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk",
      "updateDependents": "always",
      "manifestRootsToUpdate": [
        "{projectRoot}"
      ]
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": false
    },
    "git": {
      "commit": true,
      "commitMessage": "chore(release): version packages",
      "tag": true,
      "push": false
    }
  },
  "defaultBase": "main",
  "analytics": false,
  "nxCloudId": "6a172ab3f11a1d95830c5447"
}
