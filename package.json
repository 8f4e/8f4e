{
  "name": "8f4e",
  "version": "2.1.2",
  "description": "8f4e",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": "24.16.0",
    "npm": "11.13.0"
  },
  "scripts": {
    "preinstall": "git submodule update --init --recursive",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/8f4e/8f4e.git"
  },
  "author": "Andor Polgar",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/8f4e/8f4e/issues"
  },
  "homepage": "https://github.com/8f4e/8f4e#readme",
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@nx/js": "23.3.2",
    "@nx/vite": "23.3.2",
    "@playwright/test": "1.65.1",
    "@types/audioworklet": "0.0.102",
    "@types/node": "24.13.2",
    "@types/offscreencanvas": "2019.7.3",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/ui": "4.1.12",
    "concurrently": "10.0.7",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "nx": "23.3.2",
    "typescript": "6.0.3",
    "vite": "7.3.8",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "4.1.12",
    "wabt": "1.0.39"
  },
  "workspaces": [
    "apps/*",
    "compiler",
    "compiler/packages/*",
    "compiler/packages/*/packages/*",
    "editor/core/*",
    "editor/compositions/*",
    "editor/plugins/*",
    "editor/plugins/*/packages/*",
    "editor/editor-webmcp",
    "examples",
    "tools/config",
    "tools/test-runner",
    "tools/vite-plugin-sources",
    "!apps/runtime-daisy/third_party/**"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.ts": [
      "bash -c 'npx nx affected --target=typecheck --files \"$@\"' --"
    ]
  },
  "overrides": {
    "nx": {
      "axios": "1.21.1",
      "brace-expansion": "5.0.13",
      "follow-redirects": "1.16.3",
      "yaml": "2.9.1"
    }
  }
}
