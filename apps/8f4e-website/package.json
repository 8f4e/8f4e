{
	"name": "@8f4e/8f4e-website",
	"version": "0.4.9",
	"private": true,
	"description": "8f4e product website",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/8f4e/8f4e.git"
	},
	"author": "Andor Polgar",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/8f4e/8f4e/issues"
	},
	"homepage": "https://github.com/8f4e/8f4e#readme",
	"dependencies": {
		"@8f4e/editor-gallery": "*",
		"@8f4e/editor-landing": "*",
		"@8f4e/editor-webmcp": "*"
	},
	"devDependencies": {
		"@8f4e/web-ui-testing": "*",
		"@8f4e/compiler": "*",
		"@8f4e/config": "*",
		"@8f4e/editor-core": "*",
		"@8f4e/examples": "*",
		"@8f4e/vite-plugin-sources": "*",
		"@vitest/browser": "4.1.12",
		"@vitest/browser-playwright": "4.1.12",
		"vitest": "4.1.12",
		"vite": "7.3.8",
		"vite-plugin-static-copy": "4.1.1"
	},
	"nx": {
		"projectType": "application",
		"targets": {
			"dev": {
				"continuous": true,
				"dependsOn": ["watch-deps"],
				"command": "vite"
			},
			"build-deps": {
				"executor": "nx:noop",
				"dependsOn": ["^build"]
			},
			"watch-deps": {
				"continuous": true,
				"dependsOn": ["build-deps"],
				"options": { "cwd": "{workspaceRoot}" },
				"command": "nx watch --projects=@8f4e/8f4e-website --includeDependencies -- nx run @8f4e/8f4e-website:build-deps"
			},
			"lint": {},
			"test:browser": {
				"dependsOn": ["^build"],
				"inputs": [
					"default",
					"^production",
					{
						"projects": ["@8f4e/compiler"],
						"input": "galleryFixtures"
					}
				],
				"command": "vitest run"
			},
			"build": {
				"inputs": [
					"production",
					"^production",
					{
						"projects": ["@8f4e/compiler"],
						"input": "galleryFixtures"
					}
				],
				"dependsOn": ["typecheck:production", "^build"],
				"command": "vite build"
			},
			"serve": {
				"options": { "cwd": "{projectRoot}" },
				"dependsOn": ["build"],
				"command": "vite preview"
			},
			"typecheck": { "command": "tsc --noEmit --project tsconfig.json" },
			"typecheck:production": {
				"dependsOn": ["^build"],
				"inputs": ["production", "^production"],
				"cache": true,
				"options": { "cwd": "{projectRoot}" },
				"command": "tsc --noEmit --project tsconfig.production.json"
			},
			"kill-dev": {
				"options": { "cwd": "{workspaceRoot}" },
				"command": "lsof -ti tcp:3001 | xargs -r kill"
			}
		},
		"tags": ["type:application", "scope:website"]
	}
}
