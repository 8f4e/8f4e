{
  "name": "@8f4e/compiler",
  "version": "14.3.0",
  "private": true,
  "description": "8f4e compiler package",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./docs": "./docs",
    "./docs/*.md": "./docs/*.md",
    "./test-fixtures": "./tests",
    "./test-fixtures/*.test.8f4e": "./tests/*.test.8f4e"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/8f4e/8f4e.git"
  },
  "author": "Andor Polgar",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/8f4e/8f4e/issues"
  },
  "homepage": "https://github.com/8f4e/8f4e#readme",
  "dependencies": {
    "@8f4e/language-spec": "*",
    "@8f4e/program-composer": "*",
    "@8f4e/project-preparser": "*",
    "@8f4e/sub-program": "*",
    "@8f4e/tokenizer": "*",
    "@8f4e/wasm-codegen": "*",
    "@8f4e/compiler-diagnostics": "*"
  },
  "devDependencies": {
    "@8f4e/stdlib": "*",
    "@types/node": "24.19.2",
    "@8f4e/test-runner": "*"
  },
  "nx": {
    "projectType": "library",
    "namedInputs": {
      "galleryFixtures": ["{projectRoot}/tests/**/*.test.8f4e"]
    },
    "targets": {
      "build": { "command": "rm -rf dist && tsc --emitDeclarationOnly && vite build" },
      "lint": {},
      "dev": {
        "command": "rm -rf dist && concurrently -k -n types,bundle \"tsc --emitDeclarationOnly --watch\" \"vite build --watch\""
      },
      "test": { "executor": "@nx/vitest:test" },
      "typecheck": { "command": "tsc --noEmit" }
    },
    "tags": ["type:library", "scope:core"]
  }
}
