{
  "name": "@8f4e/compiler",
  "sourceRoot": "src",
  "projectType": "library",
  "namedInputs": {
    "referenceDocs": ["{projectRoot}/docs/**/*.md"],
    "galleryFixtures": ["{projectRoot}/tests/**/*.test.8f4e"]
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["^build"],
      "options": {
        "command": "rm -rf dist && tsc --emitDeclarationOnly && vite build",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome check --write src",
        "cwd": "{projectRoot}"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf dist && concurrently -k -n types,bundle \"tsc --emitDeclarationOnly --watch\" \"vite build --watch\"",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/@8f4e/compiler"],
      "dependsOn": ["^build"],
      "options": {
        "config": "{projectRoot}/vitest.config.ts",
        "reportsDirectory": "{workspaceRoot}/coverage/@8f4e/compiler"
      }
    },
    "docs-coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/tsdoc-coverage.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "{projectRoot}"
      }
    }
  },
  "tags": ["type:library", "scope:core"]
}
