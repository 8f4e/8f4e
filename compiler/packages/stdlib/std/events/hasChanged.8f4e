function hasChanged
#export
#impure
; @doc Detects changes in a value and updates the stored
; - previous value.
; @returns 1 if the values differ, otherwise 0.
; @param currentValue Current value to compare.
param int currentValue
; @param previousValue Address of persistent previous
; - value state.
param int* previousValue

push currentValue
push *previousValue
notEqual
push previousValue
push currentValue
store

functionEnd int

function hasChanged
#export
#impure
; @doc Detects changes in a value and updates the stored
; - previous value.
; @returns 1 if the values differ, otherwise 0.
; @param currentValue Current value to compare.
param float currentValue
; @param previousValue Address of persistent previous
; - value state.
param float* previousValue

push currentValue
push previousValue
loadFloat
notEqual
push previousValue
push currentValue
store

functionEnd int
