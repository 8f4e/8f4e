includes
include std/math/exp2
includesEnd

function midiNoteToHz
#export
; @doc Converts a MIDI note to frequency in 12-TET (A4 =
; - 440 Hz).
; @returns Frequency in Hz.
; @param note MIDI note number in 0..127.
param int note

push note
castToFloat
call midiNoteToHz
functionEnd float

function midiNoteToHz
#export
; @doc Converts a MIDI note to frequency in 12-TET (A4 =
; - 440 Hz).
; @returns Frequency in Hz.
; @param note MIDI note in 0..127; fractional notes
; - allowed.
param float note

push note
sub 69.0
div 12.0
call exp2
mul 440.0
functionEnd float
