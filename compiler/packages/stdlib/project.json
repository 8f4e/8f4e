{
	"name": "@8f4e/stdlib",
	"metadata": { "metrics": { "sourceDirectory": "std" } },
	"projectType": "library",
	"targets": {
		"test": {
			"executor": "nx:run-commands",
			"dependsOn": ["^build"],
			"options": {
				"command": "vitest run",
				"cwd": "{projectRoot}"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc --noEmit -p tsconfig.test.json",
				"cwd": "{projectRoot}"
			}
		}
	},
	"tags": ["type:library", "scope:core"]
}
