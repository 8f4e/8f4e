{
	"name": "@8f4e/8f4e-website",
	"sourceRoot": "src",
	"projectType": "application",
	"implicitDependencies": ["@8f4e/examples"],
	"targets": {
		"dev": {
			"continuous": true,
			"executor": "nx:run-commands",
			"dependsOn": ["watch-deps"],
			"options": {
				"command": "vite",
				"cwd": "{projectRoot}"
			}
		},
		"build-deps": {
			"executor": "nx:noop",
			"dependsOn": ["^build"]
		},
		"watch-deps": {
			"continuous": true,
			"executor": "nx:run-commands",
			"dependsOn": ["build-deps"],
			"options": {
				"command": "nx watch --projects=@8f4e/8f4e-website --includeDependencies -- nx run @8f4e/8f4e-website:build-deps",
				"cwd": "{workspaceRoot}"
			}
		},
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"command": "biome check --write packages/8f4e-website/src",
				"cwd": "{workspaceRoot}"
			}
		},
		"test:browser": {
			"executor": "nx:run-commands",
			"dependsOn": ["^build"],
			"options": {
				"command": "vitest run",
				"cwd": "{projectRoot}"
			}
		},
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "vite build",
				"cwd": "{projectRoot}"
			},
			"dependsOn": ["typecheck:production", "^build"]
		},
		"serve": {
			"executor": "nx:run-commands",
			"options": {
				"command": "vite preview",
				"cwd": "{projectRoot}"
			},
			"dependsOn": ["build"]
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc --noEmit --project tsconfig.json",
				"cwd": "{projectRoot}"
			},
			"dependsOn": ["^build"]
		},
		"typecheck:production": {
			"executor": "nx:run-commands",
			"dependsOn": ["^build"],
			"inputs": ["production", "^production"],
			"cache": true,
			"options": {
				"command": "tsc --noEmit --project tsconfig.production.json",
				"cwd": "{projectRoot}"
			}
		},
		"kill-dev": {
			"executor": "nx:run-commands",
			"options": {
				"command": "lsof -ti tcp:3001 | xargs -r kill",
				"cwd": "{workspaceRoot}"
			}
		}
	},
	"namedInputs": {
		"default": [
			"{projectRoot}/**/*",
			"sharedGlobals",
			"{workspaceRoot}/packages/compiler/tests/**/*.test.8f4e"
		]
	},
	"tags": ["type:application", "scope:website"]
}
