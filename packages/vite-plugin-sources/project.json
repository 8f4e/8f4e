{
	"name": "@8f4e/vite-plugin-sources",
	"sourceRoot": "src",
	"projectType": "library",
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": { "command": "rm -rf dist && tsc", "cwd": "{projectRoot}" }
		},
		"test": {
			"executor": "nx:run-commands",
			"dependsOn": ["^build"],
			"outputs": ["{projectRoot}/coverage"],
			"options": { "command": "vitest run", "cwd": "{projectRoot}" }
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": { "command": "tsc --noEmit -p tsconfig.test.json", "cwd": "{projectRoot}" }
		},
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"command": "biome check --write packages/vite-plugin-sources",
				"cwd": "{workspaceRoot}"
			}
		}
	},
	"tags": ["type:library", "scope:tooling"]
}
