8f4e/v1

entry main
module lowPassFilter
; @public
; One-pole low-pass filter that smooths a signal and reduces high-frequency content.
; Use alpha to control how quickly the output follows the input.

float* in
float out

float alpha 0.1

push &out
push alpha
push *in
mul
push 1.0
push alpha
sub
push out
mul
add
store

moduleEnd
entryEnd
