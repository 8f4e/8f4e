; @pos 53 9
; @home
use env

const BUFFER_SIZE SAMPLE_RATE*3

float* in &audioin:out
float out
float[] buffer BUFFER_SIZE
float* pointer &buffer

; Read sample
push &out
push *pointer
store

; Write current sample
push pointer
push *in
store

