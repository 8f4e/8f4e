module clock
; @pos -30 20
; One pulse per beat, from frame zero.
use env
int bpm 207 ; @w
; @slider &bpm 40 240 1
int remaining
int out

push &out
push remaining
equalToZero
store

push &remaining
push out
if
push SAMPLE_RATE*60
push bpm
ensureNonZero 90
div
else
push remaining
ifEnd int
sub 1
store
moduleEnd
module sampleAndHold
; @pos 19 -23
; Capture pitch on a clock pulse.
