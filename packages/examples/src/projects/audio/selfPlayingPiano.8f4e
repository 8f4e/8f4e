module pitchLfo
; @pos -92 2
; Sweep between two MIDI pitches.
use env
float rateHz 0.83 ; @w
; @slider &rateHz 0 1 0.01
float minimum 46.0 ; @w
; @slider &minimum 21 108 1
float maximum 86.0 ; @w
; @slider &maximum 21 108 1
float phase
float out 64.5

push &out
push minimum
push maximum
call advancePhase &phase rateHz SAMPLE_RATE
call sine
mul 0.5
add 0.5
call lerp
store
moduleEnd
