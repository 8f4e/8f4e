function mapSample
; @pos -13 -30
#impure
; Return a byte address and mono
; frame count from neighboring
; offsets in the selected bank.
use pianoSettings
param int velocity
param int note
local int* offsets
local int index
local int byteLength

push note
sub FIRST_NOTE
localSet index

push velocity
push SOFT_MAX
lessOrEqual
if
push &sampleMap:piano
localSet offsets
push &sampleBuffers:piano
else
push velocity
push MEDIUM_MAX
lessOrEqual
if
push &sampleMap:mezzo
localSet offsets
push &sampleBuffers:mezzo
else
push &sampleMap:forte
localSet offsets
push &sampleBuffers:forte
ifEnd int
ifEnd int

call loadRangeAt offsets index
localSet byteLength
add
push byteLength
div sizeof(sampleBuffers:piano)
functionEnd int16* int
constants pianoSettings
; @pos 35 -18
const FIRST_NOTE 21
const NOTES_PER_LAYER 88
const SOFT_MAX 42
const MEDIUM_MAX 84
constantsEnd
