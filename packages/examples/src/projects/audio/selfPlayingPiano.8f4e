module octaveNotes
; @pos 25 0
; Expand the selected pitch classes
; across the full MIDI note range.
int& selected &piano:notes
int& selectedCount &piano:noteCount
float[] notes 128
int noteCount
int previousPitchClasses -1
local int pitchClasses
local int count

call midiPitchClassMask selected *selectedCount
localSet pitchClasses

push pitchClasses
push previousPitchClasses
equal
exitIfTrue
push &previousPitchClasses
push pitchClasses
store

; Make the list empty while rebuilding.
push &noteCount
push 0
store
push 0
localSet count
loop count(notes)
push pitchClasses
loopIndex
call midiPitchClass
shiftRightUnsigned
and 1
if
push &notes
push count
mul sizeof(notes)
add
loopIndex
castToFloat
store
push count
add 1
localSet count
ifEnd
loopEnd

push &noteCount
push count
store
moduleEnd
entryEnd
