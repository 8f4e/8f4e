note selfPlayingPiano
; @pos -22 -59
; A self-playing felt piano.
; A slow LFO sweeps the pitch.
; Sample and hold captures the
; pitch on each beat. The clock
; triggers the piano directly.
; A second LFO sets velocity.
;
; Click the piano keys to select
; pitch classes across all octaves.
; The worker refreshes the list
; at 10 Hz. C minor pentatonic
; is selected by default.
;
; Wait for the three PCM banks
; to finish loading before playing.
noteEnd

note audioConfig
; @pos 29 -59
; @config audioRuntime.enabled true
; @config audioRuntime.sampleRate 48000
; @config audioRuntime.audioOutBufferLAddress audioout:buffer
; @config audioRuntime.audioOutBufferRAddress audioout:buffer
noteEnd

note workerConfig
; @pos 29 -50
; @config workerRuntime.enabled true
; @config workerRuntime.entry controls
; @config workerRuntime.sampleRate 10
; @config workerRuntime.sampleRateConstantName OCTAVE_RATE
noteEnd

note exportConfig
; @pos 29 -41
; @config export.fileName selfPlayingPiano
noteEnd

