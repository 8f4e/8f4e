function loadRowVolume
; @pos 588 -143
use mod
param int row

call maskEffect row
push SET_VOLUME
equal
if
call maskParam row
return
ifEnd

call maskSampleNumber row
push 0
greaterThan
if
call maskSampleNumber row
call sampleNumberToVolume
return
ifEnd

push 0

functionEnd int

