function maskExtendedEffect
; @pos 331 -122
; Combine the main E effect
; nibble with the extended
; sub-effect nibble.
param int row

call maskEffect row
shiftLeft 4
call maskParamHi row
or

functionEnd int

function maskEffect
; @pos 333 -105
param int row

call extractNibble row 4

functionEnd int

function maskParam
; @pos 367 -124
use mod
param int row

push row
and EFFECT_PARAM
push EFFECT_PARAM_SHIFT
shiftRightUnsigned

functionEnd int

function maskPeriod
; @pos 367 -111
