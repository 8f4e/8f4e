module mixer
; @pos 705 6
float* in1 &amp1:out
float* in2 &amp2:out
float* in3 &amp3:out
float* in4 &amp4:out

float outL ; @meter
float outR ; @meter

push &outL
push *in1
add *in3
div 2.0
push *in2
add *in4
div 3.5
add
store

push &outR
push *in2
add *in4
div 2.0

push *in1
add *in3
div 3.5
add
store

moduleEnd
