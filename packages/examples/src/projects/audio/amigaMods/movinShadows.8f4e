function rowVolumeAtRowStart
; @pos 659 -164
; Reload row-start volume,
; apply immediate note cuts,
; then apply fine slides.
use mod
param int currentVolume
param int row
local int baseVolume

call rowShouldReloadVolume
- row
if
call loadRowVolume row
localSet baseVolume
else
push currentVolume
localSet baseVolume
ifEnd

call maskExtendedEffect row
push NOTE_CUT
equal
call maskParamLo row
equalToZero
and
if
push 0
return
ifEnd

push baseVolume
call rowFineVolumeSlideDelta
- row
add

functionEnd int

function rowFineVolumeSlideDelta
; @pos 659 -113
; Apply EAx/EBx once on the
; row where the new data
; becomes visible.
use mod
param int row

call maskExtendedEffect row
push FINE_VOLUME_SLIDE_UP
equal
if
call maskParamLo row
return
ifEnd

call maskExtendedEffect row
push FINE_VOLUME_SLIDE_DOWN
equal
if
push 0
call maskParamLo row
sub
return
ifEnd

push 0

functionEnd int

