module samplePlayer1
; @pos 545 -4
use env
; @tab 6 20
int*	period	&period1:out
int*	offset	&sampleOffset1:out
int*	trigger	&scheduler1:out
int	previousTrigger
int*	sampleNumber	&scheduler1:sampleNumber
int8*	sampleAddress	; @w
int8*	playhead	; @w
int	sampleSize	; @w
; @wave2 sampleAddress sampleSize playhead
float out; @w
; @hide

float _position
int _playing

push &sampleAddress
push *sampleNumber
call sampleNumberToAddr
store

push &sampleSize
push *sampleNumber
call sampleNumberToSize
store

push *trigger
call risingEdge &previousTrigger
if
push &_playing
push 1
store
push &_position
push *offset
castToFloat
store
ifEnd

; Calculate read address
push &playhead
push _position
castToInt
push sampleAddress
add
store

; Read sample at playhead
; write it to output
push &out
push *playhead
castToFloat
push max(*sampleAddress) ; max value
castToFloat
div
store

; Advance the playhead
push _playing
if
push &_position
push _position
push *period
call period2Step
add
store
ifEnd

push *sampleNumber
call sampleNumberCanLoop

push _position
castToInt
push *sampleNumber
call sampleNumberToRepeatEnd
greaterThan
and
if
push &_position
push *sampleNumber
call sampleNumberToRepeatOffset
castToFloat
store
ifEnd

; Stop playing
; when reaches buffer end
push _position
castToInt
push *sampleNumber
call sampleNumberToSize
greaterThan
if
push &_playing
push 0
store
ifEnd

moduleEnd
