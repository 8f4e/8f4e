module scheduler1
; @pos 299 -74
; @group ch1
use mod
int* row &rowBuffer1:
int* rowStart &rowClock:out
int* tick &tickClock:out
int* tickNumber &rowClock:counter
int noteRow ; @w 0x
int sampleNumber ; @w
int out ; @w
int targetTick -1 ; @w
int selectedSampleNumber
int pendingRow

; @hide

push &out
push 0
store

; Capture the new row and
; replace any waiting note.
push *rowStart
if
push &pendingRow
push *row
store

call maskSampleNumber pendingRow
if
push &selectedSampleNumber
call maskSampleNumber pendingRow
store
ifEnd

push &targetTick
call noteDelayTick pendingRow
store
ifEnd

; Clock outputs are already
; single-sample pulses.
push *tick
push *tickNumber
push targetTick
equal
and
if
push &noteRow
push pendingRow
store
push &sampleNumber
push selectedSampleNumber
store
push &out
push 1
store
push &targetTick
push -1
store
ifEnd

moduleEnd
