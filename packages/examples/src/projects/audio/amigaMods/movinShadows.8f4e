; Apply volume slide only on
; later ticks in the row.
push *rowTrigger
equalToZero
if
call risingEdge
- *tick &previousTick
if
push &out
push out
call rowVolumeSlideDelta *row
add
store
ifEnd
ifEnd

push &out
call clamp out 0 64
store

