int* row &rowBuffer1:
int* tick &tickClock:out
int previousTick
int* rowTrigger &rowClock:out
int* rowCounter &rowCount2:out
int out ; @w
; @meter out 0 80
; Reload base volume on
; tick 0 / row advance.
int prevRowCounter
call hasChanged
- *rowCounter &prevRowCounter
if
push &out
call rowVolumeAtRowStart
- out *row
store
