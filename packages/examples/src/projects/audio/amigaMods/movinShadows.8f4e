function period2Step
; @pos 395 -188
param int period
use mod
use env

push period
equalToZero
if
push 0.0
return
ifEnd

push PAL_AMIGA_CLOCK/2
push period
castToFloat
ensureNonZero
div
push SAMPLE_RATE
castToFloat
div

functionEnd float

function maskSampleNumber
