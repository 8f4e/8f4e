module audiooutL
; @pos 794 -6
use env

float* in &lowpassL:out
float[] buffer AUDIO_BUFFER_SIZE
int pointer &buffer

; @plot &buffer count(buffer)
; Store the input value
; in the buffer
push pointer
push *in
store

; Increment the buffer
; pointer with the word size
push &pointer
push pointer
push sizeof(buffer)
add
store

; Reset the buffer pointer
; when it reaches the end
; of the buffer
push pointer
push buffer&
greaterThan
if
push &pointer
push &buffer
store
ifEnd

moduleEnd
