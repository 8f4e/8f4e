function rowVolumeAtRowStart
; @pos 659 -140
; Apply any row-start volume
; reload first, then apply a
; fine volume slide once.
param int currentVolume
param int row
local int baseVolume

push row
call rowShouldReloadVolume
if
push row
call loadRowVolume
localSet baseVolume
else
push currentVolume
localSet baseVolume
ifEnd

push baseVolume
push row
call rowFineVolumeSlideDelta
add

functionEnd int

function rowFineVolumeSlideDelta
; @pos 659 -113
; Apply EAx/EBx once on the
; row where the new data
; becomes visible.
use mod
param int row

push row
call maskExtendedEffect
push FINE_VOLUME_SLIDE_UP
equal
if
push row
call maskParamLo
return
ifEnd

push row
call maskExtendedEffect
push FINE_VOLUME_SLIDE_DOWN
equal
if
push 0
push row
call maskParamLo
sub
return
ifEnd

push 0

functionEnd int

