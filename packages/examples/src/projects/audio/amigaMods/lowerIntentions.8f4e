use math
use env

const FREQ 4400
const MINUS_2_PI -2*PI
const CUTOFF_TERM MINUS_2_PI*FREQ
const EXPONENT CUTOFF_TERM/SAMPLE_RATE
const DECAY E^EXPONENT
const COEFFICIENT 1-DECAY

push &out
push state
push *in
push state
sub
push COEFFICIENT
mul
add
store

push &state
push out
store

