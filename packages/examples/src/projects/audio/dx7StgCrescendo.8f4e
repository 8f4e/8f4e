group reverb
; @pos 828 55
expose in &reverbInput:in
expose outL &tank1OutputMix:out
expose outR &tank2OutputMix:out

init &in &limiter:out

expose decay &controlValues:decay
expose amount &controlValues:amount
expose diffusion &controlValues:diffusion
expose damping &controlValues:damping

; @slider &decay
; @slider &amount
; @slider &diffusion
; @slider &damping

pass env

includes
; @pos 0 12
include std/events/risingEdge
include std/memory/wrapPointer
include std/math/fract
include std/memory/readInterpolated
include std/math/trig/cosine
include std/math/trig/sine
include std/math/trig/triangle
include std/math/trig/saw
include std/memory/advancePointer
include std/math/trig/advancePhase

includesEnd
