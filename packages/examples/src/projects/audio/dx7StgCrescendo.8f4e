module vibrato
; @pos 262 -55
use env
; Raw DX7 speed=35, delay=73,
; PMD=14, PMS=1; free-running sine.
; Two-stage delay: wait, then fade in.
int* noteOn &noteInput:noteOn
float phase
float delayPhase
float delayGain
float ratio 1.0
float speedHz 5.806451607495546
float delayStep 0.000012707722373306753
float fadeStep 0.000015640273690223696
float depthOctaves 0.0054931640625

push *noteOn
if
push &delayPhase
push 0.0
store
ifEnd
push &delayPhase
push delayPhase
push delayPhase
push 0.5
lessThan
if
push delayStep
else
push fadeStep
ifEnd float
mul 48000.0
push SAMPLE_RATE
castToFloat
div
add
min 1.0
store
push &delayGain
push delayPhase
sub 0.5
mul 2.0
max 0.0
store

push &ratio
call advanceWrappedPhase &phase speedHz SAMPLE_RATE
call wrapPhase
call sine
mul depthOctaves
mul delayGain
call exp2
store
