const WRITE_OFFSET_SAMPLES
- 100.0*CLOUDS_RATIO

push *pointer
push WRITE_OFFSET_SAMPLES
castToInt
push sizeof(*buffer)
mul
add
push buffer
push count(*buffer)
call wrapPointer
push *in
store

moduleEnd
module allpassDiffuser
; @pos 214 -27
; @group smearStage1
use cloudsReverb

const DELAY_SIZE round(113*CLOUDS_RATIO)

float** in &reverbInput:in
float out
float[] buffer DELAY_SIZE
float* pointer &buffer
float* diffusion
- &controlValues:diffusion

; @wave2 &buffer count(buffer) pointer

local float writeValue

push **in
push *pointer
push *diffusion
mul
add
localSet writeValue

push &out
push *pointer
push writeValue
push *diffusion
mul
sub
store

; Store the allpass
; write value
push pointer
push writeValue
store

; Advance and wrap
; circular buffer pointer
push &pointer
push &buffer
push count(buffer)
call advancePointer

