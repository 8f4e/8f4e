module audiooutL
; @pos 862 0
use env

float* in &reverb:outL

; Audio buffer
float[] buffer AUDIO_BUFFER_SIZE
int pointer &buffer

; @plot &buffer count(buffer)

; Store the input value
; in the buffer
push pointer
push *in
max -1.0
min 1.0
store

; Increment the buffer
; pointer by the
; buffer word size
push &pointer
push pointer
add sizeof(buffer)
store

; Reset the buffer pointer
; when it reaches the end
; of the buffer
push pointer
push buffer&
greaterThan
if
push &pointer
push &buffer
store
ifEnd

moduleEnd
