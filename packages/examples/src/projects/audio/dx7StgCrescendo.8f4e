function wrapPhase
; @pos -160 45
; Wrap full phase modulation to [-PI, PI].
param float phase
use math
push phase
push phase
mul INV_TAU
round
mul TAU
sub
functionEnd float

function advanceWrappedPhase
; @pos -160 75
#impure
; Preserve the full-range wrapping used
; by this patch's feedback oscillators.
param float* phase
param float frequency
param int sampleRate
use math
push phase
push *phase
push frequency
mul TAU
push sampleRate
castToFloat
ensureNonZero
div
add
call wrapPhase
store
push *phase
functionEnd float

function dxOperator
; @pos -25 -70
#impure
paramShape dxOperatorState
param int noteOn
use env
use math
push noteOn
if
push phase
push 0.0
store
push _feedback1
push 0.0
store
push _feedback2
push 0.0
store
ifEnd

push out
push phase
push **frequency
mul *ratio
mul *tuning
push SAMPLE_RATE
call advanceWrappedPhase
push **phaseMod
push *_feedback1
add *_feedback2
mul *feedback
add
mul TAU
add
call wrapPhase
call sine
mul **amplitude
store
push _feedback2
push *_feedback1
store
push _feedback1
push *out
store
functionEnd

