int[] operator5 17
- OP5_RATE1 OP5_RATE2 OP5_RATE3 OP5_RATE4
- OP5_LEVEL1 OP5_LEVEL2 OP5_LEVEL3 OP5_LEVEL4
- OP5_RATE_SCALING OP5_OUTPUT_LEVEL
- OP5_VELOCITY_SENSITIVITY OP5_BREAKPOINT
