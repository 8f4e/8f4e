function dx7VelocityCurve
; @pos 150 58
; DX7 strike velocity lookup before sensitivity.
; Paired MIDI velocities share a value.
; Source: google/music-synthesizer-for-android
; MIDI 98..99 gives neutral operator scaling.
param int velocity

push velocity
max 0
min 127
shiftRight 1
mapBegin int
map 0 0
map 1 70
map 2 86
map 3 97
map 4 106
map 5 114
map 6 121
map 7 126
map 8 132
map 9 138
map 10 142
map 11 148
map 12 152
map 13 156
map 14 160
