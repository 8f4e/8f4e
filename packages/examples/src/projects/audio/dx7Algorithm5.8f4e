module voiceInput
; @pos 254 19
; @home left
use preset
float* frequency ; Hz
int* trigger
int* release
int keySync OSC_KEY_SYNC
float latchedFrequency 8.1758
int latchedTrigger
int latchedRelease
int reset
int rateKey

; Latch inputs before the operators
; and envelopes run.
push *frequency
push latchedFrequency
notEqual
if
push &rateKey
call frequencyToRateKey *frequency
store
ifEnd
push &latchedFrequency
push *frequency
store
push &latchedTrigger
push *trigger
store
push &latchedRelease
push *release
store

; Send key sync through the oscillator wires.
push &reset
push latchedTrigger
push 0
notEqual
push keySync
push 0
notEqual
and
store

moduleEnd
module velocityCapture
; @pos 254 66
int* velocity ; MIDI 0..127
int& trigger &voiceInput:latchedTrigger
int latchedVelocity 98
int velocityCurve -1

; Capture velocity only on note-on.
push *trigger
if
push &latchedVelocity
push *velocity
max 0
min 127
store
push &velocityCurve
call dx7VelocityCurve latchedVelocity
store
ifEnd

moduleEnd
group modulation
; @pos 254 90
expose frequency &inputs:frequency
expose trigger &inputs:trigger
expose release &inputs:release
expose key &keyboardKey:out
expose lfo &lfo:out
expose lfoDelay &lfo:delayGain
expose pitchRatio &pitchModulation:out
expose amplitude &amplitudeModulation:out

; LFO, delay fade-in, pitch ratio, attenuation.
; @meter lfo 0 1
; @meter lfoDelay 0 1
; @meter pitchRatio 0 2
; @meter amplitude 0 7

init &frequency &voiceInput:latchedFrequency
init &trigger &voiceInput:latchedTrigger
init &release &voiceInput:latchedRelease

