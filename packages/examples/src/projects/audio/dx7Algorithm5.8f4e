module pitchEnvelope
; @pos 160 0
; Four stages in octaves; hold L3 until release.
; Retrigger starts R1 from the current pitch.
use env
use preset
int& trigger &inputs:noteOn
int& release &inputs:noteOff
int[] rates 4
- PITCH_RATE1 PITCH_RATE2 PITCH_RATE3 PITCH_RATE4
int[] levels 4
- PITCH_LEVEL1 PITCH_LEVEL2 PITCH_LEVEL3 PITCH_LEVEL4
int stage 3
int initialized
float out
float target
float step
; @hide
push initialized
push 0
equal
if
push &out
call loadAt &levels 3
call pitchLevel
castToFloat
div 32.0
store
push &initialized
push 1
store
ifEnd
push *trigger
if
push &stage
push 0
store
else
push *release
if
push &stage
push 3
store
ifEnd
ifEnd
push &target
call loadAt &levels stage
call pitchLevel
castToFloat
div 32.0
store
push &step
call loadAt &rates stage
call pitchRate
castToFloat
div 21.3
push SAMPLE_RATE
castToFloat
div
store
push &out
call moveTowards out target step
store
push out
push target
equal
push stage
push 2
lessThan
and
if
push &stage
push stage
add 1
store
ifEnd
moduleEnd
module pitchModulation
; @pos 220 0
; Pitch EG + delayed, bipolar LFO in octaves.
use preset
float& envelope &pitchEnvelope:out
float& lfo &lfo:out
float& delay &lfo:delayGain
int depth LFO_PITCH_DEPTH
int sensitivity PITCH_MOD_SENSITIVITY
float out 1.0
; @hide
push &out
push sensitivity
max 0
min 7
mapBegin int
map 0 0
map 1 10
map 2 20
map 3 33
map 4 55
map 5 92
map 6 153
map 7 255
mapEnd int
push depth
mul 165
shiftRight 6
mul
castToFloat
div 32768.0
push *lfo
sub 0.5
mul
mul *delay
add *envelope
call exp2
store
moduleEnd
module amplitudeModulation
; @pos 275 0
; Delayed LFO attenuation in octaves.
; Approximate measured AMD curve from Hexter:
; exp(AMD * .0428993 - .285189) / 8.
use preset
float& lfo &lfo:out
float& delay &lfo:delayGain
int depth LFO_AMPLITUDE_DEPTH
float out
; @hide
push &out
push depth
if
push depth
castToFloat
mul 0.061890610762
sub 0.411440761959
call exp2
div 8.0
push 1.0
sub *lfo
mul
mul *delay
else
push 0.0
ifEnd float
store
moduleEnd
