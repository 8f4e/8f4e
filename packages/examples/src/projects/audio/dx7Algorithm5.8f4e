function wrapDx7Phase
; @pos 80 -80
; Wrap any radian angle to [-PI, PI].
param float angle
; @hide
push angle
push angle
div 6.283185307179586
round
mul 6.283185307179586
sub
functionEnd float
function dx7Sine
; @pos 80 -50
; Keep large phase-modulation offsets periodic.
param float angle
; @hide
push angle
abs
push 3.141592653589793
greaterThan
if
call wrapDx7Phase angle
localSet angle
ifEnd
call sine angle
functionEnd float
function advanceDx7Phase
; @pos 80 -20
#impure
; Pitch sweeps may advance several cycles/sample.
param float* phase
param float frequency
param int sampleRate
local float angle
; @hide
call advancePhase phase frequency sampleRate
localSet angle
push angle
abs
push 3.141592653589793
greaterThan
if
call wrapDx7Phase angle
localSet angle
push phase
push angle
store
ifEnd
push angle
functionEnd float
function dx7LevelScale
; @pos 150 -80
; Signed log-level offset in three-key bands.
; Curves: -linear, -exponential, +exponential,
; +linear. Breakpoint 0 is MIDI key 17 (F0).
; Mapping: Google music-synthesizer-for-android.
param int key
param int breakpoint
param int leftDepth
param int rightDepth
param int leftCurve
param int rightCurve
local int offset
local int depth
local int curve
local int scale
; @hide
push key
sub breakpoint
sub 17
localSet offset
push offset
push 0
lessThan
if
push leftDepth
localSet depth
push leftCurve
localSet curve
else
push rightDepth
localSet depth
push rightCurve
localSet curve
ifEnd
push offset
abs
add 1
div 3
localSet offset
push curve
push 0
equal
push curve
push 3
equal
or
if
push offset
mul depth
mul 329
shiftRight 12
localSet scale
else
push offset
min 32
mapBegin int
map 0 0
map 1 1
map 2 2
map 3 3
map 4 4
map 5 5
map 6 6
map 7 7
map 8 8
map 9 9
map 10 11
map 11 14
map 12 16
map 13 19
map 14 23
map 15 27
map 16 33
map 17 39
map 18 47
map 19 56
map 20 66
map 21 80
map 22 94
map 23 110
map 24 126
map 25 142
map 26 158
map 27 174
map 28 190
map 29 206
map 30 222
map 31 238
map 32 250
mapEnd int
mul depth
mul 329
shiftRight 15
localSet scale
ifEnd
push curve
push 2
lessThan
if
push 0
sub scale
return
ifEnd
push scale
functionEnd int
function frequencyToKey
; @pos 150 -50
; Nearest MIDI key for keyboard scaling only.
; The oscillator frequency remains continuous.
param float frequency
local float boundary
local int key
; @hide
push 8.4153681102195
localSet boundary
loop 127
push frequency
push boundary
lessThan
if
push key
return
ifEnd
push boundary
mul 1.0594630943592953
localSet boundary
push key
add 1
localSet key
loopEnd
push key
functionEnd int
function dx7Level
; @pos 150 22
; Exact raw DX7 level mapping for 0..99.
param int level

push level
mul 5
push level
mul 4
add 1
min
push level
mul 3
add 5
min
push level
mul 2
add 11
min
push level
mul 7
div 5
add 20
min
push level
add 28
min
