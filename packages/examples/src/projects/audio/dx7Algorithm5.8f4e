; One record per operator, wired to its envelope.
; Fields: rates 1-4; levels 1-4; rate scaling;
; output level; velocity; breakpoint; left/right
; depths; left/right curves; AM sensitivity.
use preset
int[] operator1 17
- OP1_RATE1 OP1_RATE2 OP1_RATE3 OP1_RATE4
- OP1_LEVEL1 OP1_LEVEL2 OP1_LEVEL3 OP1_LEVEL4
- OP1_RATE_SCALING OP1_OUTPUT_LEVEL
