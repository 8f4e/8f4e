functionEnd int
function frequencyToRateKey
; @pos 153 -10
; DX7 rate scaling uses 3-key bands.
; Oscillator pitch stays unquantized.
param float frequency
local float boundary
local int key

; The first band starts halfway
; between MIDI notes 23 and 24.
push 31.7721991639875
localSet boundary
loop 31
push frequency
push boundary
lessThan
if
push key
return
ifEnd
push boundary
; Quarter-octave steps: 2^(3/12).
mul 1.189207115002721
localSet boundary
push key
add 1
localSet key
loopEnd
push key
