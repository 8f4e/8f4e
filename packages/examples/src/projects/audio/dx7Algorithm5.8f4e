module audioout
; @pos 292 22
use env

float& in &voice:out

; Audio buffer
float[] buffer AUDIO_BUFFER_SIZE
int pointer &buffer

; @plot &buffer count(buffer)

; Store the input value
; in the buffer
push pointer
push *in
store

; Increment the buffer
; pointer by the
; buffer word size
push &pointer
push pointer
add sizeof(buffer)
store

; Reset the buffer pointer
; when it reaches the end
; of the buffer
push pointer
push end(buffer)
greaterOrEqual
if
push &pointer
push &buffer
store
ifEnd

