module inputs
; @pos 0 0
; @home left
float* frequency
int* trigger
int* release
float frequencyHz
int noteOn
int noteOff
; @hide
push &frequencyHz
push *frequency
store
push &noteOn
push *trigger
store
push &noteOff
push *release
store
moduleEnd
module keyboardKey
; @pos 50 0
; Capture the unmodulated, transposed key.
; Vibrato does not move the level scaling.
use preset
float& frequency &inputs:frequencyHz
int& trigger &inputs:noteOn
int out
int initialized
; @hide
push *trigger
push initialized
push 0
equal
or
if
push &out
call frequencyToKey *frequency
add TRANSPOSE_SEMITONES
max 0
min 127
store
push &initialized
push 1
store
ifEnd
moduleEnd
module lfo
; @pos 100 0
; One shared LFO, independent of OSC key sync.
; Wave: triangle, saw down/up, square, sine, S&H.
use env
use preset
int& trigger &inputs:noteOn
int speed LFO_SPEED
int delay LFO_DELAY
int sync LFO_SYNC
int wave LFO_WAVE
float out 0.5
float delayGain 1.0
; Phase and delay use 30 fractional bits.
int phase
int delayPhase
int randomState
float held 0.50390625
local int increment
local int delayRate
local float saw
; @hide
push *trigger
if
push &delayPhase
push 0
store
push sync
if
push &phase
push 536870912
store
ifEnd
ifEnd

call lfoRate speed
mul 1073741824.0
