function dx7Level
; @pos 150 22
; Exact raw DX7 level mapping for 0..99.
param int level

push level
mul 5
push level
mul 4
add 1
min
push level
mul 3
add 5
min
push level
mul 2
add 11
min
push level
mul 7
div 5
add 20
min
push level
add 28
min
functionEnd int
function dx7VelocityCurve
; @pos 150 58
; DX7 strike velocity lookup before sensitivity.
; Paired MIDI velocities share a value.
; Source: google/music-synthesizer-for-android
; MIDI 98..99 gives neutral operator scaling.
param int velocity

push velocity
max 0
min 127
shiftRight 1
mapBegin int
map 0 0
map 1 70
map 2 86
map 3 97
map 4 106
map 5 114
map 6 121
map 7 126
map 8 132
map 9 138
map 10 142
map 11 148
map 12 152
map 13 156
map 14 160
map 15 163
map 16 166
map 17 170
map 18 173
map 19 174
map 20 178
map 21 181
map 22 184
map 23 186
map 24 189
map 25 190
map 26 194
map 27 196
map 28 198
map 29 200
map 30 202
map 31 205
map 32 206
map 33 209
map 34 211
map 35 214
map 36 216
map 37 218
map 38 220
map 39 222
map 40 224
map 41 225
map 42 227
map 43 229
map 44 230
map 45 232
map 46 233
map 47 235
map 48 237
map 49 238
map 50 240
map 51 241
map 52 242
map 53 243
map 54 244
map 55 246
map 56 246
map 57 248
map 58 249
map 59 250
map 60 251
map 61 252
map 62 253
map 63 254
mapEnd int
sub 239
functionEnd int
function frequencyToRateKey
; @pos 153 -10
; DX7 rate scaling uses 3-key bands.
; Oscillator pitch stays unquantized.
param float frequency
local float boundary
local int key

; The first band starts halfway
; between MIDI notes 23 and 24.
push 31.7721991639875
localSet boundary
loop 31
push frequency
push boundary
lessThan
if
push key
return
ifEnd
push boundary
; Quarter-octave steps: 2^(3/12).
mul 1.189207115002721
localSet boundary
push key
add 1
localSet key
loopEnd
push key
functionEnd int
note algorithm
; @pos 254 3
;
; DX7 algorithm 5
;
;    [2] --> [1] --+
;                  |
;    [4] --> [3] --+--> mixer
;                  |
; +->[6] --> [5] --+
; |   |
; +---+
;
noteEnd
entry main
module voiceInput
; @pos 254 19
; @home left
use preset
float* frequency ; Hz
int* trigger
int* release
int keySync OSC_KEY_SYNC
float latchedFrequency 8.1758
int latchedTrigger
int latchedRelease
int reset
int rateKey

; Latch inputs before the operators
; and envelopes run.
push *frequency
push latchedFrequency
notEqual
if
push &rateKey
call frequencyToRateKey *frequency
store
ifEnd
push &latchedFrequency
push *frequency
store
push &latchedTrigger
push *trigger
store
push &latchedRelease
push *release
store

; Send key sync through the oscillator wires.
push &reset
push latchedTrigger
push 0
notEqual
push keySync
push 0
notEqual
and
store

moduleEnd
module velocityCapture
; @pos 254 66
int* velocity ; MIDI 0..127
int* trigger &voiceInput:latchedTrigger
int latchedVelocity 98
int velocityCurve -1

; Capture velocity only on note-on.
push *trigger
if
push &latchedVelocity
push *velocity
max 0
min 127
store
push &velocityCurve
call dx7VelocityCurve latchedVelocity
store
ifEnd

moduleEnd
group envelope2
; @pos 320 0
; @group operator2
expose key &dx7PitchRateScaling:key
expose velocityCurve &dx7OutputLevel:velocityCurve
expose trigger &envelope4Stage:trigger
expose release &envelope4Stage:release
expose out &dx7Gain:out

init &key &voiceInput:rateKey
init &velocityCurve &velocityCapture:velocityCurve
init &trigger &voiceInput:latchedTrigger
init &release &voiceInput:latchedRelease

pass env
pass preset
pass dx7Level

includes
; @pos 0 -16
include std/memory/loadAt
include std/math/exp2
include std/math/moveTowards
includesEnd
entry main
module dx7Settings
; @home left
; @pos 0 0
use preset
int[] rates 4
- OP2_RATE1 OP2_RATE2 OP2_RATE3 OP2_RATE4
int[] levels 4
- OP2_LEVEL1 OP2_LEVEL2 OP2_LEVEL3 OP2_LEVEL4
int rateScaling OP2_RATE_SCALING
int outputLevel OP2_OUTPUT_LEVEL
int velocitySensitivity
- OP2_VELOCITY_SENSITIVITY
moduleEnd
module dx7PitchRateScaling
; @pos 55 0
; Pitch-dependent DX7 speed offset.
int* key
int* amount &dx7Settings:rateScaling
int out

push &out
push *key
mul *amount
shiftRight 3
store
moduleEnd
module dx7OutputLevel
; @pos 110 0
; Keep the base offset for gain normalization.
; Velocity shifts the target and audible gain.
int* in &dx7Settings:outputLevel
int* sensitivity &dx7Settings:velocitySensitivity
int* velocityCurve
float base
float out
local int level

call dx7Level *in
shiftLeft 5
localSet level
push &base
push level
sub 4256
castToFloat
store

push &out
push *velocityCurve
mul *sensitivity
add 7
shiftRight 3
shiftLeft 4
add level
max 0
sub 4256
castToFloat
store
moduleEnd
module envelope4Stage
; @pos 180 0
; Generic four-stage EG selector.
; Note-on starts 0; note-off selects 3.
; Reach 0, 1, 2, then hold stage 2.
int* trigger
int* release
float* value &envelopeRamp:out
float* target &dx7Target:out
int out 3

push *trigger
if
push &out
push 0
store
else
push *release
if
push &out
push 3
store
else
push *value
push *target
equal
push out
push 2
lessThan
and
if
push &out
push out
add 1
store
ifEnd
ifEnd
ifEnd
moduleEnd
module dx7Rate
; @pos 240 0
; Current raw rate to log step/sample.
use env
int* stage &envelope4Stage:out
int* rates &dx7Settings:rates
int* scaling &dx7PitchRateScaling:out
float out
local int qrate

call loadAt rates *stage
mul 41
shiftRight 6
add *scaling
min 63
localSet qrate
push &out
push qrate
and 3
add 4
castToFloat
push 1
push qrate
shiftRight 2
shiftLeft
castToFloat
mul
div 16384.0
mul 44100.0
push SAMPLE_RATE
castToFloat
div
store
moduleEnd
module dx7Target
; @pos 300 0
; Current raw level to log target.
int* stage &envelope4Stage:out
int* levels &dx7Settings:levels
float* offset &dx7OutputLevel:out
float out

push &out
call loadAt levels *stage
call dx7Level
shiftRight 1
shiftLeft 6
castToFloat
add *offset
max 16.0
store
moduleEnd
module dx7Curve
; @pos 360 0
; DX7 rising curve and attack jump.
; Falling segments use the base step.
float* in &envelopeRamp:out
float* target &dx7Target:out
float* rate &dx7Rate:out
float current
float step

push &current
push *in
store
push &step
push *rate
store
push *target
push *in
greaterThan
if
push &current
push *in
max 1716.0
min *target
store
push &step
push 4256.0
sub current
div 256.0
mul *rate
store
ifEnd
moduleEnd
module envelopeRamp
; @pos 420 0
; Generic ramp toward a target.
float* in &dx7Curve:current
float* target &dx7Target:out
float* step &dx7Curve:step
float out

push &out
call moveTowards *in *target *step
store
moduleEnd
module dx7Gain
; @pos 480 0
; Normalized log-to-linear amplitude.
float* in &envelopeRamp:out
float* offset &dx7OutputLevel:base
float out

push &out
push *in
push 16.0
greaterThan
if
push *in
push *offset
add 4032.0
sub
div 256.0
call exp2
else
push 0.0
ifEnd float
store
moduleEnd
entryEnd
groupEnd
group envelope4
; @pos 320 26
; @group operator4
expose key &dx7PitchRateScaling:key
expose velocityCurve &dx7OutputLevel:velocityCurve
expose trigger &envelope4Stage:trigger
expose release &envelope4Stage:release
expose out &dx7Gain:out

init &key &voiceInput:rateKey
init &velocityCurve &velocityCapture:velocityCurve
init &trigger &voiceInput:latchedTrigger
init &release &voiceInput:latchedRelease

pass env
pass preset
pass dx7Level

