group voice
; @pos 237 22
expose frequency &voiceInput:frequency
expose velocity &velocityCapture:velocity
expose trigger &voiceInput:trigger
expose release &voiceInput:release
expose out &limiter:out

init &frequency &noteInput:frequency
init &velocity &noteInput:velocity
init &trigger &noteInput:noteOn
init &release &noteInput:noteOff

pass env
pass preset

includes
; @pos -25 -70
include std/math/trig/sine
