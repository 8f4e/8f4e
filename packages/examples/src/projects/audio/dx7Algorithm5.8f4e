module modulator2
; @pos 382 0
; @group operator2
use env
use preset
float* frequency &voiceInput:latchedFrequency
int* reset &voiceInput:reset
float phase 0.0
float out
float ratio OP2_RATIO
float fixedHz OP2_FIXED_HZ
float* amplitude &envelope2:out
float level OP2_GAIN

; @hide
; Reset before advancing this sample.
push *reset
if
push &phase
push 0.0
store
ifEnd

; Advance and wrap without losing overshoot.
push &out
push &phase
push *frequency
mul ratio
add fixedHz
push SAMPLE_RATE
call advancePhase
; You can swap this call
; with any periodic function
call sine
mul *amplitude
mul level
store

moduleEnd
module modulator4
; @pos 382 26
; @group operator4
use env
use preset
float* frequency &voiceInput:latchedFrequency
int* reset &voiceInput:reset
float phase 0.0
float out
float ratio OP4_RATIO
float fixedHz OP4_FIXED_HZ
float* amplitude &envelope4:out
float level OP4_GAIN

; @hide
; Reset before advancing this sample.
push *reset
if
push &phase
push 0.0
store
ifEnd

; Advance and wrap without losing overshoot.
push &out
push &phase
push *frequency
mul ratio
add fixedHz
push SAMPLE_RATE
call advancePhase
; You can swap this call
; with any periodic function
call sine
mul *amplitude
mul level
store

moduleEnd
module modulator6
; @pos 382 52
; @group operator6
use env
use preset
float* frequency &voiceInput:latchedFrequency
int* reset &voiceInput:reset
float phase 0.0
float out
float previousOut
int feedback FEEDBACK ; 0..7
float ratio OP6_RATIO
float fixedHz OP6_FIXED_HZ
float* amplitude &envelope6:out
float level OP6_GAIN
local int amount
local float angle

const TAU 6.283185307179586

; @hide
; Reset before advancing this sample.
push *reset
if
push &phase
push 0.0
store
push &out
push 0.0
store
push &previousOut
push 0.0
store
ifEnd

push feedback
max 0
min 7
localSet amount

; Advance and wrap without losing overshoot.
push &out
push &phase
push *frequency
mul ratio
add fixedHz
push SAMPLE_RATE
call advancePhase
localSet angle

; Feedback uses the same radian units as
; the forward phase-modulation wires.
; Combine two outputs, doubling per level.
push amount
if
push out
add previousOut
push 1
push amount
shiftLeft
castToFloat
mul
div 512.0
add angle
localSet angle

; Keep the modulated phase in [-PI, PI].
push angle
push angle
div TAU
round
mul TAU
sub
localSet angle
ifEnd

push angle
; You can swap this call
; with any periodic function
call sine
mul *amplitude
mul level

; Save n-1 before publishing the new output.
push &previousOut
push out
store
store

moduleEnd
