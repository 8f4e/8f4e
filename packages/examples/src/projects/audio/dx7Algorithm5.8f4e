float* in &envelopeRamp:out
float* offset &dx7OutputLevel:base
float out

push &out
push *in
push 16.0
greaterThan
if
push *in
push *offset
add 4032.0
sub
div 256.0
call exp2
else
push 0.0
ifEnd float
store
moduleEnd
entryEnd
groupEnd
group envelope5
; @pos 437 52
; @group operator5
expose key &dx7PitchRateScaling:key
expose velocityCurve &dx7OutputLevel:velocityCurve
expose trigger &envelope4Stage:trigger
expose release &envelope4Stage:release
expose out &dx7Gain:out

init &key &voiceInput:rateKey
init &velocityCurve &velocityCapture:velocityCurve
init &trigger &voiceInput:latchedTrigger
init &release &voiceInput:latchedRelease

pass env
pass preset
pass dx7Level

includes
; @pos 0 -16
include std/memory/loadAt
include std/math/exp2
include std/math/moveTowards
includesEnd
entry main
module dx7Settings
; @home left
; @pos 0 0
use preset
int[] rates 4
- OP5_RATE1 OP5_RATE2 OP5_RATE3 OP5_RATE4
int[] levels 4
- OP5_LEVEL1 OP5_LEVEL2 OP5_LEVEL3 OP5_LEVEL4
int rateScaling OP5_RATE_SCALING
int outputLevel OP5_OUTPUT_LEVEL
int velocitySensitivity
- OP5_VELOCITY_SENSITIVITY
moduleEnd
module dx7PitchRateScaling
; @pos 55 0
; Pitch-dependent DX7 speed offset.
int* key
int* amount &dx7Settings:rateScaling
int out

push &out
push *key
mul *amount
shiftRight 3
store
moduleEnd
module dx7OutputLevel
; @pos 110 0
; Keep the base offset for gain normalization.
; Velocity shifts the target and audible gain.
int* in &dx7Settings:outputLevel
int* sensitivity &dx7Settings:velocitySensitivity
int* velocityCurve
float base
float out
local int level

call dx7Level *in
shiftLeft 5
localSet level
push &base
push level
sub 4256
castToFloat
store

push &out
push *velocityCurve
mul *sensitivity
add 7
shiftRight 3
shiftLeft 4
add level
max 0
sub 4256
castToFloat
store
moduleEnd
module envelope4Stage
; @pos 180 0
; Generic four-stage EG selector.
; Note-on starts 0; note-off selects 3.
; Reach 0, 1, 2, then hold stage 2.
int* trigger
int* release
float* value &envelopeRamp:out
float* target &dx7Target:out
int out 3

push *trigger
if
push &out
push 0
store
else
push *release
if
push &out
push 3
store
else
push *value
push *target
equal
push out
push 2
lessThan
and
if
push &out
push out
add 1
store
ifEnd
ifEnd
ifEnd
moduleEnd
module dx7Rate
; @pos 240 0
; Current raw rate to log step/sample.
use env
int* stage &envelope4Stage:out
int* rates &dx7Settings:rates
int* scaling &dx7PitchRateScaling:out
float out
local int qrate

call loadAt rates *stage
mul 41
shiftRight 6
add *scaling
min 63
localSet qrate
push &out
push qrate
and 3
add 4
castToFloat
push 1
push qrate
shiftRight 2
shiftLeft
castToFloat
mul
div 16384.0
mul 44100.0
push SAMPLE_RATE
castToFloat
div
store
moduleEnd
module dx7Target
; @pos 300 0
; Current raw level to log target.
int* stage &envelope4Stage:out
int* levels &dx7Settings:levels
float* offset &dx7OutputLevel:out
float out

push &out
call loadAt levels *stage
call dx7Level
shiftRight 1
shiftLeft 6
castToFloat
add *offset
max 16.0
store
moduleEnd
module dx7Curve
; @pos 360 0
; DX7 rising curve and attack jump.
; Falling segments use the base step.
float* in &envelopeRamp:out
float* target &dx7Target:out
float* rate &dx7Rate:out
float current
float step

push &current
push *in
store
push &step
push *rate
store
push *target
push *in
greaterThan
if
push &current
push *in
max 1716.0
min *target
store
push &step
push 4256.0
sub current
div 256.0
mul *rate
store
ifEnd
moduleEnd
module envelopeRamp
; @pos 420 0
; Generic ramp toward a target.
float* in &dx7Curve:current
float* target &dx7Target:out
float* step &dx7Curve:step
float out

push &out
call moveTowards *in *target *step
store
moduleEnd
module dx7Gain
; @pos 480 0
; Normalized log-to-linear amplitude.
float* in &envelopeRamp:out
float* offset &dx7OutputLevel:base
float out

push &out
push *in
push 16.0
greaterThan
if
push *in
push *offset
add 4032.0
sub
div 256.0
call exp2
else
push 0.0
ifEnd float
store
moduleEnd
entryEnd
groupEnd
module carrier1
; @pos 499 0
; @group operator1
use env
use preset
float* frequency &voiceInput:latchedFrequency
int* reset &voiceInput:reset
float* phaseMod &modulator2:out
float phase 0.0
float ratio OP1_RATIO
float fixedHz OP1_FIXED_HZ
float level OP1_GAIN
float out
float* amplitudeMod &envelope1:out

; @hide
; Reset before advancing this sample.
push *reset
if
push &phase
push 0.0
store
ifEnd

; Advance and wrap without losing overshoot.
push &out
push &phase
push *frequency
mul ratio
add fixedHz
push SAMPLE_RATE
call advancePhase
add *phaseMod
; You can swap this call
; with any periodic function
call sine
mul *amplitudeMod
mul level
store

moduleEnd
module carrier3
; @pos 499 26
; @group operator3
use env
use preset
float* frequency &voiceInput:latchedFrequency
int* reset &voiceInput:reset
float* phaseMod &modulator4:out
float phase 0.0
float ratio OP3_RATIO
float fixedHz OP3_FIXED_HZ
float level OP3_GAIN
float out
float* amplitudeMod &envelope3:out

; @hide
; Reset before advancing this sample.
push *reset
if
push &phase
push 0.0
store
ifEnd

; Advance and wrap without losing overshoot.
push &out
push &phase
push *frequency
mul ratio
add fixedHz
push SAMPLE_RATE
call advancePhase
add *phaseMod
; You can swap this call
; with any periodic function
call sine
mul *amplitudeMod
mul level
store

moduleEnd
module carrier5
; @pos 499 52
; @group operator5
use env
use preset
float* frequency &voiceInput:latchedFrequency
int* reset &voiceInput:reset
float* phaseMod &modulator6:out
float phase 0.0
float ratio OP5_RATIO
float fixedHz OP5_FIXED_HZ
float out
float* amplitude &envelope5:out
float level OP5_GAIN

; @hide
; Reset before advancing this sample.
push *reset
if
push &phase
push 0.0
store
ifEnd

; Advance and wrap without losing overshoot.
push &out
push &phase
push *frequency
mul ratio
add fixedHz
push SAMPLE_RATE
call advancePhase
add *phaseMod
; You can swap this call
; with any periodic function
call sine
mul *amplitude
mul level
store

moduleEnd
module mixer
; @pos 556 26

use preset

float* in1 &carrier1:out
float* in2 &carrier3:out
float* in3 &carrier5:out
float out

push &out
push *in1
mul MIX1_GAIN
push *in2
mul MIX3_GAIN
add
push *in3
mul MIX5_GAIN
add
; Headroom for three attack peaks.
mul OUTPUT_GAIN
store

moduleEnd
module limiter
; @pos 601 26
float* in &mixer:out
float out

push &out
push *in
max -1.0
min 1.0
store
moduleEnd
entryEnd
groupEnd
module audioout
; @pos 292 22
use env

float* in &voice:out

; Audio buffer
float[] buffer AUDIO_BUFFER_SIZE
int pointer &buffer

; @plot &buffer count(buffer)

; Store the input value
; in the buffer
push pointer
push *in
store

; Increment the buffer
; pointer by the
; buffer word size
push &pointer
push pointer
add sizeof(buffer)
store

; Reset the buffer pointer
; when it reaches the end
; of the buffer
push pointer
push buffer&
greaterThan
if
push &pointer
push &buffer
store
ifEnd

moduleEnd
entryEnd