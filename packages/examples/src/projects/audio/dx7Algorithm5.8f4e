note algorithm
; @pos 254 3
;
; DX7 algorithm 5
;
;    [2] --> [1] --+
;                  |
;    [4] --> [3] --+--> mixer
;                  |
; +->[6] --> [5] --+
; |   |
; +---+
;
noteEnd
template dx7Envelope
constants dx7EnvelopeFields
; @pos 0 -38
; Integer record: 4 rates, 4 levels, then scaling.
const LEVELS 4
const RATE_SCALING 8
const OUTPUT_LEVEL 9
const VELOCITY_SENSITIVITY 10
const BREAKPOINT 11
const LEFT_DEPTH 12
const RIGHT_DEPTH 13
const LEFT_CURVE 14
const RIGHT_CURVE 15
const AMPLITUDE_SENSITIVITY 16
constantsEnd
includes
; @pos 0 -16
include std/memory/loadAt
include std/math/exp2
include std/math/moveTowards
includesEnd
entry main
module dx7Settings
; @home left
; @pos 0 0
; Wired preset record from the voice.
int* in
moduleEnd
module dx7PitchRateScaling
; @pos 55 0
; Pitch-dependent DX7 speed offset.
int* key
use dx7EnvelopeFields
int** settings &dx7Settings:in
int out

push &out
push *key
call loadAt *settings RATE_SCALING
mul
shiftRight 3
store
moduleEnd
module dx7KeyboardLevelScaling
; @pos 110 0
; Three-key scaling changes level, not pitch.
int* key
use dx7EnvelopeFields
int** settings &dx7Settings:in
int out
; @hide
push &out
push *key
call loadAt *settings BREAKPOINT
call loadAt *settings LEFT_DEPTH
call loadAt *settings RIGHT_DEPTH
call loadAt *settings LEFT_CURVE
call loadAt *settings RIGHT_CURVE
call dx7LevelScale
store
moduleEnd
module dx7OutputLevel
; @pos 175 0
; Keep the base offset for gain normalization.
; Velocity and key scaling remain audible.
use dx7EnvelopeFields
int** settings &dx7Settings:in
int* velocityCurve
int& keyScaling &dx7KeyboardLevelScaling:out
float base
float out
local int level

call loadAt *settings OUTPUT_LEVEL
call dx7Level
localSet level
push &base
push level
shiftLeft 5
sub 4256
castToFloat
store

push &out
push *velocityCurve
call loadAt *settings VELOCITY_SENSITIVITY
mul
add 7
shiftRight 3
shiftLeft 4
push level
add *keyScaling
max 0
min 127
shiftLeft 5
add
max 0
sub 4256
castToFloat
store
moduleEnd
module envelope4Stage
; @pos 250 0
; Generic four-stage EG selector.
; Note-on starts 0; note-off selects 3.
; Reach 0, 1, 2, then hold stage 2.
int* trigger
int* release
float& value &envelopeRamp:out
float& target &dx7Target:out
int out 3

push *trigger
if
push &out
push 0
store
else
push *release
if
push &out
push 3
store
else
push *value
push *target
equal
push out
push 2
lessThan
and
if
push &out
push out
add 1
store
ifEnd
ifEnd
ifEnd
moduleEnd
module dx7Rate
; @pos 310 0
; Current raw rate to log step/sample.
use env
int& stage &envelope4Stage:out
int** settings &dx7Settings:in
int& scaling &dx7PitchRateScaling:out
float out
local int qrate

call loadAt *settings *stage
mul 41
shiftRight 6
add *scaling
min 63
localSet qrate
push &out
push qrate
and 3
add 4
castToFloat
push 1
push qrate
shiftRight 2
shiftLeft
castToFloat
mul
div 16384.0
mul 44100.0
push SAMPLE_RATE
castToFloat
div
store
moduleEnd
module dx7Target
; @pos 370 0
; Current raw level to log target.
int& stage &envelope4Stage:out
use dx7EnvelopeFields
int** settings &dx7Settings:in
float& offset &dx7OutputLevel:out
float out

push &out
push *settings
push *stage
add LEVELS
call loadAt
call dx7Level
shiftRight 1
shiftLeft 6
castToFloat
add *offset
max 16.0
store
moduleEnd
module dx7Curve
; @pos 430 0
; DX7 rising curve and attack jump.
; Falling segments use the base step.
float& in &envelopeRamp:out
float& target &dx7Target:out
float& rate &dx7Rate:out
float current
float step

push &current
push *in
store
push &step
push *rate
store
push *target
push *in
greaterThan
if
push &current
push *in
max 1716.0
min *target
store
push &step
push 4256.0
sub current
div 256.0
mul *rate
store
ifEnd
moduleEnd
module envelopeRamp
; @pos 490 0
; Generic ramp toward a target.
float& in &dx7Curve:current
float& target &dx7Target:out
float& step &dx7Curve:step
float out

push &out
call moveTowards *in *target *step
store
moduleEnd
module dx7AmplitudeModulation
; @pos 550 0
; Per-operator sensitivity to the shared LFO.
; Sensitivities measured in Hexter.
float* in
use dx7EnvelopeFields
int** settings &dx7Settings:in
float out
; @hide
push &out
call loadAt *settings AMPLITUDE_SENSITIVITY
max 0
min 3
mapBegin int
map 0 0.0
map 1 0.238058
map 2 0.460510
map 3 1.0
mapEnd float
mul *in
store
moduleEnd
module dx7Gain
; @pos 610 0
; Normalized log-to-linear amplitude.
float& in &envelopeRamp:out
float& offset &dx7OutputLevel:base
float& attenuation &dx7AmplitudeModulation:out
float out

push &out
push *in
push 16.0
greaterThan
if
push *in
push *offset
add 4032.0
sub
div 256.0
sub *attenuation
call exp2
else
push 0.0
ifEnd float
store
moduleEnd
entryEnd
templateEnd
