entry main
module tempo
; @pos 51 14
use env
; @home left
int bpmA 93
; @slider &bpmA 20 240 1
int ratioA 32 ; @w
; @slider &ratioA 1 32 1
int ratioB 31 ; @w
; @slider &ratioB 1 32 1
int spanA SAMPLE_RATE*60
int incrementB
int spanB

; BPM B = bpmA * ratioB / ratioA.
; Keep both terms in the phase math.
push &incrementB
push bpmA
mul ratioB
store

push &spanB
push spanA
mul ratioA
store
moduleEnd
module phaseReset
; @pos 51 48
; Reset both clocks on press.
int reset
; @button &reset
int previous -1
int out

; Also pulse on the first sample.
push &out
push reset
call risingEdge &previous
store
moduleEnd
module clockB
; @pos 104 40
int& increment &tempo:incrementB
int& span &tempo:spanB
int& reset &phaseReset:out
int phase
int out

; Start a new beat on reset.
push *reset
if
push &phase
push *span
store
ifEnd

push &out
push phase
push *span
greaterOrEqual
store

; Advance and wrap the phase.
push &phase
push phase
push out
mul *span
sub
add *increment
store
moduleEnd
module clockA
; @pos 107 -6
int& increment &tempo:bpmA
int& span &tempo:spanA
int& reset &phaseReset:out
int phase
int out

; Start a new beat on reset.
push *reset
if
push &phase
push *span
store
ifEnd

push &out
push phase
push *span
greaterOrEqual
store

; Advance and wrap the phase.
push &phase
push phase
push out
mul *span
sub
add *increment
store
moduleEnd
module snareA
; @pos 147 -6
use env

int16[] buffer ASSET_SNARE_SIZE/2
int& trigger &clockA:out
int16* playhead end(buffer)
int out
; @wave2 &buffer count(buffer) playhead

; Restart the sample on a pulse.
push *trigger
if
push &playhead
push &buffer
store
ifEnd

; Play once to the end of the buffer.
push playhead
push end(buffer)
lessThan
if
push &out
push *playhead
store

push &playhead
push playhead
add sizeof(buffer)
store
ifEnd
moduleEnd
