module audiooutL
; @pos 203 -6
use env

int& in &snareA:out
float[] buffer AUDIO_BUFFER_SIZE
int position
; @plot &buffer count(buffer)

push &buffer
push position
mul sizeof(buffer)
add
push *in
castToFloat
div 65536.0
store

push &position
push position
add 1
push count(buffer)
remainder
store
moduleEnd
