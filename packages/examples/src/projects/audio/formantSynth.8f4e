module sequencer1
; @pos 65 17

float* in &formantFreqs:0
int* trigger &clock:out
int prev
float out ; @w

push &out
push *in
store

push *trigger
push &prev
call risingEdge
if 
push &in
push in
push 4
add
store
ifEnd

push in
push &formantFreqs:8
greaterThan
if
push &in
push &formantFreqs:0
store
ifEnd

moduleEnd
