module mixer
; @pos 321 9

float* formant1
- &resonantLowPassFilter:band
float* formant2
- &resonantLowPassFilter2:band
float* formant3
- &resonantLowPassFilter3:band

float gain1 1.0
float gain2 0.4
float gain3 0.25

; @slider &gain1 0 1 0.01
; @slider &gain2 0 1 0.01
; @slider &gain3 0 1 0.01

float out

push &out
push *formant1
push gain1
mul
push *formant2
push gain2
mul
add
push *formant3
push gain3
mul
add
push 2.0
div

store

moduleEnd
module audioout
; @pos 365 9
; @home right
use env

float* in &mixer:out

; Audio buffer
float[] buffer AUDIO_BUFFER_SIZE
int pointer &buffer

; @plot &buffer count(buffer)

; Store the input value
; in the buffer
push pointer
push *in
push 0.5
mul
store

; Increment the buffer
; pointer by the
; buffer word size
push &pointer
push pointer
push sizeof(buffer)
add
store

; Reset the buffer pointer
; when it reaches the end
; of the buffer
push pointer
push buffer&
greaterThan
if
push &pointer
push &buffer
store
ifEnd

