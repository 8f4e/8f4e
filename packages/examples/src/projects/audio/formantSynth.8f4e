module phaseAccumulator
; @pos 130 -31
use env

float defaultFreq 100
float* frequency &defaultFreq
float phase
float out

use math

; Advance phase by
; TAU * frequency / SAMPLE_RATE
push &phase
push phase
push TAU
push *frequency
mul
push SAMPLE_RATE
castToFloat
ensureNonZero
div
add
store

; Wrap phase when it exceeds PI
push phase
push PI
greaterThan
if
push &phase
push NEG_PI
store
ifEnd

; Sawtooth wave: phase / PI
push &out
push phase
push PI
div
store

moduleEnd
