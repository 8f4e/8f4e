module clock
; @pos 20 -20
use env

int counter
int out

; Count samples until one 
; second has passed.
push &counter
push counter
push 1
add
store

; High for exactly one sample.
push &out
push counter
push SAMPLE_RATE
equal
store

push out
if
push &counter
push 0
store
ifEnd

moduleEnd
