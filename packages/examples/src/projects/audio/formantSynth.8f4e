module resonantLowPassFilter
; @pos 180 9
; Minimal state-variable filter.
; out is the low-pass state; 
; band is the band-pass state.
; freq sets frequency
; lower damping gives more resonance.

float* in &phaseAccumulator:out
float* freq &sequencer1:out
float damping 0.15
float low
float band

; @slider &damping 0.02 0.5 0.005

; low = low + freq * band
push &low
push low
push *freq
push band
mul
add
store

; Keep band's destination 
; and old value below high.
push &band
push band

; high = input - low - damping * band
push *in
push low
sub
push damping
push band
mul
sub

; band = band + freq*high
push *freq
mul
add
store

moduleEnd
