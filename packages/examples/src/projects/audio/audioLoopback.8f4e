entry main
module audioin
; @pos 5 1
use env

; Audio buffer
float[] buffer AUDIO_BUFFER_SIZE
float out
int pointer &buffer

; @plot &buffer count(buffer)

push &out
push pointer
loadFloat
store

push &pointer
push pointer
push sizeof(buffer)
add
store

push pointer
push buffer&
greaterThan
if
push &pointer
push &buffer
store
ifEnd

