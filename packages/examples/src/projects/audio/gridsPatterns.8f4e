; @slider &gainBD 0 1 0.01
float gainSD 0.5
; @slider &gainSD 0 1 0.01
float gainHH 0.3
; @slider &gainHH 0 1 0.01
float out

push &out
push *bd
push *hitGainBD
mul
push gainBD
mul
push *sd
push *hitGainSD
mul
push gainSD
mul
add
push *hh
push *hitGainHH
mul
push gainHH
mul
add
push -1.0
max
push 1.0
min
store
moduleEnd
