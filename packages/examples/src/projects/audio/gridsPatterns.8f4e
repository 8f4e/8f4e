module mixer
; @pos 276 1

float* bd &kick:out
float* sd &snare:out
float* hh &hiHat:out
float* hitGainBD &kickGain:out
float* hitGainSD &snareGain:out
float* hitGainHH &hiHatGain:out

float gainBD 0.6
; @slider &gainBD 0 1 0.01
float gainSD 0.5
; @slider &gainSD 0 1 0.01
float gainHH 0.3
; @slider &gainHH 0 1 0.01
float out

push &out
push *bd
push *hitGainBD
mul
push gainBD
mul
push *sd
push *hitGainSD
mul
push gainSD
mul
add
push *hh
push *hitGainHH
mul
push gainHH
mul
add
push -1.0
max
push 1.0
min
store
moduleEnd
module audioout
; @pos 318 9
use env

float* in &mixer:out
float[] buffer AUDIO_BUFFER_SIZE
int position

; @plot &buffer count(buffer)

push &buffer
push position
push sizeof(buffer)
mul
add
push *in
store

push &position
push position
push 1
add
push count(buffer)
remainder
store
moduleEnd
entryEnd