module kick
; @pos 90 -2
use env

int16[] buffer
- ASSET_KICK_SIZE/2
int& trigger &grids:bd
int previous
const BYTES ASSET_KICK_SIZE
int16* playhead &buffer+BYTES
float out
; @wave2 &buffer count(buffer) playhead

push *trigger
call risingEdge &previous
if
push &playhead
push &buffer
store
ifEnd

push playhead
push &buffer+BYTES
lessThan
if
push &out
push *playhead
castToFloat
push min(buffer)*-1.0
div
store

push &playhead
push playhead
push sizeof(buffer)
add
store
ifEnd
moduleEnd
module kickGain
; @pos 118 51
; Holds normal/accented
; gain for each hit.

int& trigger &grids:bd
int& accent
- &grids:accentBD
