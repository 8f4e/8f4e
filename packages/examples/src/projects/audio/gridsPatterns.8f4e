note patterns
; @pos 78 -36
Mutable Instruments Grids patterns

25 patterns with 32 steps each.
One row per step; columns are
bass drum (BD), snare drum (SD),
and hi-hat / percussion (HH).
Values are rhythmic importance
levels in the range 0 to 255.

Each patternNN matches node_N
in the original source.
Modules follow the original
X/Y map: X increases right,
and Y increases downward.

X and Y blend nearby patterns
using the original drum map.
All five controls range from
0 to 255. Density zero mutes
that channel; higher values
include weaker rhythmic steps.
Gate calculations run only on rising clock edges.
The BD, SD and HH outputs pulse
once per triggered step.
The accent outputs pulse on
hits with a level above 192.
Step numbers run from 0 to 31.
noteEnd
entry main
module sequencer
; @pos -128 0

int* trigger
int step
int nextStep
int previousTrigger
int tick

; Trigger outputs last one sample.
push &outputs:bd
push 0
store

push &outputs:sd
push 0
store

push &outputs:hh
push 0
store

push &outputs:accentBD
push 0
store

push &outputs:accentSD
push 0
store

push &outputs:accentHH
push 0
store

push &tick
push *trigger
call risingEdge
- &previousTrigger
store

push tick
if
push &step
push nextStep
store

push &nextStep
push step
push 1
add
push 31
and
store

call gate
ifEnd
moduleEnd
entryEnd
entry gate
module mapReader
; @pos -68 0
; @home left
int* step &sequencer:step
int x 128
int y 128
; Corners: A B
;          C D
int* rowA &pattern04:0
int* rowB &pattern21:0
int* rowC &pattern05:0
int* rowD &pattern01:0
int levelBD
int levelSD
int levelHH

local int balanceX
local int balanceY

push x
push y
push *step
call selectRows
- &rowA
- &rowB
- &rowC
- &rowD

push x
call mapBalance
localSet balanceX
push y
call mapBalance
localSet balanceY

push &levelBD
push rowA
push rowB
push rowC
push rowD
push 24
push balanceX
push balanceY
call readMap
store

push &levelSD
push rowA
push rowB
push rowC
push rowD
push 16
push balanceX
push balanceY
call readMap
store

push &levelHH
push rowA
push rowB
push rowC
push rowD
push 8
push balanceX
push balanceY
call readMap
store
moduleEnd
module outputs
; @pos -34 0

int* levelBD
- &mapReader:levelBD
int* levelSD
- &mapReader:levelSD
int* levelHH
- &mapReader:levelHH
int densityBD 128
int densitySD 128
int densityHH 128
int bd
int sd
int hh
int accentBD
int accentSD
int accentHH

push &bd
push *levelBD
push densityBD
call densityHit
store

push &sd
push *levelSD
push densitySD
call densityHit
store

push &hh
push *levelHH
push densityHH
call densityHit
store

push &accentBD
push bd
push *levelBD
call accentHit
store

push &accentSD
push sd
push *levelSD
call accentHit
store

push &accentHH
push hh
push *levelHH
call accentHit
store
moduleEnd
