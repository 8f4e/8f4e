along with this program.  If not, see <http://www.gnu.org/licenses/>.


Source:
https://github.com/pichenettes/eurorack/blob/2a468734bdd53bea0f25165bf34d92a4c571db13/grids/resources.cc
Map layout:
https://github.com/pichenettes/eurorack/blob/2a468734bdd53bea0f25165bf34d92a4c571db13/grids/pattern_generator.cc
noteEnd

function buffer
; @pos -34 0
#export buffer
use env

loop AUDIO_BUFFER_SIZE
call main
loopEnd
functionEnd

constants env
; @pos 0 -25
const SAMPLE_RATE 48000
const AUDIO_BUFFER_SIZE 128
const ASSET_KICK_SIZE 29410
const ASSET_SNARE_SIZE 19688
const ASSET_HIHAT_SIZE 21500
constantsEnd

entry main
module clock
; @pos 0 0
; @home left
use env

const STEPS_PER_BEAT 8
int bpm 120
; @slider &bpm 40 240 1
int phase
int out
; @watch out

push &out
push 0
store

push &phase
push phase
push bpm
push STEPS_PER_BEAT
mul
add
store

push phase
push SAMPLE_RATE
push 60
mul
greaterOrEqual
if
push &phase
push phase
push SAMPLE_RATE
push 60
mul
sub
store

push &out
push 1
store
ifEnd
moduleEnd

module kick
; @pos 80 0
use env

int16[] buffer
- ASSET_KICK_SIZE/2
int* trigger &grids:bd
int previous
const BYTES ASSET_KICK_SIZE
int16* playhead &buffer+BYTES
float out
; @wave2 &buffer count(buffer) playhead

push *trigger
call risingEdge &previous
if
push &playhead
push &buffer
store
ifEnd

push &out
push 0.0
store

push playhead
push &buffer+BYTES
lessThan
if
push &out
push *playhead
castToFloat
push min(buffer)*-1.0
div
store

push &playhead
push playhead
push sizeof(buffer)
add
store
ifEnd
moduleEnd

module snare
; @pos 128 0
use env

int16[] buffer
- ASSET_SNARE_SIZE/2
int* trigger &grids:sd
int previous
const BYTES ASSET_SNARE_SIZE
int16* playhead &buffer+BYTES
float out
; @wave2 &buffer count(buffer) playhead

push *trigger
call risingEdge &previous
if
push &playhead
push &buffer
store
ifEnd

push &out
push 0.0
store

push playhead
push &buffer+BYTES
lessThan
if
push &out
push *playhead
castToFloat
push min(buffer)*-1.0
div
store

push &playhead
push playhead
push sizeof(buffer)
add
store
ifEnd
moduleEnd

module hiHat
; @pos 176 0
use env

int16[] buffer
- ASSET_HIHAT_SIZE/2
int* trigger &grids:hh
int previous
const BYTES ASSET_HIHAT_SIZE
int16* playhead &buffer+BYTES
float out
; @wave2 &buffer count(buffer) playhead

push *trigger
call risingEdge &previous
if
push &playhead
push &buffer
store
ifEnd

push &out
push 0.0
store

push playhead
push &buffer+BYTES
lessThan
if
push &out
push *playhead
castToFloat
push min(buffer)*-1.0
div
store

push &playhead
push playhead
push sizeof(buffer)
add
store
ifEnd
moduleEnd

module mixer
; @pos 224 0

float* bd &kick:out
float* sd &snare:out
float* hh &hiHat:out
float gainBD 0.6
; @slider &gainBD 0 1 0.01
float gainSD 0.5
; @slider &gainSD 0 1 0.01
float gainHH 0.3
; @slider &gainHH 0 1 0.01
float out

push &out
push *bd
push gainBD
mul
push *sd
push gainSD
mul
add
push *hh
push gainHH
mul
add
push -1.0
max
push 1.0
min
store
moduleEnd

module audioout
; @pos 259 0
use env

float* in &mixer:out
float[] buffer AUDIO_BUFFER_SIZE
int position

; @plot &buffer count(buffer)

push &buffer
push position
push sizeof(buffer)
mul
add
push *in
store

push &position
push position
push 1
add
push count(buffer)
remainder
store
moduleEnd

group grids
; @pos 34 0
expose trigger &sequencer:trigger
init &trigger &clock:out

expose x &sequencer:x
; @slider &x 0 255 1
expose y &sequencer:y
; @slider &y 0 255 1
expose densityBD &sequencer:densityBD
; @slider &densityBD 0 255 1
expose densitySD &sequencer:densitySD
; @slider &densitySD 0 255 1
expose densityHH &sequencer:densityHH
; @slider &densityHH 0 255 1

expose bd &sequencer:bd
expose sd &sequencer:sd
expose hh &sequencer:hh
expose step &sequencer:step
; @watch bd
; @watch sd
; @watch hh
; @watch step
function patternAddress
; @pos -68 0
param int cellX
param int cellY

push cellX
push 5
mul
push cellY
add
mapBegin int
map 0 &pattern10:0
map 1 &pattern08:0
map 2 &pattern00:0
map 3 &pattern09:0
map 4 &pattern11:0
map 5 &pattern15:0
map 6 &pattern07:0
map 7 &pattern13:0
map 8 &pattern12:0
map 9 &pattern06:0
map 10 &pattern18:0
map 11 &pattern14:0
map 12 &pattern04:0
map 13 &pattern05:0
map 14 &pattern03:0
map 15 &pattern23:0
map 16 &pattern16:0
map 17 &pattern21:0
map 18 &pattern01:0
map 19 &pattern02:0
map 20 &pattern24:0
map 21 &pattern19:0
map 22 &pattern17:0
map 23 &pattern20:0
map 24 &pattern22:0
mapEnd int
functionEnd int
function readPattern
; @pos -102 0
#impure
param int address
param int step
param int shift

push address
push step
push 4
mul
add
load
push shift
shiftRightUnsigned
push 255
and
functionEnd int
function mixByte
; @pos -102 19
param int startValue
param int endValue
param int balance

push startValue
push 255
push balance
sub
mul
push endValue
push balance
mul
add
push 8
shiftRightUnsigned
functionEnd int
function densityHit
; @pos -102 38
param int level
param int density

push level
push 255
push density
push 0
max
push 255
min
sub
greaterThan
functionEnd int
function readMap
; @pos -68 39
#impure
param int step
param int shift
param int x
param int y
local int cellX
local int cellY
local int balanceX
local int balanceY

push x
push 6
shiftRightUnsigned
localSet cellX

push y
push 6
shiftRightUnsigned
localSet cellY

push x
push 63
and
push 2
shiftLeft
localSet balanceX

push y
push 63
and
push 2
shiftLeft
localSet balanceY

push cellX
push cellY
call patternAddress
push step
push shift
call readPattern

push cellX
push 1
add
push cellY
call patternAddress
push step
push shift
call readPattern

push balanceX
call mixByte

push cellX
push cellY
push 1
add
call patternAddress
push step
push shift
call readPattern

push cellX
push 1
add
push cellY
push 1
add
call patternAddress
push step
push shift
call readPattern

push balanceX
call mixByte

push balanceY
call mixByte
functionEnd int
module sequencer
; @pos -34 0

int* trigger
int x 128
int y 128
int densityBD 128
int densitySD 128
int densityHH 128

int step
int nextStep
int previousTrigger
int levelBD
int levelSD
int levelHH
int bd
int sd
int hh

local int triggerHigh
local int mapX
local int mapY

push &bd
push 0
store
push &sd
push 0
store
push &hh
push 0
store

push *trigger
push 0
greaterThan
localSet triggerHigh

push triggerHigh
push previousTrigger
greaterThan
if
push &step
push nextStep
store

push x
push 0
max
push 255
min
localSet mapX
push y
push 0
max
push 255
min
localSet mapY

push &levelBD
push step
push 24
push mapX
push mapY
call readMap
store

push &levelSD
push step
push 16
push mapX
push mapY
call readMap
store

push &levelHH
push step
push 8
push mapX
push mapY
call readMap
store

push &bd
push levelBD
push densityBD
call densityHit
store

push &sd
push levelSD
push densitySD
call densityHit
store

push &hh
push levelHH
push densityHH
call densityHit
store

push &nextStep
push step
push 1
add
push 31
and
store
ifEnd

push &previousTrigger
push triggerHigh
store
moduleEnd
