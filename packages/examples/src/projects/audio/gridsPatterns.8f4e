8f4e/v1

includes
; @pos -64 13
include std/events/risingEdge
includesEnd

function buffer
; @pos -61 0
; Runs one cycle for each
; sample in the buffer.
#export buffer
use env

loop AUDIO_BUFFER_SIZE
call main
loopEnd
functionEnd

constants env
; @pos 0 -25
; Auto-generated environment constants
; Changes will be overwritten

const SAMPLE_RATE 48000
const AUDIO_BUFFER_SIZE 128

; Binary asset sizes in bytes
; '808-kick-48khz-s16le.pcm'
const ASSET_KICK_SIZE 29410
; '808-snare-48khz-s16le.pcm'
const ASSET_SNARE_SIZE 19688
; '808-hihat-48khz-s16le.pcm'
const ASSET_HIHAT_SIZE 21500

constantsEnd

note
; @pos -156 -37
; @config export.fileName gridsPatterns
; @config audioRuntime.enabled true
; @config audioRuntime.sampleRate 48000
; @config audioRuntime.audioOutBufferLAddress audioout:buffer
; @config audioRuntime.audioOutBufferRAddress audioout:buffer
; @config bin.kick.url https://static.8f4e.com/assets/samples/808-kick-48khz-s16le.pcm
; @config bin.kick.memory kick:buffer
; @config bin.snare.url https://static.8f4e.com/assets/samples/808-snare-48khz-s16le.pcm
; @config bin.snare.memory snare:buffer
; @config bin.hihat.url https://static.8f4e.com/assets/samples/808-hihat-48khz-s16le.pcm
; @config bin.hihat.memory hiHat:buffer

noteEnd

entry main
module clock
; @pos -9 -2
use env

const STEPS_PER_BEAT 8
int bpm 120
; @slider &bpm 40 240 1
int phase
int out
; @watch out

push &out
push 0
store

push &phase
push phase
push bpm
push STEPS_PER_BEAT
mul
add
store

push phase
push SAMPLE_RATE
push 60
mul
greaterOrEqual
if
push &phase
push phase
push SAMPLE_RATE
push 60
mul
sub
store

push &out
push 1
store
ifEnd
moduleEnd
group grids
; @pos 33 -2
; @home
expose trigger &sequencer:trigger
init &trigger &clock:out

expose bd &outputs:bd
expose sd &outputs:sd
expose hh &outputs:hh

expose bank &mapReader:bank
; @slider &bank 0 5 1
; @watch bank
; 0 Original    3 Jazz/Latin
; 1 Club        4 Electronic
; 2 Groove      5 Breakbeat

expose x &mapReader:x
; @slider &x 0 255 1
expose y &mapReader:y
; @slider &y 0 255 1
expose densityBD &outputs:densityBD
; @slider &densityBD 0 255 1
expose densitySD &outputs:densitySD
; @slider &densitySD 0 255 1
expose densityHH &outputs:densityHH
; @slider &densityHH 0 255 1

expose accentBD &outputs:accentBD
expose accentSD &outputs:accentSD
expose accentHH &outputs:accentHH


includes
; @pos -244 0
include std/events/risingEdge
includesEnd
function mapBalance
; @pos -286 0
; Converts a coordinate
; to a cell blend weight.
param int coordinate

push coordinate
push 63
and
push 2
shiftLeft
functionEnd int
function accentHit
; @pos -286 14
; Flags hits whose level
; is greater than 192.
param int hit
param int level

push hit
push level
push 192
greaterThan
and
functionEnd int
function selectRows
; @pos -286 29
; Resolves four corners in the
; selected bank's lookup table.
#impure
param int** bankPointer
param int x
param int y
param int step
param int** rowA
param int** rowB
param int** rowC
param int** rowD
local int** cell
local int stepOffset

; A table index is X * 5 + Y.
push x
shiftRightUnsigned 6
mul 5
push y
shiftRightUnsigned 6
add
mul 4
push bankPointer
add
localSet cell

push step
mul 4
localSet stepOffset

; Each entry points to a pattern.
; X advances five entries, Y one.
push rowA
push cell
load
add stepOffset
store

push rowB
push cell
add 5*4
load
add stepOffset
store

push rowC
push cell
add 4
load
add stepOffset
store

push rowD
push cell
add 6*4
load
add stepOffset
store
functionEnd
function readPattern
; @pos -244 6
; Reads one drum channel
; from a packed step row.
#impure
param int* row
param int shift

push row
load
push shift
shiftRightUnsigned
push 255
and
functionEnd int
function mixByte
; @pos -243 23
; Blends two byte values
; using integer weights.
param int startValue
param int endValue
param int balance

push startValue
push 255
push balance
sub
mul
push endValue
push balance
mul
add
push 8
shiftRightUnsigned
functionEnd int
function densityHit
; @pos -243 45
; Tests whether a level
; passes a density limit.
param int level
param int density

push level
push 255
push density
sub
greaterThan
functionEnd int
function readMap
; @pos -243 60
; Blends one drum channel
; from four pattern rows.
#impure
param int* rowA
param int* rowB
param int* rowC
param int* rowD
param int shift
param int balanceX
param int balanceY

push rowA
push shift
call readPattern

push rowB
push shift
call readPattern

push balanceX
call mixByte

push rowC
push shift
call readPattern

push rowD
push shift
call readPattern

push balanceX
call mixByte

push balanceY
call mixByte
functionEnd int
note attribution
