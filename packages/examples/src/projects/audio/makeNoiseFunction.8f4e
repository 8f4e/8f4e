module curve
; @pos 228 14
; Shape the signed slew increment.
float* response
float& distance &distance:out
float& riseRate &timeControl:riseRate
float& fallRate &timeControl:fallRate
float out
local float rate

push *distance
push 0.0
greaterThan
if
push *riseRate
else
push *fallRate
