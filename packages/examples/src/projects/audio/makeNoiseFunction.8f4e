module scope
; @pos 108 0
float& in &functionGenerator:out
float& inverse &functionGenerator:inverted
float& eor &functionGenerator:eor
float& eoc &functionGenerator:eoc
float[] signal 128
float[] inverted 128
float[] endOfRise 128
float[] endOfCycle 128
float* signalPointer &signal
float* invertedPointer &inverted
float* risePointer &endOfRise
float* cyclePointer &endOfCycle
