moduleEnd
module lfo1
; @pos 90 -27
; @group smearStage1
use env

float frequency 0.5
float phase
float out

push &out
call advancePhase
- &phase frequency
- SAMPLE_RATE
; Include another waveform
; to change the LFO shape.
call cosine

add 1.0
div 2.0

store

moduleEnd
module modulatedDelayTap
; @pos 127 -27
; @group smearStage1
; Reads a modulated,
; interpolated tap
; from a delay buffer
use cloudsReverb

float* buffer
- &allpassDiffuser:buffer
float** pointer
- &allpassDiffuser:pointer
float* mod &lfo1:out
float out

const MOD_BASE_OFFSET
- 10.0*CLOUDS_RATIO
const MOD_DEPTH
- 60.0*CLOUDS_RATIO

push &out
; pointer +
; int((10 + mod * 60) * ratio)
; * sizeof(*buffer)
push *pointer
push MOD_BASE_OFFSET
push *mod
mul MOD_DEPTH
add
castToInt
mul sizeof(*buffer)
add

; Circular buffer range
push buffer
push count(*buffer)

; fraction((10 + mod * 60) * ratio)
push MOD_BASE_OFFSET
push *mod
mul MOD_DEPTH
add
call fract

call readInterpolated
store

moduleEnd
module delayOffsetWriter
; @pos 171 -27
; @group smearStage1
; Writes an input sample into a
; shared delay buffer at a fixed
; offset from the current
; circular pointer.
use cloudsReverb

float* buffer
- &allpassDiffuser:buffer
float** pointer
- &allpassDiffuser:pointer
float* in &modulatedDelayTap:out

const WRITE_OFFSET_SAMPLES
- 100.0*CLOUDS_RATIO

push *pointer
push WRITE_OFFSET_SAMPLES
castToInt
mul sizeof(*buffer)
add
call wrapPointer
- buffer count(*buffer)
push *in
store

moduleEnd
module allpassDiffuser
; @pos 212 -27
; @group smearStage1
