module audiooutL
; @pos 831 -35
use env

float* in &tank1OutputMix:out

float[] buffer AUDIO_BUFFER_SIZE
float* pointer &buffer

; @wave2 &buffer count(buffer)

; Store the input value
; in the buffer
push pointer
push *in
store

; Increment the buffer
; pointer by the word size
push &pointer
push pointer
push sizeof(buffer)
add
store

; Reset the buffer pointer
; when it reaches the end
; of the buffer
push pointer
push buffer&
greaterThan
if
push &pointer
push &buffer
store
ifEnd

moduleEnd
