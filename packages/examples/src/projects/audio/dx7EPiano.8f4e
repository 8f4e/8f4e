moduleEnd
module dx7PitchRateScaling
; @pos 55 0
; Pitch-dependent DX7 speed offset.
int* note
int* amount &dx7Settings:rateScaling
int out

push &out
push *note
div 3
sub 7
max 0
min 31
mul *amount
shiftRight 3
store
moduleEnd
module dx7OutputLevel
; @pos 110 0
; Output-level offset for log targets.
int* in &dx7Settings:outputLevel
float out

push &out
call dx7Level *in
shiftLeft 5
sub 4256
castToFloat
store
moduleEnd
module envelope4Stage
; @pos 165 0
; Generic four-stage EG selector.
; Note-on starts 0; note-off selects 3.
; Reach 0, 1, 2, then hold stage 2.
int* trigger
int* release
float* value &envelopeRamp:out
float* target &dx7Target:out
int out 3

push *trigger
if
push &out
push 0
store
else
push *release
if
push &out
push 3
store
else
push *value
push *target
equal
push out
push 2
lessThan
and
if
push &out
push out
add 1
store
ifEnd
ifEnd
ifEnd
moduleEnd
module dx7Rate
; @pos 225 0
; Current raw rate to log step/sample.
use env
int* stage &envelope4Stage:out
int* rates &dx7Settings:rates
int* scaling &dx7PitchRateScaling:out
float out
local int qrate

call loadAt rates *stage
mul 41
shiftRight 6
add *scaling
min 63
localSet qrate
push &out
push qrate
and 3
add 4
castToFloat
push 1
push qrate
shiftRight 2
shiftLeft
castToFloat
mul
div 16384.0
mul 44100.0
push SAMPLE_RATE
castToFloat
div
store
moduleEnd
module dx7Target
; @pos 285 0
; Current raw level to log target.
int* stage &envelope4Stage:out
int* levels &dx7Settings:levels
float* offset &dx7OutputLevel:out
float out

push &out
call loadAt levels *stage
call dx7Level
shiftRight 1
shiftLeft 6
castToFloat
add *offset
max 16.0
store
moduleEnd
module dx7Curve
; @pos 345 0
; DX7 rising curve and attack jump.
; Falling segments use the base step.
float* in &envelopeRamp:out
float* target &dx7Target:out
float* rate &dx7Rate:out
float current
float step

push &current
push *in
store
push &step
push *rate
store
push *target
push *in
greaterThan
if
push &current
push *in
max 1716.0
min *target
store
push &step
push 4256.0
sub current
div 256.0
mul *rate
store
ifEnd
moduleEnd
module envelopeRamp
; @pos 405 0
; Generic ramp toward a target.
float* in &dx7Curve:current
float* target &dx7Target:out
float* step &dx7Curve:step
float out

push &out
call moveTowards *in *target *step
store
moduleEnd
module dx7Gain
; @pos 465 0
; Normalized log-to-linear amplitude.
float* in &envelopeRamp:out
float* offset &dx7OutputLevel:out
float out

push &out
push *in
push 16.0
greaterThan
if
push *in
push *offset
add 4032.0
sub
div 256.0
call exp2
else
push 0.0
ifEnd float
store
moduleEnd
