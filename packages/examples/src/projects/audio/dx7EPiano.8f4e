group noteInput
; @pos 153 22
; @home left
; Converts HID keycodes to MIDI note numbers              .---------.
; based on the Janko layout                               |  Enter  |
;                                                         |       | |
;.----------+---+---+---+---+---+---+---+---+---+---+---+-+-+  <--' |
;| CapsLock | C#| D#| F | G | A | B | C#| D#| F | G | A | B |       |
;+--------+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+---+-------+
;| Shift  | C | D | E | F#| G#| A#| C | D | E | F#| G#|    Shift    |
;'--------+---+---+---+---+---+---+---+---+---+---+---+-------------'
;
expose keyCode &janko:in
expose gate &noteEvents:gate
expose note &janko:out
expose noteOn &noteEvents:noteOn
expose noteOff &noteEvents:noteOff

init &keyCode &keyboard:keyCode
init &gate &keyboard:keyPressed

pass midiCodes

function jankoMap
; @pos -55 0
param int keycode
use midiCodes
push keycode
mapBegin int
map 53 C3  ; Maps HID
map 4  C#3 ; keycodes
map 29 D3  ; to MIDI note
map 22 D#3 ; numbers
map 27 E3  ; based on
map 7  F3  ; the Janko
map 6  F#3 ; piano layout
map 9  G3  ;
map 25 G#3 ; These key
map 10 A3  ; positions
map 5  A#3 ; are based on
map 11 B3  ; my Apple
map 17 C4  ; Magic
map 13 C#4 ; Keyboard's
map 16 D4  ; layout, feel
map 14 D#4 ; free to
map 54 E4  ; adjust them
map 15 F4  ; to your own.
map 55 F#4
map 51 G4
map 56 G#4
map 52 A4
map 49 B4
mapEnd int
functionEnd int
entry main
module janko
; @pos 0 0
; @home left
int* in ; Keycode
int out ; MIDI note number
push &out
push *in
call jankoMap

; @watch out
store
moduleEnd
module noteEvents
; @pos 55 0
; Keyboard note-on and note-off pulses.
int* gate
int* note &janko:out
int previousGate
int previousNote -1
int noteOn
int noteOff

push &noteOn
push *gate
push previousGate
equalToZero
push *note
push previousNote
notEqual
or
and
store
push &noteOff
push *gate
equalToZero
push previousGate
push 0
greaterThan
and
store
push &previousGate
push *gate
store
push &previousNote
push *note
store
moduleEnd
