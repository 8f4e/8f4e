module modulator2
; @pos 367 0
; @group operator2
use env
float* frequency &midiNote2Freq:out
float phase 0.0
float out
float ratio 14.0
float* amplitude &envelope2:out
float level 0.58

; @hide
; Advance and wrap without losing overshoot.
push &out
