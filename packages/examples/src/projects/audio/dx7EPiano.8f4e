function dx7Level
; @pos -65 0
; Exact raw DX7 level mapping for 0..99.
param int level

push level
mul 5
push level
mul 4
add 1
min
push level
mul 3
add 5
min
push level
mul 2
add 11
min
push level
mul 7
div 5
add 20
min
push level
add 28
min
functionEnd int
