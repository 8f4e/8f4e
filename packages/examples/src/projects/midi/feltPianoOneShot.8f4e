function onMidiEvent
; @pos -99 0
#export onMidiEvent
#impure
; MIDI note-on enqueues a note.
; Other MIDI messages are ignored.
; @config midi.inputs.keys.port 0
; @config midi.inputs.keys.callback onMidiEvent
use midiCodes
param int status
param int data1
param int data2

push status
and STATUS_MASK
push NOTE_ON
equal
push data2
notZero
and
if
call enqueueNote data1 data2
ifEnd
functionEnd

function enqueueNote
; @pos -42 0
#export
#impure
; Pack note and velocity into
; one queued word.
param int note
param int velocity

push &noteEventBuffer:writePointer
push &noteEventBuffer:events
push count(noteEventBuffer:events)
push note
push velocity
shiftLeft 16
or
call queuePush
functionEnd

