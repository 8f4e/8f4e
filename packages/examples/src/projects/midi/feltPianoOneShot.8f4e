module audioout
; @pos 123 0
; Write each frame and wrap at
; the end of the output buffer.
use env
float& in &feltPiano:out
float[] buffer AUDIO_BUFFER_SIZE
int pointer &buffer
; @plot &buffer count(buffer)

push pointer
push *in
store

push &pointer
push pointer
add sizeof(buffer)
store

push pointer
push end(buffer)
