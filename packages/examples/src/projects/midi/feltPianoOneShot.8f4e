float& in12 &voice12:out
float& in13 &voice13:out
float& in14 &voice14:out
float& in15 &voice15:out
float& in16 &voice16:out

push &out
push *in1
add *in2
add *in3
add *in4
add *in5
add *in6
add *in7
add *in8
add *in9
add *in10
add *in11
add *in12
add *in13
add *in14
add *in15
add *in16
mul gain
max -1.0
min 1.0
store
