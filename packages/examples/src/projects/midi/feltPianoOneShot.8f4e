module allocateVoice
; @pos 119 87
; @home left
; Each trigger uses the next
; voice, replacing its old note.
; Pointers track each input of
; the voice most recently written.
use polyphony
int*& note &eventInputs:note
int*& velocity &eventInputs:velocity
int nextVoice
; @watch nextVoice
int* voiceTrigger &voice1:trigger
int* voiceNote &voice1:note
int* voiceVelocity &voice1:velocity

push nextVoice
push &voiceTrigger
push &voiceNote
push &voiceVelocity
call selectVoice
push voiceVelocity
push **velocity
store
push voiceNote
push **note
store
push voiceTrigger
push 1
store
push &nextVoice
push nextVoice
add 1
remainder VOICES
store
moduleEnd
