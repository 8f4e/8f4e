note feltPianoOneShot
; @pos -22 -59
; A sixteen-voice felt piano
; with one-shot sample playback.
; Each trigger selects the next
; voice in rotation. Samples play
; to their end unless replaced
; when that voice is reused.
; Releasing a key leaves its
; sample playing.
;
; The sampler takes note,
; velocity, and trigger inputs.
; A separate noteEventBuffer
; queues notes and publishes one
; trigger per audio frame.
; Call enqueueNote with note and
; velocity to queue a note.
; The MIDI callback only queues;
; main consumes events and renders.
; The FIFO holds 128 notes and
; drops new arrivals when full.
; feltPiano contains the sampler,
; mapper, settings, and PCM banks.
; Its inner sampler receives
; mapSample via pass.
; Mapper contract: (velocity,
; note) -> (sample byte address,
; mono frame count).
;
; Three velocity banks contain
; 264 recordings: 1-42 piano,
; 43-84 mezzo, 85-127 forte.
; Use notes 21-108 and
; velocities 1-127.
; Mono signed 16-bit LE PCM,
; 48 kHz, about 151 MiB in memory.
; Wait for all three sample
; assets to finish loading.
;
; @config audioRuntime.enabled true
; @config audioRuntime.sampleRate 48000
; @config audioRuntime.audioOutBufferLAddress audioout:buffer
; @config audioRuntime.audioOutBufferRAddress audioout:buffer
; @config export.fileName feltPianoOneShot
noteEnd

entry main
module noteEventBuffer
; @pos 25 0
; @home left
; Publish one queued note per
; frame as note, velocity, trigger.
; Zero marks an empty slot.
; Only this consumer moves
; readPointer. Free the slot after
; copying its packed event.
int[] events 128
int* readPointer &events
int* writePointer &events
int trigger ; @watch
int note ; @watch
int velocity ; @watch
local int event

call queuePop 
- &readPointer &events count(events)
localSet event
push &trigger
push event
notZero
store
push event
if
push &note
push event
and 0xffff
store
push &velocity
push event
shiftRightUnsigned 16
store
ifEnd
moduleEnd
group feltPiano
; @pos 72 0
; Felt piano instrument: sampler,
; sample mapping, and PCM banks.
expose trigger &oneShotSampler:trigger
expose note &oneShotSampler:note
expose velocity &oneShotSampler:velocity
expose out &oneShotSampler:out
init &trigger &noteEventBuffer:trigger
init &note &noteEventBuffer:note
init &velocity &noteEventBuffer:velocity
pass env

