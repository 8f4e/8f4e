entry main
module inputs
; @pos 0 0
; Public voice inputs.
; Set on or off to 1 to send an
; event; clear the opposite flag.
; Velocity is separate, from 1-127.
; Note is a chromatic note number.
; @home left
int on
int off
int note 60
int velocity 127
moduleEnd
module sampleSelector
; @pos 50 0
; Map note and velocity to a
; sample address and frame count.
; Keep the selection until the
; next trigger.
int& note &inputs:note
int& velocity &inputs:velocity
int& trigger &inputs:on
; -1 means no sample selected.
int16* sampleAddress -1
int sampleLength
local int length

push *trigger
if
push &sampleAddress
call mapSample *velocity *note
localSet length
store
push &sampleLength
push length
store
ifEnd
moduleEnd
module envelope
; @pos 100 0
; Note-on resets gain immediately.
; Note-off releases over
; RELEASE_SECONDS.
use env
use pianoSettings
int& trigger &inputs:on
int& release &inputs:off
int& velocity &inputs:velocity
float level
float velocityGain
float out
int finished
int releasing

push *trigger
if
push &level
push 1.0
store
push &velocityGain
push *velocity
castToFloat
div 127.0
store
push &releasing
push 0
store
ifEnd
push *release
if
push &releasing
push 1
store
ifEnd

push &out
push level
mul velocityGain
store
push &finished
push out
push 0.0
equal
store
push releasing
if
push &level
push level
push 1.0
div RELEASE_SECONDS
push SAMPLE_RATE
castToFloat
div
sub
max 0.0
store
ifEnd
moduleEnd
module player
; @pos 150 0
; Play mono PCM from a byte
; address and frame count.
; Start immediately replaces
; playback from frame zero.
; Stop ends playback immediately.
; Read one sample per output frame
; at 48 kHz.
int16** address &sampleSelector:sampleAddress
int& length &sampleSelector:sampleLength
int& start &inputs:on
int& stop &envelope:finished
int position
int active
float out

push *start
if
push &active
push *length
push 0
greaterThan
store
push &position
push 0
store
ifEnd

push &out
push 0.0
store
push *stop
if
push &active
push 0
store
ifEnd
push active
if
push position
push *length
lessThan
if
push &out
push *address
push position
mul 2
add
load16s
castToFloat
div 32768.0
store
push &position
push position
add 1
store
else
push &active
push 0
store
ifEnd
ifEnd
moduleEnd
module amplifier
; @pos 200 0
; Apply the separate envelope to
; the PCM output.
float& in &player:out
float& gain &envelope:out
float out

push &out
push *in
mul *gain
store
moduleEnd
module consumeEvents
; @pos 250 0
; Clear events after all voice
; modules have consumed them.
push &inputs:on
push 0
store
push &inputs:off
push 0
store
moduleEnd
entryEnd
templateEnd
