entry samples
module sampleBuffers
; @pos 22 53
; Three mono velocity banks,
; concatenated PCM at 48 kHz,
; signed 16-bit little-endian.
; Each holds MIDI notes 21-108.
use env
int16[] piano ASSET_PIANO_SIZE/2
; @wave2 &piano count(piano)
; @config bin.piano.path piano-48khz-16s.pcm
; @config bin.piano.memory sampleBuffers:piano
int16[] mezzo ASSET_MEZZO_SIZE/2
; @wave2 &mezzo count(mezzo)
; @config bin.mezzo.path mezzo-48khz-16s.pcm
; @config bin.mezzo.memory sampleBuffers:mezzo
int16[] forte ASSET_FORTE_SIZE/2
; @wave2 &forte count(forte)
; @config bin.forte.path forte-48khz-16s.pcm
; @config bin.forte.memory sampleBuffers:forte
moduleEnd
entryEnd
entry sampler
group pianoSampler
; @pos 60 0
; Sixteen voices, note allocation,
; envelopes, and mixing.
expose on &eventInputs:on
expose off &eventInputs:off
expose allOff &eventInputs:allOff
expose note &eventInputs:note
expose velocity &eventInputs:velocity
expose out &voiceMixer:out
init &on &midiInput:on
init &off &midiInput:off
init &allOff &midiInput:allOff
init &note &midiInput:note
init &velocity &midiInput:velocity
pass env
pass pianoSettings
pass mapSample
useTemplate pianoSampler
groupEnd
entryEnd
entry samples
