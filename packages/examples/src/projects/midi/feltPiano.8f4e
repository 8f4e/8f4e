module dispatch
; @pos 350 0
; Route and consume control events,
; otherwise render one audio frame.
int** on &eventInputs:on
int** off &eventInputs:off
int** allOff &eventInputs:allOff

push **on
or **off
or **allOff
if
call events
push *on
push 0
store
push *off
push 0
store
push *allOff
push 0
store
else
call audio
ifEnd
moduleEnd
entryEnd
entry audio
module voiceMixer
; @pos 360 80
; Sum all voices with adjustable
; output headroom.
float gain 0.25
; @slider &gain 0 1 0.01
float out
float& in1 &voice1:out
float& in2 &voice2:out
float& in3 &voice3:out
float& in4 &voice4:out
float& in5 &voice5:out
float& in6 &voice6:out
float& in7 &voice7:out
float& in8 &voice8:out
float& in9 &voice9:out
float& in10 &voice10:out
float& in11 &voice11:out
float& in12 &voice12:out
float& in13 &voice13:out
float& in14 &voice14:out
float& in15 &voice15:out
float& in16 &voice16:out

push &out
push *in1
add *in2
add *in3
add *in4
add *in5
add *in6
add *in7
add *in8
add *in9
add *in10
add *in11
add *in12
add *in13
add *in14
add *in15
add *in16
mul gain
max -1.0
min 1.0
store
moduleEnd
