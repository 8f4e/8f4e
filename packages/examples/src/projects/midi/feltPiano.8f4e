function mapSample
; @pos 100 -100
#export
#impure
; Return a byte address and mono
; frame count.
; Zero length denotes an
; unsupported note/velocity.
use pianoSettings
param int velocity
param int note
local int index

push note
push FIRST_NOTE
greaterOrEqual
push note
push LAST_NOTE
lessOrEqual
and
push velocity
push 0
greaterThan
and
push velocity
push 127
lessOrEqual
and
if
push velocity
push SOFT_MAX
greaterThan
push velocity
push MEDIUM_MAX
greaterThan
add
mul NOTES_PER_LAYER
push note
sub FIRST_NOTE
add
localSet index

push index
div NOTES_PER_LAYER
mapBegin int
map 0 &sampleBuffers:piano
map 1 &sampleBuffers:mezzo
map 2 &sampleBuffers:forte
mapEnd int
push &sampleMap:offsets
push index
mul 4
add
load
add
push &sampleMap:frames
push index
mul 4
add
load
else
push 0
push 0
ifEnd int int
functionEnd int int

function buffer
; @pos 150 -100
#export
use env
loop AUDIO_BUFFER_SIZE
call main
loopEnd
functionEnd

function onMidiEvent
; @pos 250 -100
#export onMidiEvent
#impure
; Translate MIDI into generic
; note events outside the sampler.
use midiCodes
param int status
param int data1
param int data2
local int kind

push status
and STATUS_MASK
localSet kind
push &midiInput:on
push kind
push NOTE_ON
equal
push data2
push 0
greaterThan
and
store
push &midiInput:off
push kind
push NOTE_OFF
equal
push kind
push NOTE_ON
equal
push data2
equalToZero
and
or
store
push &midiInput:allOff
push kind
push CONTROL_CHANGE
equal
push data1
push ALL_NOTES_OFF
equal
and
store
push &midiInput:note
push data1
and DATA_MASK
store
push &midiInput:velocity
push data2
and DATA_MASK
store

push &midiInput:on
load
push &midiInput:off
load
or
push &midiInput:allOff
load
or
if
call sampler
ifEnd
functionEnd

constants env
; @pos -74 -44
; Auto-generated environment constants
; Changes will be overwritten

const SAMPLE_RATE 48000
const AUDIO_BUFFER_SIZE 128

; Binary asset sizes in bytes
; 'piano-48khz-16s.pcm'
const ASSET_PIANO_SIZE 55301318
; 'mezzo-48khz-16s.pcm'
const ASSET_MEZZO_SIZE 47498866
; 'forte-48khz-16s.pcm'
const ASSET_FORTE_SIZE 55096884

constantsEnd

constants pianoSettings
; @pos 50 -100
const FIRST_NOTE 21
const LAST_NOTE 108
const NOTES_PER_LAYER 88
const SOFT_MAX 42
const MEDIUM_MAX 84
const RELEASE_SECONDS 0.1
constantsEnd

constants midiCodes
; @pos 300 -100
const STATUS_MASK 0xf0
const DATA_MASK 0x7f
const NOTE_OFF 0x80
const NOTE_ON 0x90
const CONTROL_CHANGE 0xb0
const ALL_NOTES_OFF 123
constantsEnd

note credits
; @pos -31 88
; Original recordings: Tom Guder.
; Fuchs & Moehr Felt Piano, public domain.
; https://www.polyphone.io/en/forum/your-creations/850-acoustic-felt-piano-upright-fuchs-mohr
noteEnd

note feltPiano
; @pos 0 -100
; A sixteen-voice felt piano
; using 264 mono recordings in
; three concatenated PCM files
; from Tom Guder's Fuchs & Moehr
; upright.
; Play MIDI input port 0.
; CC123 releases all notes.
; All three velocity layers load
; into shared memory
; once: 157897068 bytes (about
; 151 MiB).
; Wait for the asset loading
; indicators to finish.
;
; pianoSampler receives mapSample
; and settings via pass.
; Contract: (velocity, MIDI
; note) ->
; (sample byte address, mono
; frame count).
; Velocities 1-42 select piano,
; 43-84 mezzo,
; and 85-127 forte. Notes
; outside 21-108 are ignored.
; Files are 48 kHz signed 16-bit
; little-endian PCM.
; Filenames include -48khz-16s;
; original tuning remains.
; Source recordings released as
; public domain:

;
; @config bin.baseUrl https://static.8f4e.com/assets/samples/piano/
; @config audioRuntime.enabled true
; @config audioRuntime.sampleRate 48000
; @config audioRuntime.audioOutBufferLAddress audioout:buffer
; @config audioRuntime.audioOutBufferRAddress audioout:buffer
; @config export.fileName feltPiano
noteEnd

