module mixer
; @pos 556 36

use preset

float* in1 &carrier1:out
float* in2 &carrier3:out
float* in3 &carrier5:out
float out

push &out
push *in1
mul MIX1_GAIN
push *in2
mul MIX3_GAIN
add
push *in3
mul MIX5_GAIN
add
; Headroom for three attack peaks.
mul OUTPUT_GAIN
store

