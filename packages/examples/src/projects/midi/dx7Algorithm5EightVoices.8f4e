int sensitivity PITCH_MOD_SENSITIVITY
float out 1.0
; @hide
push &out
push sensitivity
max 0
min 7
mapBegin int
map 0 0
map 1 10
map 2 20
map 3 33
map 4 55
map 5 92
map 6 153
map 7 255
mapEnd int
push depth
mul 165
shiftRight 6
mul
castToFloat
div 32768.0
push *lfo
sub 0.5
mul
mul *delay
add *envelope
call exp2
store
moduleEnd
module amplitudeModulation
; @pos 275 0
; Delayed LFO attenuation in octaves.
; Approximate measured AMD curve from Hexter:
; exp(AMD * .0428993 - .285189) / 8.
use preset
float* lfo &lfo:out
float* delay &lfo:delayGain
int depth LFO_AMPLITUDE_DEPTH
float out
; @hide
push &out
push depth
if
push depth
castToFloat
mul 0.061890610762
sub 0.411440761959
call exp2
div 8.0
push 1.0
sub *lfo
mul
mul *delay
else
push 0.0
ifEnd float
store
moduleEnd
entryEnd
groupEnd
