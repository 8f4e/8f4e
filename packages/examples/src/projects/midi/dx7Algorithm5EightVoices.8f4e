note
; @pos 2 41
; @config audioRuntime.enabled true
; @config audioRuntime.sampleRate 48000
; @config audioRuntime.audioOutBufferLAddress audioout:buffer
; @config audioRuntime.audioOutBufferRAddress audioout:buffer
; @config export.fileName dx7Algorithm5EightVoices

noteEnd

note colors
; @pos 2 51
; @config color.canvas #151210
; @config color.surface #25211e
; @config color.ink #e5e1d8
; @config color.primary #64d1ad
; @config color.secondary #c7df8a
; @config color.positive #64d1ad
; @config color.warning #d9c66f
; @config color.negative #d66b5f
; @config color.muted #898178
; @config color.stroke rgba(100,209,173,0.24)
; @config color.tertiary #aaa195
; @config color.highlight #c7df8a
; @config color.detail #64d1ad
noteEnd

note eightVoices
; @pos 188 30
; Play chords from MIDI input port 0 (all channels).
; Note-ons cycle through voices 1 to 8.
; The ninth note steals voice 1; note-offs release
; only matching pitches on the same MIDI channel.
; Velocity and CC64 sustain pedal are supported.
; Move a preset furthest right to update all voices.
noteEnd

entry midi
module midiInput
; @pos 130 9
; @home left
; MIDI input port 0, all channels.
; @config midi.inputs.keys.port 0
; @config midi.inputs.keys.callback onMidiEvent
int status ; @watch
int note ; @watch
int velocity ; @watch
moduleEnd
module midiToFrequency
; @pos 191 3
int* status &midiInput:status
int* note &midiInput:note
int* velocity &midiInput:velocity
float out

call isNoteOn *status *velocity
if
push &out
push *note
sub 69
castToFloat
div 12.0
call exp2
mul 440.0
store
ifEnd
moduleEnd
group roundRobin
; @pos 260 10
; Allocate through the supplied voice mapper.
expose status &midiMessage:status
expose note &midiMessage:note
expose velocity &midiMessage:velocity
expose frequency &noteOn:frequency
; Live destination wires.
expose frequencyTarget &noteOn:frequencyTarget
expose noteOnTarget &noteOn:eventTarget
expose noteOffTarget &noteOff:eventTarget

init &status &midiInput:status
init &note &midiInput:note
init &velocity &midiInput:velocity
init &frequency &midiToFrequency:out

pass midiCodes
pass polyphony
pass isNoteOn
pass voiceDestination
includes
; @pos 0 -12
include std/memory/loadAt
include std/memory/storeAt
includesEnd
function isNoteOff
; @pos 0 -40
use midiCodes
param int status
param int velocity
local int kind

push status
and STATUS_MASK
localSet kind
push kind
push NOTE_OFF
equal
push kind
push NOTE_ON
equal
push velocity
equalToZero
and
or
functionEnd int
function isController
; @pos 65 -40
use midiCodes
param int status
param int note
param int controller

push status
and STATUS_MASK
push CONTROL_CHANGE
equal
push note
push controller
equal
and
functionEnd int
function matchesChannel
; @pos 130 -40
use midiCodes
param int key
param int channel

push key
push 0
greaterThan
push key
sub 1
shiftRight NOTE_BITS
push channel
equal
and
functionEnd int
function encodeNoteEvent
; @pos 195 -40
; Low byte: gate and velocity; upper bits: counter.
param int previous
param int velocity

push previous
add 256
and 0x7fffff00
push velocity
push 0
greaterThan
mul 128
or velocity
or
functionEnd int
entry main
module midiMessage
; @pos 0 0
; Decode the current MIDI message.
; @home left
use midiCodes
int* status
int* note
int* velocity
int channel
int key
int value
int noteOn
int noteOff
int sustain
int allNotesOff

push &channel
push *status
and CHANNEL_MASK
store
; Zero means an unassigned voice; MIDI keys start at 1.
push &key
push channel
shiftLeft NOTE_BITS
or *note
add 1
store
push &value
push *velocity
store
push &noteOn
call isNoteOn *status value
store
push &noteOff
call isNoteOff *status value
store
push &sustain
call isController *status *note SUSTAIN_PEDAL
store
push &allNotesOff
call isController *status *note ALL_NOTES_OFF
store
moduleEnd
module voiceState
; @pos 65 0
; Note ownership scales with the configured voice count.
use polyphony
int[] keys VOICES
int[] held VOICES
moduleEnd
module noteOn
; @pos 130 0
; Select and instruct the next voice.
use polyphony
int* trigger &midiMessage:noteOn
int* key &midiMessage:key
int* velocity &midiMessage:value
float* frequency
int* keys &voiceState:keys
int* held &voiceState:held
int nextVoice
float* frequencyTarget
int* eventTarget
local int frequencyAddress
local int eventAddress
; @watch nextVoice

push *trigger
if
call voiceDestination nextVoice
localSet eventAddress
localSet frequencyAddress
push &frequencyTarget
push frequencyAddress
store
push &eventTarget
push eventAddress
store
call storeAt keys nextVoice *key
call storeAt held nextVoice 1
push frequencyTarget
push *frequency
store
; Publish after the destination frequency is stored.
push eventTarget
call encodeNoteEvent *eventTarget *velocity
store
push &nextVoice
push nextVoice
add 1
remainder VOICES
store
ifEnd
moduleEnd
module sustain
; @pos 195 0
; Track CC64 separately for each channel.
use midiCodes
int* update &midiMessage:sustain
int* channel &midiMessage:channel
int* value &midiMessage:value
int[] pedals CHANNEL_COUNT

push *update
if
push &pedals
push *channel
mul sizeof(pedals)
add
push *value
push PEDAL_DOWN
greaterOrEqual
store
ifEnd
moduleEnd
module noteOff
; @pos 260 0
; Release matching notes once their pedal is up.
use polyphony
int* noteOn &midiMessage:noteOn
int* noteOff &midiMessage:noteOff
int* allNotesOff &midiMessage:allNotesOff
int* channel &midiMessage:channel
int* key &midiMessage:key
int* keys &voiceState:keys
int* held &voiceState:held
int* pedals &sustain:pedals
int* eventTarget
local int index
local int voiceKey
local int eventAddress

push *noteOn
equalToZero
if
loop VOICES
loopIndex
localSet index
call loadAt keys index
localSet voiceKey
call matchesChannel voiceKey *channel
if
push voiceKey
push *key
equal
and *noteOff
or *allNotesOff
if
call storeAt held index 0
ifEnd
call loadAt held index
equalToZero
call loadAt pedals *channel
equalToZero
and
if
call voiceDestination index
localSet eventAddress
drop
push &eventTarget
push eventAddress
store
push eventTarget
call encodeNoteEvent *eventTarget 0
store
call storeAt keys index 0
ifEnd
ifEnd
loopEnd
ifEnd
moduleEnd
entryEnd
groupEnd
entryEnd
entry main
group voice1
; @pos 330 0
expose frequency &voiceInput:frequency
expose event &noteEvents:in
expose out &limiter:out

pass env
pass preset

