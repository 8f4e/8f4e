useTemplate dx7Voice
groupEnd
module voiceMixer
; @pos 437 11
; Eight voices, with headroom
; for overlapping tails.
use polyphony
float* in1 &voice1:out
float* in2 &voice2:out
float* in3 &voice3:out
float* in4 &voice4:out
float* in5 &voice5:out
float* in6 &voice6:out
float* in7 &voice7:out
float* in8 &voice8:out
float out

push &out
push *in1
add *in2
add *in3
add *in4
add *in5
add *in6
add *in7
add *in8
mul 3.0/VOICES
store
moduleEnd
module audioout
; @pos 477 11
use env

float* in &voiceMixer:out

; Audio buffer
float[] buffer AUDIO_BUFFER_SIZE
int pointer &buffer

; @plot &buffer count(buffer)

; Store the input value
; in the buffer
push pointer
push *in
store

; Increment the buffer
; pointer by the
; buffer word size
push &pointer
push pointer
add sizeof(buffer)
store

; Reset the buffer pointer
; when it reaches the end
; of the buffer
push pointer
push end(buffer)
greaterOrEqual
if
push &pointer
push &buffer
store
ifEnd

moduleEnd
entryEnd