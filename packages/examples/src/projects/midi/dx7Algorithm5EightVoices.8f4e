function buffer
; @pos 2 72
#export buffer
use env

loop AUDIO_BUFFER_SIZE
call main
loopEnd
functionEnd

function isNoteOn
; @pos 113 71
use midiCodes
param int status
param int velocity

push status
and STATUS_MASK
push NOTE_ON
equal
push velocity
push 0
greaterThan
and
functionEnd int

function onMidiEvent
; @pos 139 -16
#export onMidiEvent
#impure
use midiCodes
param int status
param int data1
param int data2

push &midiInput:status
push status
store
push &midiInput:note
push data1
and DATA_MASK
store
push &midiInput:velocity
push data2
and DATA_MASK
store
call midi
functionEnd

function voiceDestination
; @pos 349 50
#impure
; The public voice inputs 
; are mapped here.
param int voice

push voice
mapBegin int
map 0 &voice1:frequency
map 1 &voice2:frequency
map 2 &voice3:frequency
map 3 &voice4:frequency
map 4 &voice5:frequency
map 5 &voice6:frequency
map 6 &voice7:frequency
map 7 &voice8:frequency
mapEnd int
push voice
mapBegin int
map 0 &voice1:event
map 1 &voice2:event
map 2 &voice3:event
map 3 &voice4:event
map 4 &voice5:event
map 5 &voice6:event
map 6 &voice7:event
map 7 &voice8:event
mapEnd int
functionEnd int int

