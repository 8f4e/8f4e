module modulator2
; @pos 382 0
; @group operator2
use env
use preset
float* frequency &voiceInput:latchedFrequency
float* pitchRatio &modulation:pitchRatio
int* reset &voiceInput:reset
float phase 0.0
float out
float ratio OP2_RATIO
float fixedHz OP2_FIXED_HZ
float* amplitude &envelope2:out
float level OP2_GAIN

; @hide
; Reset before advancing this sample.
push *reset
if
push &phase
push 0.0
store
ifEnd

; Advance and wrap without losing overshoot.
push &out
push &phase
push *frequency
mul ratio
mul *pitchRatio
add fixedHz
push SAMPLE_RATE
call advanceDx7Phase
; You can swap this call
; with any periodic function
call sine
mul *amplitude
mul level
store

moduleEnd
