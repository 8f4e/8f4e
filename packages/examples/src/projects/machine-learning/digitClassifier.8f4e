8f4e/v1

function sigmoid
; @pos -355 38
param float x
; Fast sigmoid approximation
; of logistic sigmoid
; mapped to [0, 1]

push x
push x
abs
push 1.0
add
ensureNonZero
div
push 0.5
mul
push 0.5
add

functionEnd float

constants env
; @pos 0 0
; @favorite
; Auto-generated environment constants
; Changes will be overwritten

const SAMPLE_RATE 50

constantsEnd

note
; @pos -438 18
; @config export.fileName digitClassifierFloat32
; @config color.canvas #d9dee9
; @config color.surface #f6f5fa
; @config color.ink #35405c
; @config color.primary #4c60b4
; @config color.secondary #bd5871
; @config color.positive #78a68a
; @config color.warning #d6a748
; @config color.negative #cf5c68
; @config color.muted #8b93a8
; @config color.stroke rgba(69,89,160,0.38)
; @config color.tertiary #7e8799
; @config color.highlight #efb74d
; @config color.detail #697ac6
noteEnd

note
; @pos -310 -8

; This project runs a feedforward neural network
; in inference mode to classify hand-drawn digits.

; 32-bit floats; weights and biases rounded to
; six decimal places.

; A 3x5 binary drawinggrid is mapped into 15 inputs,
; then processed through sigmoid-based layers
; where each neuron has a fan-in of 4.

; Each neuron exposes its fixed-weight multiplies,
; sums, biases, sigmoid activation, and connections.

; @config runtime WebWorkerRuntime
noteEnd

note
; @pos -310 11

; Draw the symbols
; you want to input into
; the neural network
; with 1s
;                   .
;            .......;;.
;            :::::::;;;;.
;            :::::::;;:'
;                   ;'
;
noteEnd

note
; @pos -310 27

; Here you can read
; the confidence score
; of each digit the
; network can recognise
;                   .
;            .......;;.
;            :::::::;;;;.
;            :::::::;;:'
;                   :'
noteEnd

entry main
module grid
; @pos -274 11
; @home

int row0 0b111
int row1 0b100
int row2 0b111
int row3 0b101
int row4 0b111

moduleEnd
module outputs
; @pos -274 28

; Confidence scores:
; @w *confidence0
; @w *confidence1
; @w *confidence2
; @w *confidence3
; @w *confidence4
; @w *confidence5
; @w *confidence6
; @w *confidence7
; @w *confidence8
; @w *confidence9

; Routing the values of the output
; neurons here into this module
float* confidence0 &neuron108:out
float* confidence1 &neuron109:out
float* confidence2 &neuron110:out
float* confidence3 &neuron111:out
float* confidence4 &neuron112:out
float* confidence5 &neuron113:out
