8f4e/v1

function sigmoid
; @pos -355 38
param float64 x
; Fast sigmoid approximation
; of logistic sigmoid
; mapped to [0, 1]

push x
push x
abs
push 1.0f64
add
ensureNonZero
div
push 0.5f64
mul
push 0.5f64
add

functionEnd float64

constants env
; @pos 0 0
; @favorite
; Auto-generated environment constants
; Changes will be overwritten

const SAMPLE_RATE 50

constantsEnd

note
; @pos -438 18
; @config color.canvas #330011
; @config color.primary #ff0
; @config color.secondary #333
; @config color.tertiary #666666
; @config color.highlight rgba(255,255,255,0.45)
; @config color.detail #ffffff
; @config color.stroke rgba(255,255,255,0.3)
; @config export.fileName digitClassifier
noteEnd

note
; @pos -310 -8

; This project runs a feedforward neural network
; in inference mode to classify hand-drawn digits.

; A 3x5 binary drawinggrid is mapped into 15 inputs,
; then processed through sigmoid-based layers
; where each neuron has a fan-in of 4.

; Instead of tensor-style layer operations,
; the network is written out neuron by neuron
; so the fixed-weight multiplies, sums, biases,
; sigmoid activations, and connections remain
; visible in the editor.

; @config workerRuntime.enabled true
noteEnd

note
; @pos -310 11

; Draw the symbols
; you want to input into
; the neural network
; with 1s
;                   .
;            .......;;.
;            :::::::;;;;.
;            :::::::;;:'
;                   ;'
;
noteEnd

note
; @pos -310 27

; Here you can read
; the confidence score
; of each digit the
; network can recognise
;                   .
;            .......;;.
;            :::::::;;;;.
;            :::::::;;:'
;                   :'
noteEnd

entry main
module grid
; @pos -274 11
; @home

int row0 0b111
int row1 0b100
int row2 0b111
int row3 0b101
int row4 0b111

moduleEnd
module outputs
; @pos -274 28

; Confidence scores:
; @w *confidence0
; @w *confidence1
; @w *confidence2
; @w *confidence3
; @w *confidence4
; @w *confidence5
; @w *confidence6
; @w *confidence7
; @w *confidence8
; @w *confidence9

; Routing the values of the output
; neurons here into this module
float64* confidence0 &neuron108:out
float64* confidence1 &neuron109:out
float64* confidence2 &neuron110:out
float64* confidence3 &neuron111:out
float64* confidence4 &neuron112:out
float64* confidence5 &neuron113:out
float64* confidence6 &neuron114:out
float64* confidence7 &neuron115:out
float64* confidence8 &neuron116:out
float64* confidence9 &neuron117:out

moduleEnd
