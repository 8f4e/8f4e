module scope
; @pos 147 18

int* in &norGate:out
int[] buffer 64
int bufferPointer &buffer

; @plot &buffer count(buffer) -1 2

push &bufferPointer
push bufferPointer
push sizeof(buffer)
add
store

push bufferPointer
push buffer&
greaterThan
if
push &bufferPointer
push &buffer
store
ifEnd

push bufferPointer
push *in
store

moduleEnd
