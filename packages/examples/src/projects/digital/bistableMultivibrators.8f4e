module orGate
; @pos 264 6

                      ;   .---.
int* in1 &andGate:out ; --+    '
int out               ;   ) OR  |---
int* in2 &buttons:set ; --+    .
                      ;   '---'

push &out
push *in1
push *in2
add
push 1
greaterOrEqual
if
push 1
else
push 0
ifEnd int
store

moduleEnd
module andGate
; @pos 265 31

                     ;   .---.
int* in1 &orGate:out ; --+    '
int out              ;   | AND |---
int* in2 &negate:out ; --+    .
                     ;   '---'

push &out
push *in1
push *in2
mul
push 1
greaterOrEqual
if
push 1
else
push 0
ifEnd int
store

moduleEnd
