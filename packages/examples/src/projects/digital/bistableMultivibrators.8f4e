note
; @pos 45 4
; Demonstrates a bistable SR latch
; (multivibrator) built from feedback
; logic gates, with set/reset button
; inputs and scope buffers that
; visualize both latch state and
; derived gate output over time.
noteEnd

entry main
module resetButton
; @pos 50 30

int out
               ; Push this button
               ; to reset the state
; @button &out

moduleEnd
module setButton
; @pos 51 17
; @home left

int out
               ; Push this button
               ; to set the state
; @button &out  

moduleEnd
module norGate2
; @pos 95 8

                        ;   .---.
int* in1 &norGate:out   ; --+    '
int out                 ;   ) NOR |O---
int* in2 &setButton:out ; --+    .
                        ;   '---'
; @watch out

push &out
push *in1
push *in2
add
push 0
equal
if
push 1
else
push 0
ifEnd int
store

moduleEnd
module norGate
; @pos 95 34

                          ;   .---.
int* in1 &norGate2:out    ; --+    '
int out                   ;   ) NOR |O---
int* in2 &resetButton:out ; --+    .
                          ;   '---'
