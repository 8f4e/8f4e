note
; @pos 0 -18
; Camera -> renderer -> antialiasing -> screen.
; Video processors publish an RGB buffer and frame counter.
; Patch input to the previous stage's buffer, and
; inputFrame to its frame counter.
; Antialiasing takes 1024x1024 RGB and produces 512x512 RGB.
; Its amount blends one sample with the full filter.
; The screen accepts 512x512 RGB and publishes complete frames.
; Small stage previews show center crops; the screen shows all.
; Zoom, pan and detail control the Mandelbrot renderer.
; Black pixels have not escaped at the chosen iteration limit.
; The worker processes new frames while the editor stays live.
noteEnd

entry main
module camera
; @pos 9 0
use view

float zoom 1.05 ; @w
; @slider &zoom 0.0 20.0 0.05

float panX -0.01 ; @w
; @slider &panX -1.0 1.0 0.01

float panY 0.17 ; @w
; @slider &panY -1.0 1.0 0.01

int detail 512 ; @w
; @slider &detail 64 1024 64

float64 span 3.2f64
float64 centerX TARGET_X
float64 centerY TARGET_Y

; A zoom level halves the view span.
push &span
push zoom
mul -1.0
call exp2
castToFloat64
mul 3.2f64
store

push &centerX
push panX
castToFloat64
mul span
add TARGET_X
store
push &centerY
push panY
castToFloat64
mul span
add TARGET_Y
store
moduleEnd
module renderer
; @pos 55 0
use view

; Output: 1024x1024 RGB 
; and frame counter.
int frame ; @w
int8u[] samples SAMPLE_COUNT*3
; @textureUpload &samples rgb 1024 1024
; @texture &samples 1 256 256 384 384
float64& centerX &camera:centerX
float64& centerY &camera:centerY
float64& span &camera:span
int& detail &camera:detail

float64 lastX
float64 lastY
float64 lastSpan -1.0f64
int lastDetail

; Keep the image while 
; the view is still.
push *centerX
push lastX
equal
push *centerY
push lastY
equal
and
push *span
push lastSpan
equal
and
push *detail
push lastDetail
equal
and
exitIfTrue

; Snapshot the view before drawing.
; New detail changes will be picked
; up on the following worker tick.
push &lastX
push *centerX
store
push &lastY
push *centerY
store
push &lastSpan
push *span
store
push &lastDetail
push *detail
store

push &samples
call renderMandelbrotSamples 
- lastX lastY lastSpan lastDetail

; Publish a new frame only 
; after rendering.
push &frame
push frame
add 1
store
moduleEnd
module antialiasing
; @pos 104 0
use view

; Input: 1024x1024 RGB 
; and frame counter.
int8u* input &renderer:samples
int* inputFrame &renderer:frame

; 0: one sample. 1: full 2x2 AA.
float amount 1.0 ; @w
; @slider &amount 0.0 1.0 0.01

; Output: 512x512 RGB 
; and frame counter.
int frame ; @w
int8u[] out PIXEL_COUNT*3
; @textureUpload &out rgb 512 512
; @texture &out 1 256 256 128 128

int8u* lastInput
int lastFrame -1
float lastAmount -1.0
local int8u* source
local int incomingFrame
local float currentAmount

push input
localSet source
push *inputFrame
localSet incomingFrame
push amount
max 0.0
min 1.0
localSet currentAmount

; Process new frames and 
; repatched buffers.
push source
push lastInput
notEqual
call hasChanged
- incomingFrame &lastFrame
or
call hasChanged
- currentAmount &lastAmount
or
equalToZero
exitIfTrue

push &lastInput
push source
store

call downsampleRGB2x
- source &out WIDTH HEIGHT
- SAMPLE_ROW_BYTES WIDTH*3
- currentAmount

push &frame
push frame
add 1
store
moduleEnd
module screen
; @pos 146 0
; @home right
use view

; Input: 512x512 RGB and frame counter.
int8u* input &antialiasing:out
int* inputFrame &antialiasing:frame

int frame ; @w
int8u[] rgb PIXEL_COUNT*3
int8u[] spare PIXEL_COUNT*3
int8u* display &rgb
int8u* pixels &spare
; @textureUpload display rgb 512 512
; @texture display 1 512 512

int8u* lastInput
int lastFrame -1
local int8u* source
local int incomingFrame

push input
localSet source
push *inputFrame
localSet incomingFrame

push source
push lastInput
notEqual
call hasChanged
- incomingFrame &lastFrame
or
equalToZero
exitIfTrue

push &lastInput
push source
store

; Copy the completed input into the back buffer.
push pixels
push source
memoryCopy PIXEL_COUNT*3
call swapPointers &display &pixels

push &frame
push frame
add 1
store
moduleEnd
entryEnd