function mandelbrotStep
; @pos -220 45
param float64 real
param float64 imaginary
param float64 cx
param float64 cy

; One z = z*z + c step.
; Both components use the old z.
push real
mul real
push imaginary
mul imaginary
sub
add cx

push real
mul imaginary
mul 2.0f64
add cy
functionEnd float64 float64

function fractionalEscapeCount
; @pos -220 110
param int iterations
param float64 magnitudeSquared

; mu = n + 1 - log2(ln(|z|)).
; ln(|z|) = log2(|z|^2) * ln(2)/2.
; n includes the refinement steps.
push iterations
castToFloat64
add 1.0f64
call log2 magnitudeSquared
mul 0.34657359027997265f64
call log2
sub
functionEnd float64

function iterateUntilEscape
; @pos -170 45
use view
param float64 cx
param float64 cy
param int limit

local float64 real
local float64 imaginary
local int iterations

; Start at z = 0. Stop when |z| > 2
; or the iteration limit is reached.
loop MAX_ITERATIONS
push real
mul real
push imaginary
mul imaginary
add
push 4.0f64
greaterThan
push iterations
push limit
greaterOrEqual
or
branchIfTrue 1

call mandelbrotStep real imaginary cx cy
localSet imaginary
localSet real
push iterations
add 1
localSet iterations
loopEnd

; Return the last z and its count.
push real
push imaginary
push iterations
functionEnd float64 float64 int

function refineEscapedOrbit
; @pos -170 110
use view
param float64 real
param float64 imaginary
param float64 cx
param float64 cy

; Extra steps reduce residual bands
; in the fractional escape estimate.
loop SMOOTHING_STEPS
call mandelbrotStep real imaginary cx cy
localSet imaginary
localSet real
loopEnd

; Return the refined |z| squared.
push real
mul real
push imaginary
mul imaginary
add
functionEnd float64


function smoothEscapeIterations
; @pos -120 -30
use view
param float64 cx
param float64 cy
param int limit

local float64 real
local float64 imaginary
local int iterations

call iterateUntilEscape cx cy limit
localSet iterations
localSet imaginary
localSet real

; Unescaped points stay black.
push iterations
push limit
greaterOrEqual
if
push -1.0f64
return
ifEnd

; Refine only points that escaped.
push iterations
add SMOOTHING_STEPS
push real
push imaginary
call refineEscapedOrbit cx cy
call fractionalEscapeCount
functionEnd float64

function renderMandelbrotSamples
; @pos -120 110
#impure
use view
param int8u* pixels
param float64 centerX
param float64 centerY
param float64 span
param int limit

local int x
local int y

loop SAMPLE_COUNT
loopIndex
call indexToXY SAMPLE_WIDTH
localSet y
localSet x

push pixels
loopIndex
mul 3
add

; Map each subpixel sample into
; the complex plane using float64.
push x
castToFloat64
add 0.5f64
push SAMPLE_WIDTH
castToFloat64
div
sub 0.5f64
mul span
add centerX

push 0.5f64
push y
castToFloat64
add 0.5f64
push SAMPLE_HEIGHT
castToFloat64
div
sub
mul span
add centerY

call smoothEscapeIterations limit
call escapeColor
call storeRGB
loopEnd
functionEnd

function escapeColor
; @pos -78 -30
param float64 iterations
local float64 phase
local int segment
local float64 amount

push iterations
push 0.0f64
lessThan
if
push 0
return
ifEnd

; Repeat every 64 iterations.
; Keep the fractional part through
; palette interpolation.
push iterations
div 64.0f64
call fract
mul 5.0f64
localSet phase
push phase
castToInt
localSet segment

; Ease each transition so both its
; color and slope join smoothly.
call fract phase
call smoothstep
localSet amount

call paletteStop segment
push segment
add 1
call paletteStop
call lerpRGB amount
functionEnd int


function paletteStop
; @pos -36 -30
param int index

; Navy -> blue -> teal -> cream
; -> gold -> the same navy.
push index
mapBegin int
map 0x080c28
map 0x2350b4
map 0x28aab9
map 0xf5ebb4
map 0xeb962d
default 0x080c28
mapEnd int
functionEnd int


constants view
; @pos -170 -8
const WIDTH 512
const HEIGHT 512
const PIXEL_COUNT WIDTH*HEIGHT
const AA_SCALE 2
const SAMPLE_WIDTH WIDTH*AA_SCALE
const SAMPLE_HEIGHT HEIGHT*AA_SCALE
const SAMPLE_COUNT SAMPLE_WIDTH*SAMPLE_HEIGHT
const SAMPLE_ROW_BYTES SAMPLE_WIDTH*3
const MAX_ITERATIONS 1024
const SMOOTHING_STEPS 2
const TARGET_X -0.743643887037151f64
const TARGET_Y 0.131825904205330f64
constantsEnd

