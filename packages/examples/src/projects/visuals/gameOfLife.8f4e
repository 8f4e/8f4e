entry main
module screen
; @pos 80 -30
; @home left

const WIDTH 128
const HEIGHT 128
const PIXEL_COUNT WIDTH*HEIGHT
; WIDTH must be a multiple of eight.
const ROW_BYTES WIDTH/8
const BYTE_COUNT ROW_BYTES*HEIGHT
const SEED_WIDTH WIDTH/2
const SEED_HEIGHT HEIGHT/2

; Two packed one-bit buffers,
; MSB first.
int8u[] mono BYTE_COUNT
int8u[] next BYTE_COUNT

; @textureUpload &mono 1bit 128 128
; @texture &mono 2 128 128
moduleEnd
module simulation
; @pos 126 -30
use screen

int running 1
; @switch &running

int seed 1 ; @w
; @slider &seed 1 255

int restart
; @button &restart

int generation ; @w

int initialized
int randomState
int8u* current &screen:mono
int8u* next &screen:next

push initialized
equalToZero
push restart
or
if
push &randomState
push seed
store
push current
push &randomState
call seedWorld

push &generation
push 0
store
push &initialized
push 1
store
push &restart
push 0
store
else
push running
if
push current
push next
call drawGeneration

; Publish the completed 
; generation.
push current
push next
memoryCopy BYTE_COUNT

push &generation
push generation
push 1
add
store
ifEnd
ifEnd
moduleEnd
entryEnd
