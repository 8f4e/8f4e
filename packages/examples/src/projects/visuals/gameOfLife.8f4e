includesEnd

function evolveCell
; @pos -81 -30
param int alive
param int neighbors

; Birth with three neighbors.
; Survive with two or three.
push neighbors
push 3
equal
push alive
push neighbors
push 2
equal
and
or
functionEnd int

function countNeighbors
; @pos -43 -30
#impure
use screen
param int8u* buffer
param int x
param int y

local int dx
local int dy
local int neighbors

; Visit the surrounding 
; 3 x 3 grid, excluding
; the center cell.
; Opposite edges connect.
loop 9
loopIndex
push 4
notEqual
if
loopIndex
push 3
call indexToXY
localSet dy
localSet dx

push neighbors
push buffer
push WIDTH
push HEIGHT
; Offset before remainder
; to avoid negative values.
push x
push dx
add
push WIDTH-1
add
push WIDTH
remainder
push y
push dy
add
push HEIGHT-1
add
push HEIGHT
remainder
call loadBitAt2D
add
localSet neighbors
ifEnd
loopEnd

push neighbors
functionEnd int

function drawGeneration
; @pos -10 -30
#impure
use screen
param int8u* current
param int8u* next

local int x
local int y

; Read only the current 
; generation.
; Write every cell into
; the next one.
loop PIXEL_COUNT
loopIndex
push WIDTH
call indexToXY
localSet y
localSet x

push next
push WIDTH
push HEIGHT
push x
push y

push current
push WIDTH
push HEIGHT
push x
push y
call loadBitAt2D

push current
push x
push y
call countNeighbors
call evolveCell
call storeBitAt2D
loopEnd
functionEnd

function seedWorld
; @pos 24 -30
#impure
use screen
param int8u* buffer
param int* randomState

local int x
local int y

push buffer
push 0
push BYTE_COUNT
fill

; Fill the central patch at
; 25% density.
; The same seed recreates
; the same world.
loop SEED_WIDTH*SEED_HEIGHT
loopIndex
push SEED_WIDTH
call indexToXY
localSet y
localSet x

push buffer
push WIDTH
push HEIGHT
push x
push WIDTH/4
add
push y
push HEIGHT/4
add
push randomState
call xorshift
push 3
and
equalToZero
call storeBitAt2D
loopEnd
functionEnd

