entry main
module screen
; @pos 80 -30
; @home left

const WIDTH 128
const HEIGHT 128
const PIXEL_COUNT WIDTH*HEIGHT
; WIDTH must be a multiple of eight.
const ROW_BYTES WIDTH/8
const BYTE_COUNT ROW_BYTES*HEIGHT
const SEED_WIDTH WIDTH/2
const SEED_HEIGHT HEIGHT/2

; Two packed one-bit buffers,
; MSB first.
int8u[] mono BYTE_COUNT
int8u[] next BYTE_COUNT
int8u* display &mono

; @textureUpload display 1bit 128 128
; @texture display 2 128 128
moduleEnd
module simulation
; @pos 126 -30
use screen

int running 1
; @switch &running

int seed 1 ; @w
; @slider &seed 1 255

int restart
; @button &restart

int generation ; @w

int initialized
int randomState
int8u* current &screen:mono
int8u* next &screen:next

push initialized
equalToZero
push restart
or
if
push &randomState
push seed
store
push current
push &randomState
call seedWorld

push &generation
push 0
store
push &initialized
push 1
store
push &restart
push 0
store
else
push running
if
push current
push next
call drawGeneration

; Reuse the previous front buffer next time.
call swapPointers &current &next

push &generation
push generation
push 1
add
store
ifEnd
ifEnd

; The texture follows the completed world.
push &screen:display
push current
store
moduleEnd
entryEnd