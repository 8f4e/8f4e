include std/bitwise/extractBit
include std/memory/loadBitAt2D
include std/memory/storeBitAt2D
includesEnd

constants grid
; @pos -210 -17
const WIDTH 128
const HISTORY_HEIGHT 128
; WIDTH must be a multiple of eight.
const ROW_BYTES WIDTH/8
const HISTORY_BYTES ROW_BYTES*HISTORY_HEIGHT
constantsEnd

function readNeighborhood
; @pos -164 -31
#impure
use grid
param int8u* input
param int x

; The line wraps into a ring.
; Left, center, right form
; a three-bit lookup index.
push input
push WIDTH
push 1
push x
push WIDTH-1
add
push WIDTH
remainder
push 0
call loadBitAt2D
push 0b100
mul

push input
push WIDTH
push 1
push x
push 0
call loadBitAt2D
push 0b010
mul

push input
push WIDTH
push 1
push x
push 1
add
push WIDTH
remainder
push 0
call loadBitAt2D

add
add
functionEnd int

function transformRow
; @pos -122 -31
#impure
use grid
param int8u* input
param int8u* output
param int rule

; Read each input cell and write
; its successor into another row.
; Input and output must be distinct.
loop WIDTH
push output
push WIDTH
push 1
loopIndex
push 0

push rule
push input
loopIndex
call readNeighborhood
call extractBit
call storeBitAt2D
loopEnd
functionEnd

function appendHistory
; @pos -80 -31
#impure
use grid
param int8u* history
param int8u* row

; Scroll upward and append
; the latest output at the bottom.
push history
push history
push ROW_BYTES
add
memoryCopy HISTORY_BYTES-ROW_BYTES

push history
push HISTORY_BYTES-ROW_BYTES
add
push row
memoryCopy ROW_BYTES
functionEnd

function processStage
; @pos -38 -31
#impure
use grid
param int8u* input
param int8u* output
param int8u* history
param int rule
param int bypass
param int reset

push reset
if
push history
push 0
push HISTORY_BYTES
fill
ifEnd

push bypass
if
; Bypass passes the line through.
push output
push input
memoryCopy ROW_BYTES
else
push input
push output
push rule
call transformRow
ifEnd

push history
push output
call appendHistory
functionEnd

