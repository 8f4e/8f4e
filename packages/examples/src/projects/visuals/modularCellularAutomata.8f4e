note
; @pos 0 -15
; Patch a line through three cellular automata rules.
; Source -> ruleA -> ruleB -> ruleC -> source.
; The feedback returns on the next frame.
;
; Each stage transforms the previous stage's output.
; Move rule sliders or toggle bypass while running.
; Histories scroll upward without being cleared.
; Choose a seed and restart to begin a new pattern.
;
; Reconnect input and feedback pointers to patch.
; Backward patches add a one-frame delay.
noteEnd

entry main
module source
; @pos 0 0
; @home left
use grid

int running 1
; @switch &running

int seed 1 ; @w
; @slider &seed 0 255

int restart
; @button &restart

int frame ; @w
int tick
int reset
int initialized

; Previous frame's final output.
int8u* feedback &ruleC:out
int8u[] out ROW_BYTES
; @textureUpload &out 1bit 128 1
; @texture &out 2 128 1

push &tick
push running
store
push &reset
push 0
store

push initialized
equalToZero
push restart
or
if
; Start with the seed in
; the line's final eight cells.
push &out
push 0
push ROW_BYTES
fill
push &out
push ROW_BYTES-1
add
push seed
store

push &frame
push 0
store
push &initialized
push 1
store
push &tick
push 1
store
push &reset
push 1
store
push &restart
push 0
store
else
push running
if
; Capture feedback before the
; stages write this frame's rows.
push &out
push feedback
memoryCopy ROW_BYTES

push &frame
push frame
push 1
add
store
ifEnd
ifEnd
moduleEnd

module ruleA
; @pos 44 0
use grid

int8u* input &source:out
int8u[] inputRow ROW_BYTES

int rule 110 ; @w
; @slider &rule 0 255

int bypass
; @switch &bypass

int8u[] out ROW_BYTES
int8u[] history HISTORY_BYTES
; @textureUpload &history 1bit 128 128
; @texture &history 2 128 128

int& tick &source:tick
int& reset &source:reset

push *tick
equalToZero
exitIfTrue

; Capture feedback before writing.
push &inputRow
push input
memoryCopy ROW_BYTES

push &inputRow
push &out
push &history
push rule
push bypass
push *reset
call processStage
moduleEnd

