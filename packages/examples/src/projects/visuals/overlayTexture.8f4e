moduleEnd
module patternGenerator
; @pos 145 -21
; @home right
use screen

int& frame &frameCounter:frame
int8u* rgba &screen:rgba

loop PIXEL_COUNT*4

loopIndex
push *frame
mul
push 255
remainder

; Store one RGBA pixel.
push rgba
loopIndex
add
storeBytes 1
loopEnd

