entry main
module screen
; @pos 97 1

const WIDTH 32
const HEIGHT 32
const PIXEL_COUNT WIDTH*HEIGHT

; Framebuffer
int8u[] rgba PIXEL_COUNT*4

moduleEnd
module frameCounter
; @pos 99 -32

int frame ; @w
push &frame
push frame
push 1
add 
store

moduleEnd
module screen2
; @pos 143 -21
; @home right
use screen

int* frame &frameCounter:frame
int8u* rgba &screen:rgba

loop PIXEL_COUNT*4

loopIndex
push *frame
mul
push 255
remainder

; Store one RGBA pixel.
push rgba
loopIndex
add
storeBytes 1
loopEnd

moduleEnd
entryEnd