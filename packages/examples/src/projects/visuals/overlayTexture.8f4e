module screen
; @pos 100 -17

const WIDTH 32
const HEIGHT 32
const PIXEL_COUNT WIDTH*HEIGHT

; Framebuffer
int8u[] rgba PIXEL_COUNT*4

; @textureUpload &rgba rgba 32 32
