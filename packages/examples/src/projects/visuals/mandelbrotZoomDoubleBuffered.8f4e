function escapeIterations
; @pos -120 -30
use view
param float64 cx
param float64 cy
param int limit

local float64 real
local float64 imaginary
local float64 realSquared
local float64 imaginarySquared
local int iterations

; Iterate z = z*z + c from zero.
; Stop once |z| > 2 or at the limit.
loop MAX_ITERATIONS
push realSquared
add imaginarySquared
push 4.0f64
greaterThan
push iterations
push limit
greaterOrEqual
or
branchIfTrue 1

push real
mul imaginary
mul 2.0f64
add cy
localSet imaginary

push realSquared
sub imaginarySquared
add cx
localSet real

push real
mul real
localSet realSquared
push imaginary
mul imaginary
localSet imaginarySquared

push iterations
add 1
localSet iterations
loopEnd

push iterations
functionEnd int

function drawMandelbrot
; @pos -120 40
#impure
use view
param int8u* pixels
param float64 centerX
param float64 centerY
param float64 span
param int limit

local int x
local int y

loop PIXEL_COUNT
loopIndex
call indexToXY WIDTH
localSet y
localSet x

push pixels
loopIndex
mul 3
add

; Map each pixel center into
; the complex plane using float64.
push x
castToFloat64
add 0.5f64
push WIDTH
castToFloat64
div
sub 0.5f64
mul span
add centerX

push 0.5f64
push y
castToFloat64
add 0.5f64
push HEIGHT
castToFloat64
div
sub
mul span
add centerY

call escapeIterations limit
call escapeColor limit
call storeRGB
loopEnd
functionEnd

function escapeColor
; @pos -78 -30
param int iterations
param int limit
local int phase

push iterations
push limit
greaterOrEqual
if
; Unescaped points stay black.
push 0
return
ifEnd

; Repeating blue-to-gold bands.
push iterations
mul 7
and 255
localSet phase

push phase
sub 128
max 0
mul 2
shiftLeft 16
push phase
shiftLeft 8
or
push 255
push phase
div 2
sub
or
functionEnd int

