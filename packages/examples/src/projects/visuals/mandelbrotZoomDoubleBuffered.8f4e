note
; @pos 40 -46
; Explore the Mandelbrot set by iterating z = z*z + c.
; Use the zoom slider to explore a detailed boundary region.
; Each zoom level doubles the magnification.
; Pan offsets are measured in current view widths.
; Raise detail to resolve deeper boundaries.
; Black pixels have not escaped at the chosen limit.
; The worker draws into a spare buffer, then swaps it
; with the displayed frame when the image is complete.
noteEnd

entry main
module screen
; @pos 40 -30
use view

int8u[] rgb PIXEL_COUNT*3
int8u[] spare PIXEL_COUNT*3
int8u* display &rgb
; @textureUpload display rgb 512 512
; @texture display 1 512 512
moduleEnd
module camera
; @pos 117 -30
; @home right
use view

float zoom 0.0 ; @w
; @slider &zoom 0.0 20.0 0.05

float panX 0.0
; @slider &panX -1.0 1.0 0.01

float panY 0.0
; @slider &panY -1.0 1.0 0.01

int detail 512 ; @w
; @slider &detail 64 1024 64

float64 span 3.2f64
float64 centerX TARGET_X
float64 centerY TARGET_Y

; A zoom level halves the view span.
push &span
push zoom
mul -1.0
call exp2
castToFloat64
mul 3.2f64
store

push &centerX
push panX
castToFloat64
mul span
add TARGET_X
store
push &centerY
push panY
castToFloat64
mul span
add TARGET_Y
store
moduleEnd
module renderer
; @pos 164 -30

int8u* pixels &screen:spare
int8u** display &screen:display
int renders ; @w
float64& centerX &camera:centerX
float64& centerY &camera:centerY
float64& span &camera:span
int& detail &camera:detail

float64 lastX
float64 lastY
float64 lastSpan -1.0f64
int lastDetail

; Keep the image while the view is still.
push *centerX
push lastX
equal
push *centerY
push lastY
equal
and
push *span
push lastSpan
equal
and
push *detail
push lastDetail
equal
and
exitIfTrue

; Snapshot the view before drawing.
; New detail changes will be picked
; up on the following worker tick.
push &lastX
push *centerX
store
push &lastY
push *centerY
store
push &lastSpan
push *span
store
push &lastDetail
push *detail
store

call drawMandelbrot 
- pixels lastX lastY lastSpan lastDetail

; Publish the completed frame,
; then reuse the previous buffer.
call swapPointers display &pixels

push &renders
push renders
add 1
store
moduleEnd
entryEnd
