includes
; @pos -86 -31
include std/bitwise/extractBit
include std/memory/loadBitAt2D
include std/memory/storeBitAt2D
includesEnd

function evolveCell
; @pos -47 -31
param int neighborhood
param int rule

; The three-cell neighborhood selects
; one bit from the rule number.
push rule
push neighborhood
call extractBit
functionEnd int

function readNeighborhood
; @pos -1 -31
#impure
use screen
param int8u* buffer
param int x
param int y

push y
push 1
sub
localSet y

; Read the left, center,
; and right cells from the 
; previous row.
; Outside cells are zero.
push buffer
push WIDTH
push HEIGHT
push x
push 1
sub
push y
call loadBitAt2D
push 0b100
mul

push buffer
push WIDTH
push HEIGHT
push x
push y
call loadBitAt2D
push 0b010
mul

push buffer
push WIDTH
push HEIGHT
push x
push 1
add
push y
call loadBitAt2D

add
add
functionEnd int

function drawRow
; @pos 37 -31
#impure
use screen
param int8u* buffer
param int rule
param int y

local int x

; Grow one generation 
; from the row above.
loop WIDTH
loopIndex
localSet x

push buffer
push WIDTH
push HEIGHT
push x
push y

push buffer
push x
push y
call readNeighborhood
push rule
call evolveCell
call storeBitAt2D
loopEnd
functionEnd

function scrollUp
; @pos 37 1
#impure
use screen
param int8u* buffer

; Move the existing generations
; up one row.
; Overlapping copies preserve
; their order.
push buffer
push buffer
push ROW_BYTES
add
memoryCopy BYTE_COUNT-ROW_BYTES
functionEnd

