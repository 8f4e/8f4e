note
; @pos -118 15
; A fixed bottom-right cell starts the pattern.
; Each frame moves the history up one row
; and grows a new generation at the bottom.
;
; Move the rule slider while it scrolls.
; Earlier generations keep their history.
noteEnd

entry main
module screen
; @pos 102 -29

const WIDTH 256
const HEIGHT 256
; WIDTH must be a multiple of eight.
const ROW_BYTES WIDTH/8
const BYTE_COUNT ROW_BYTES*HEIGHT

; Packed black/white pixels, MSB first.
int8u[] mono BYTE_COUNT

; @textureUpload &mono 1bit 256 256
; @texture &mono 2 256 256
moduleEnd
module patternGenerator
; @pos 175 -29
; @home right
use screen

int rule 110 ; @w
; @slider &rule 0 255

int initialized
int8u* mono &screen:mono

push initialized
if
; Retain history and 
; append one new row.
push mono
call scrollUp

push mono
push rule
push HEIGHT-1
call drawRow
else
; Initialize once with a
; bottom-right seed.
push mono
push 0
push BYTE_COUNT
fill

push mono
push WIDTH
push HEIGHT
push WIDTH-1
push HEIGHT-1
push 1
call storeBitAt2D

push &initialized
push 1
store
ifEnd
moduleEnd
entryEnd