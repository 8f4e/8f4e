function evolveCell
; @pos -47 -31
param int neighborhood
param int rule

; The three-cell neighborhood selects
; one bit from the rule number.
push rule
push neighborhood
call extractBit
functionEnd int

function readNeighborhood
; @pos -1 -31
#impure
use screen
param int8u* buffer
param int x
param int y

push y
push 1
sub
localSet y

; Read the left, center,
; and right cells from the 
; previous row.
; Outside cells are zero.
push buffer
push WIDTH
push HEIGHT
push x
push 1
sub
push y
call loadBitAt2D
push 0b100
mul

push buffer
push WIDTH
push HEIGHT
push x
push y
call loadBitAt2D
push 0b010
mul

push buffer
push WIDTH
push HEIGHT
push x
push 1
add
push y
call loadBitAt2D

add
add
functionEnd int

function drawPattern
; @pos 35 -31
#impure
use screen
param int8u* buffer
param int rule

local int x
local int y

; The caller supplies
; the seeded first row.
; Draw each remaining cell
; from the row above.
loop PIXEL_COUNT-WIDTH
loopIndex
push WIDTH
add
push WIDTH
call indexToXY
localSet y
localSet x

push buffer
push WIDTH
push HEIGHT
push x
push y

push buffer
push x
push y
call readNeighborhood
push rule
call evolveCell
call storeBitAt2D
loopEnd

functionEnd

