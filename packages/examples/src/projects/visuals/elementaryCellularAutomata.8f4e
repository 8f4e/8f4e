entry main
module screen
; @pos 102 -29

const WIDTH 256
const HEIGHT 256
const PIXEL_COUNT WIDTH*HEIGHT
; WIDTH must be a multiple of eight.
const ROW_BYTES WIDTH/8
const BYTE_COUNT ROW_BYTES*HEIGHT

; Packed black/white pixels, MSB first.
int8u[] mono BYTE_COUNT

; @textureUpload &mono 1bit 256 256
; @texture &mono 2 256 256

moduleEnd
module patternGenerator
; @pos 175 -29
; @home right
use screen

int rule 110 ; @w
; @slider &rule 0 255

int seed 1 ; @w
; @slider &seed 0 255

int8u* mono &screen:mono

; Clear only the first row.
; Every later byte is overwritten.
push mono
push 0
push ROW_BYTES
fill

; Seed the last eight cells
; of the first row.
push mono
push ROW_BYTES-1
add
push seed
store

push mono
push rule
call drawPattern

moduleEnd
entryEnd