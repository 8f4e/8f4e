module patternGenerator
; @pos 175 -29
; @home right
use screen

int8u* mono &screen:mono

; @w mono
; @w mono[1]

; Clear one byte per pixel.
loop PIXEL_COUNT
push mono
loopIndex
add
push 0
store
loopEnd

; Seed the first row 
; at the top-right corner.
push mono
push WIDTH-1
add
push 255
store

; Each following row evolves 
; from the row above.
loop PIXEL_COUNT-WIDTH
push mono
loopIndex
push WIDTH
add
add

push mono
loopIndex
push WIDTH
add
call indexToXY
call liveOrDie

push 255
mul
store
loopEnd

