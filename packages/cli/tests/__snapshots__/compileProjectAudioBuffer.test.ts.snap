        "push &phase",
        "push NEG_PI",
        "store",
        "ifEnd",
        "",
        "push &out",
        "push phase",
        "; You can swap this call",
        "; with any periodic function",
        "call sine",
        "store",
        "",
        "moduleEnd",
      ],
      "entry": "main",
      "id": 89,
      "type": "module",
    },
    {
      "code": [
        "module audioout",
        "; @pos 88 1",
        "; @home",
        "use env",
        "",
        "float& in &phaseAccumulator:out",
        "",
        "; Audio buffer",
        "float[] buffer AUDIO_BUFFER_SIZE",
        "int pointer &buffer",
        "",
        "; @plot &buffer count(buffer)",
        "",
        "; Store the input value",
        "; in the buffer",
        "push pointer",
        "push *in",
        "push 0.5",
        "mul",
        "store",
        "",
        "; Increment the buffer",
        "; pointer by the",
        "; buffer word size",
        "push &pointer",
        "push pointer",
        "push sizeof(buffer)",
        "add",
        "store",
        "",
        "; Reset the buffer pointer",
        "; when it reaches the end",
        "; of the buffer",
        "push pointer",
        "push end(buffer)",
        "greaterOrEqual",
        "if",
        "push &pointer",
        "push &buffer",
        "store",
        "ifEnd",
        "",
        "moduleEnd",
      ],
      "entry": "main",
      "id": 132,
      "type": "module",
    },
  ],
