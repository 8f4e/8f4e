      "code": [
        "function buffer",
        "; @pos -120 23",
        "#export buffer",
        "use env",
        "",
        "loop AUDIO_BUFFER_SIZE",
        "call main",
        "loopEnd",
        "functionEnd",
      ],
      "id": 8,
