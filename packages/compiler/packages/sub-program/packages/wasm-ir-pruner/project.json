{
	"name": "@8f4e/wasm-ir-pruner",
	"sourceRoot": "packages/compiler/packages/sub-program/packages/wasm-ir-pruner/src",
	"projectType": "library",
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": [
				"{projectRoot}/dist"
			],
			"options": {
				"command": "rm -rf dist && tsc",
				"cwd": "{projectRoot}"
			}
		},
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"command": "biome check --write packages/compiler/packages/sub-program/packages/wasm-ir-pruner/src",
				"cwd": "{workspaceRoot}"
			}
		},
		"dev": {
			"executor": "nx:run-commands",
			"options": {
				"command": "rm -rf dist && tsc --watch",
				"cwd": "{projectRoot}"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc --noEmit",
				"cwd": "{projectRoot}"
			}
		}
	},
	"tags": [
		"type:library",
		"scope:core"
	]
}
