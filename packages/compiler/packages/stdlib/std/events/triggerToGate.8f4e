function triggerToGate
#export
#impure
; @doc Holds a gate for a number of calls. Every
; - positive trigger restarts the countdown.
; @returns 1 while the countdown is active, otherwise 0.
; @param trigger Current trigger; positive restarts the
; - gate.
param int trigger
; @param duration Duration in calls, including the
; - triggering call.
param int duration
; @param remainingSamples Address of persistent
; - countdown, initially zero.
param int* remainingSamples

push trigger
push 0
greaterThan
if
push remainingSamples
push duration
store
ifEnd

push *remainingSamples
push 0
greaterThan
if
push remainingSamples
push *remainingSamples
push 1
sub
store
push 1
else
push 0
ifEnd int

functionEnd int

function triggerToGate
#export
#impure
; @doc Holds a gate for a number of calls. Every
; - positive trigger restarts the countdown.
; @returns 1 while the countdown is active, otherwise 0.
; @param trigger Current trigger; positive restarts the
; - gate.
param float trigger
; @param duration Duration in calls, including the
; - triggering call.
param int duration
; @param remainingSamples Address of persistent
; - countdown, initially zero.
param int* remainingSamples

push trigger
push 0.0
greaterThan
if
push remainingSamples
push duration
store
ifEnd

push *remainingSamples
push 0
greaterThan
if
push remainingSamples
push *remainingSamples
push 1
sub
store
push 1
else
push 0
ifEnd int

functionEnd int
