function gateToTrigger
#export
#impure
; @doc Emits a one-call trigger on any increase in the
; - gate and stores the new gate.
; @param gate Current gate value.
; @param previousGate Address of persistent previous
; - gate state.
; @returns 1 on an increase, otherwise 0.
param int gate
param int* previousGate

push gate
push *previousGate
greaterThan
push previousGate
push gate
store

functionEnd int

function gateToTrigger
#export
#impure
; @doc Emits a one-call trigger on any increase in the
; - gate and stores the new gate.
; @param gate Current gate value.
; @param previousGate Address of persistent previous
; - gate state.
; @returns 1 on an increase, otherwise 0.
param float gate
param float* previousGate

push gate
push previousGate
loadFloat
greaterThan
push previousGate
push gate
store

functionEnd int
