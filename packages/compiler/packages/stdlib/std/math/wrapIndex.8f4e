function wrapIndex
#export
; @doc Wraps a signed index into a cyclic range.
; @returns Wrapped index in 0..size-1.
; @param index Index, possibly negative or out of range.
param int index
; @param size Positive range length.
param int size

push index
push size
ensureNonZero
remainder
localSet index

push index
push 0
lessThan
if
push index
add size
else
push index
ifEnd int
functionEnd int
