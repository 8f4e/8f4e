function smoothstep
#export
; @doc Evaluates a cubic easing curve without clamping
; - the input.
; @param amount Interpolation amount, typically 0..1.
; @returns The eased amount.
param float amount

push amount
push amount
mul
push 3.0
push 2.0
push amount
mul
sub
mul

functionEnd float

function smoothstep
#export
; @doc Evaluates a cubic easing curve without clamping
; - the input.
; @param amount Interpolation amount, typically 0..1.
; @returns The eased amount.
param float64 amount

push amount
push amount
mul
push 3.0f64
push 2.0f64
push amount
mul
sub
mul

functionEnd float64
