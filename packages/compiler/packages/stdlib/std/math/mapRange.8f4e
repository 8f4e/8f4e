function mapRange
#export
; @doc Linearly remaps a value between ranges,
; - extrapolating beyond the input range.
; @param value Finite input value.
; @param inputStart Start of the input range.
; @param inputEnd Distinct end of the input range.
; @param outputStart Start of the output range.
; @param outputEnd End of the output range.
; @returns The mapped value.
param float value
param float inputStart
param float inputEnd
param float outputStart
param float outputEnd

push value
sub inputStart
push inputEnd
sub inputStart
ensureNonZero
div
push outputEnd
sub outputStart
mul
add outputStart
functionEnd float
