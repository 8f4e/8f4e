function fract
#export
; @doc Returns the signed fractional part, truncating
; - toward zero.
; @returns The value minus its truncated integer part.
; @param value Finite double-precision value.
param float64 value
local float64 fraction

push value
push value
round
sub
localSet fraction

push value
push 0.0f64
