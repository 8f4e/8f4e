function lerp
#export
; @doc Linearly interpolates between two values.
; @returns The interpolated value.
; @param start The starting value.
param float start
; @param end The target value.
param float end
; @param amount Interpolation factor (0..1; outside
; - extrapolates).
param float amount

push start
push 1.0
push amount
sub
mul
push end
push amount
mul
add

functionEnd float

function lerp
#export
; @doc Linearly interpolates between two values.
; @returns The interpolated value.
; @param start The starting value.
param float64 start
; @param end The target value.
param float64 end
; @param amount Interpolation factor (0..1; outside
; - extrapolates).
param float64 amount

push start
push 1.0f64
push amount
sub
mul
push end
push amount
mul
add

functionEnd float64
