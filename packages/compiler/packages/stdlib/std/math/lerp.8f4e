function lerp
#export
; @doc Linearly interpolates between two values.
; @param start The starting value.
; @param end The target value.
; @param amount Interpolation factor (0..1; outside
; - extrapolates).
; @returns The interpolated value.
param float start
param float end
param float amount

push start
push 1.0
push amount
sub
mul
push end
push amount
mul
add

functionEnd float

function lerp
#export
; @doc Linearly interpolates between two values.
; @param start The starting value.
; @param end The target value.
; @param amount Interpolation factor (0..1; outside
; - extrapolates).
; @returns The interpolated value.
param float64 start
param float64 end
param float64 amount

push start
push 1.0f64
push amount
sub
mul
push end
push amount
mul
add

functionEnd float64
