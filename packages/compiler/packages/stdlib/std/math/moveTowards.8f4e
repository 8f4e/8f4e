function moveTowards
#export
; @doc Moves toward a target by at most a step, without
; - overshooting.
; @param current Current value.
; @param target Target value.
; @param maxStep Maximum distance per call; nonpositive
; - leaves current unchanged.
; @returns The next value.
param float current
param float target
param float maxStep

push maxStep
max 0.0
localSet maxStep

push target
push current
greaterThan
if
push current
add maxStep
min target
else
push current
sub maxStep
max target
ifEnd float

functionEnd float
