function normalize
#export
#impure
; @doc Loads a signed 32-bit integer and normalizes it
; - to -1..1.
; @param pointer Address of the signed 32-bit sample.
; @returns Normalized float, clamped to -1..1.
param int* pointer

push pointer
load
castToFloat
push max(*pointer)
ensureNonZero
castToFloat
div
push -1.0
max
push 1.0
min

functionEnd float
