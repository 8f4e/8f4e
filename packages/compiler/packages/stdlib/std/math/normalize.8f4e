function normalize
#export
#impure
; @doc Loads a signed 8-bit integer and normalizes it to
; - -1..1.
; @param pointer Address of the signed 8-bit sample.
; @returns Normalized float, clamped to -1..1.
param int8* pointer

push pointer
load8s
castToFloat
push max(*pointer)
ensureNonZero
castToFloat
div
push -1.0
max
push 1.0
min

functionEnd float

function normalize
#export
#impure
; @doc Loads a unsigned 8-bit integer and normalizes it
; - to 0..1.
; @param pointer Address of the unsigned 8-bit sample.
; @returns Normalized float, clamped to 0..1.
param int8u* pointer

push pointer
load8u
castToFloat
push max(*pointer)
ensureNonZero
castToFloat
div
push 0.0
max
push 1.0
min

functionEnd float

