function advancePhase
#export
#impure
; Advances a phase by one sample
; and preserves overshoot when
; wrapping across PI.
param float* phase
param float frequency
param int sampleRate

const PI 3.141592653589793
const TAU 6.283185307179586

push phase
push *phase
push TAU
mul frequency
push sampleRate
castToFloat
ensureNonZero
div
add
store

push *phase
push PI
greaterThan
if
push phase
push *phase
sub TAU
store
ifEnd

push *phase
functionEnd float
