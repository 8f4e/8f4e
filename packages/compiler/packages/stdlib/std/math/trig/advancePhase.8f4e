function advancePhase
#export
#impure
; @doc Advances a phase by one sample, wrapping once
; - above PI and preserving overshoot.
; @returns The updated phase in radians.
; @param phase Address of the mutable phase in radians.
param float* phase
; @param frequency Oscillator frequency in Hz.
param float frequency
; @param sampleRate Positive sample rate in Hz.
param int sampleRate

const PI 3.141592653589793
const TAU 6.283185307179586

push phase
push *phase
push TAU
mul frequency
push sampleRate
castToFloat
ensureNonZero
div
add
store

push *phase
push PI
greaterThan
if
push phase
push *phase
sub TAU
store
ifEnd

push *phase
functionEnd float
