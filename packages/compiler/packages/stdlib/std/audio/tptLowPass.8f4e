function tptLowPass
#export
; @doc Processes one sample of a trapezoidal low-pass
; - state-variable filter. The caller persists the
; - states.
; @returns Low-pass output, next s1, next s2 (top).
; @param input Current finite input sample.
param float input
; @param g Non-negative tan(PI * cutoffHz / sampleRate).
param float g
; @param damping Positive damping (1 / Q).
param float damping
; @param s1 First integrator state, initially zero.
param float s1
; @param s2 Second integrator state, initially zero.
param float s2
local float a1
local float a2
local float v3
local float low

; a1 = 1 / (1 + g * (g + k)).
push 1.0
push g
add damping
mul g
add 1.0
ensureNonZero
div
localSet a1
push g
mul a1
localSet a2

push input
sub s2
localSet v3

; low = s2 + a2*s1 + g*a2*v3.
push s2
push a2
mul s1
add
push g
mul a2
mul v3
add
localSet low

push low

; nextS1 = 2*band - s1.
push a1
mul s1
push a2
mul v3
add
mul 2.0
sub s1

; nextS2 = 2*low - s2.
push low
mul 2.0
sub s2
functionEnd float float float
