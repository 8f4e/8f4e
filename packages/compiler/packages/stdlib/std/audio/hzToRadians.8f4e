function hzToRadians
#export
; @doc Converts frequency in Hz to radians per sample.
; @param frequencyHz Finite frequency in Hz.
; @param sampleRate Positive sample rate in Hz.
; @returns Phase increment in radians per sample.
param float frequencyHz
param int sampleRate

const TAU 6.283185307179586

push frequencyHz
mul TAU
push sampleRate
castToFloat
ensureNonZero
div
functionEnd float
