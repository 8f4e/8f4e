includes
include std/memory/advancePointer
includesEnd

function queuePush
#export
#impure
; @doc Adds a nonzero word to a zero-marked integer
; - FIFO; drops it if the slot is occupied.
; @param writePointer Address of the write cursor,
; - initially at buffer start.
param int** writePointer
; @param buffer Start of the initially zero-filled FIFO.
param int* buffer
; @param itemCount Positive buffer length in elements.
param int itemCount
; @param value Nonzero word to enqueue.
param int value
local int* slot

push *writePointer
localSet slot
push *slot
equalToZero
if
push slot
push value
store
call advancePointer writePointer buffer itemCount
ifEnd
functionEnd
