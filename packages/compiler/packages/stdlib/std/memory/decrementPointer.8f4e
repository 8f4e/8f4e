function decrementPointer
#export
#impure
; @doc Moves a pointer back one element and wraps it in
; - a circular buffer.
; @param pointer Address of the mutable pointer
; - variable.
param int** pointer
; @param buffer Start of the circular buffer.
param int* buffer
; @param itemCount Positive buffer length in elements.
param int itemCount

local int byteLength

push itemCount
push sizeof(*buffer)
mul
localSet byteLength

push pointer
push buffer
push *pointer
push sizeof(*buffer)
sub
push buffer
sub
push byteLength
ensureNonZero
remainder
push byteLength
add
push byteLength
ensureNonZero
remainder
add
store

functionEnd

function decrementPointer
#export
#impure
