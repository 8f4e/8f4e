; - range.
; @param buffer Start of the circular buffer.
; @param itemCount Positive buffer length in elements.
; @param fraction Interpolation factor between adjacent
; - samples.
; @returns The interpolated float value.
param float* pointer
param float* buffer
param int itemCount
param float fraction

local int byteLength
local float first
local float second

push itemCount
push sizeof(*buffer)
mul
localSet byteLength

push pointer
push buffer
push byteLength
call wrapReadAddress
loadFloat
localSet first

push pointer
push sizeof(*buffer)
add
push buffer
push byteLength
call wrapReadAddress
loadFloat
localSet second

push first
push second
push first
sub
push fraction
mul
add

functionEnd float

function wrapReadAddress
; @doc Wraps a typed byte address into the circular
; - sample buffer.
; @param pointer Typed byte address, possibly out of
; - range.
; @param buffer Start of the circular buffer.
; @param byteLength Positive buffer length in bytes.
; @returns The wrapped typed address.
param int* pointer
param int* buffer
param int byteLength

push buffer
push pointer
push buffer
sub
push byteLength
ensureNonZero
remainder
push byteLength
add
push byteLength
ensureNonZero
remainder
add

functionEnd int*

