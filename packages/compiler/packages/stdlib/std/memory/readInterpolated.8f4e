push itemCount
push sizeof(*buffer)
mul
localSet byteLength

push pointer
push buffer
push byteLength
call wrapReadAddress
load16s
castToFloat
localSet first

push pointer
push sizeof(*buffer)
add
push buffer
push byteLength
call wrapReadAddress
load16s
castToFloat
localSet second

push first
push second
push first
sub
push fraction
mul
add

functionEnd float

function readInterpolated
#export
#impure
; @doc Reads two adjacent circular-buffer samples and
; - linearly interpolates.
; @returns The interpolated float value.
; @param pointer Typed byte address, possibly out of
; - range.
param float* pointer
; @param buffer Start of the circular buffer.
param float* buffer
; @param itemCount Positive buffer length in elements.
param int itemCount
; @param fraction Interpolation factor between adjacent
; - samples.
param float fraction

local int byteLength
local float first
local float second

push itemCount
push sizeof(*buffer)
mul
localSet byteLength

push pointer
push buffer
push byteLength
call wrapReadAddress
loadFloat
localSet first

push pointer
push sizeof(*buffer)
add
push buffer
push byteLength
call wrapReadAddress
loadFloat
localSet second

push first
push second
push first
sub
push fraction
mul
add

functionEnd float

function wrapReadAddress
; @doc Wraps a typed byte address into the circular
; - sample buffer.
; @returns The wrapped typed address.
; @param pointer Typed byte address, possibly out of
; - range.
param int* pointer
; @param buffer Start of the circular buffer.
param int* buffer
; @param byteLength Positive buffer length in bytes.
param int byteLength

push buffer
push pointer
push buffer
sub
push byteLength
ensureNonZero
remainder
push byteLength
add
push byteLength
ensureNonZero
remainder
add

functionEnd int*

