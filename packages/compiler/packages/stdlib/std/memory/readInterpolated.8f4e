param int16* pointer
param int16* buffer
param int itemCount
param float fraction

local int byteLength
local float first
local float second

push itemCount
push sizeof(*buffer)
mul
localSet byteLength

push pointer
push buffer
push byteLength
call wrapReadAddress
load16s
castToFloat
localSet first

push pointer
push sizeof(*buffer)
add
push buffer
push byteLength
call wrapReadAddress
load16s
castToFloat
localSet second

push first
push second
push first
sub
push fraction
mul
add

functionEnd float

