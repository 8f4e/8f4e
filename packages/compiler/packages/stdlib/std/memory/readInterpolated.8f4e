function readInterpolated
#export
#impure
; @doc Reads two adjacent circular-buffer samples and
; - linearly interpolates.
; @returns The interpolated float value.
; @param pointer Typed byte address, possibly out of
; - range.
param int* pointer
; @param buffer Start of the circular buffer.
param int* buffer
; @param itemCount Positive buffer length in elements.
param int itemCount
; @param fraction Interpolation factor between adjacent
; - samples.
param float fraction

local int byteLength
local float first
local float second

push itemCount
push sizeof(*buffer)
mul
localSet byteLength

push pointer
push buffer
push byteLength
call wrapReadAddress
load
castToFloat
localSet first

push pointer
push sizeof(*buffer)
add
push buffer
push byteLength
call wrapReadAddress
load
castToFloat
localSet second

push first
push second
push first
sub
push fraction
mul
add

functionEnd float

