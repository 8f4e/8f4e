; - range.
; @param buffer Start of the circular buffer.
; @param itemCount Positive buffer length in elements.
; @returns The wrapped typed address.
param float* pointer
param float* buffer
param int itemCount

local int byteLength

push itemCount
push sizeof(*buffer)
mul
localSet byteLength

push buffer
push pointer
push buffer
sub
push byteLength
ensureNonZero
remainder
push byteLength
add
push byteLength
ensureNonZero
remainder
add

functionEnd float*
