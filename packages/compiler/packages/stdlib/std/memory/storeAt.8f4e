function storeAt
#export
#impure
; @doc Writes a value at a buffer element index.
; @param buffer Start of the writable buffer.
; @param index Valid zero-based element index.
; @param value Integer value to store.
param int* buffer
param int index
param int value

push buffer
push index
push sizeof(*buffer)
mul
add

push value
store

functionEnd

function storeAt
#export
#impure
; @doc Writes a value at a buffer element index.
; @param buffer Start of the writable buffer.
; @param index Valid zero-based element index.
; @param value Value to store, truncated to its low
; - byte.
param int8u* buffer
param int index
param int value

push buffer
push index
add
push value
store

functionEnd
