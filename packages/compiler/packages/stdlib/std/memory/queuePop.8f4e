includes
include std/memory/advancePointer
includesEnd

function queuePop
#export
#impure
; @doc Consumes a nonzero word from a zero-marked
; - integer FIFO.
; @param readPointer Address of the read cursor,
; - initially at buffer start.
; @param buffer Start of the FIFO buffer.
; @param itemCount Positive buffer length in elements.
; @returns Removed word, or zero if the slot is empty.
param int** readPointer
param int* buffer
param int itemCount
local int value

push **readPointer
localSet value
push value
if
push *readPointer
push 0
store
call advancePointer readPointer buffer itemCount
ifEnd
push value
functionEnd int
