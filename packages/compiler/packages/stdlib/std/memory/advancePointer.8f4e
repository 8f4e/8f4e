function advancePointer
#export
#impure
; @doc Advances a pointer by one element and wraps it in
; - a circular buffer.
; @param pointer Address of the mutable pointer
; - variable.
; @param buffer Start of the circular buffer.
; @param itemCount Positive buffer length in elements.
param int** pointer
param int* buffer
param int itemCount

local int byteLength

push itemCount
push sizeof(*buffer)
mul
localSet byteLength

push pointer
push buffer
push *pointer
push sizeof(*buffer)
add
push buffer
sub
push byteLength
ensureNonZero
remainder
push byteLength
add
push byteLength
ensureNonZero
remainder
add
store

functionEnd

