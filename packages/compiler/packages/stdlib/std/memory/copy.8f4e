function copy
#export
#impure
; @doc Copies one value between pointers of the same
; - type.
; @param source Address of the value to read.
; @param dest Address of the destination to write.
param int* source
param int* dest

push dest
push *source
store

functionEnd

function copy
#export
#impure
; @doc Copies one value between pointers of the same
; - type.
; @param source Address of the value to read.
; @param dest Address of the destination to write.
param float* source
param float* dest

push dest
push *source
store

functionEnd
