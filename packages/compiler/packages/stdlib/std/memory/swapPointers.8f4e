function swapPointers
#export
#impure
; @doc Swaps addresses stored in two same-type pointer
; - variables without accessing the pointed-to data.
; @param first Address of the first pointer variable.
param int** first
; @param second Address of the second pointer variable.
param int** second

local int* previous

push *first
localSet previous
push first
push *second
store
push second
push previous
store
functionEnd

