function swapPointers
#export
#impure
; Exchanges two int pointer values.
; Pass the addresses of the pointer
; variables, not their pointees.
param int** first
param int** second

local int* previous

push *first
localSet previous
push first
push *second
store
push second
push previous
store
functionEnd

