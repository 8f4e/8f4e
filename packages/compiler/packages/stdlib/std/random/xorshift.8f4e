function xorshift
#export
#impure
; @doc Advances a signed 32-bit XORShift pseudorandom
; - generator.
; @returns Next signed 32-bit integer, also written to
; - seed.
; @param seed Address of mutable seed; zero stays zero.
param int* seed

push seed
push *seed
push *seed
push 13
shiftLeft
xor
store

push seed
push *seed
push *seed
push 17
shiftRightUnsigned
xor
store

push seed
push *seed
push *seed
push 5
shiftLeft
xor
store

push *seed

functionEnd int
