function extractNibble
#export
; @doc Extracts four bits from a 32-bit integer.
; @param word Source bit pattern.
; @param nibbleIndex Nibble position 0..7, from the
; - least-significant nibble.
; @returns The nibble value, 0..15.
param int word
param int nibbleIndex

push word
push nibbleIndex
shiftLeft 2
shiftRightUnsigned
and 0xF

functionEnd int
