function extractBits
#export
; @doc Extracts a bit field into the low bits of the
; - result.
; @param word Source 32-bit bit pattern.
; @param offset Least-significant bit offset,
; - 0..32-count.
; @param count Number of bits, 0..32.
; @returns Unsigned field; zero if count is zero,
; - original word if count is 32.
param int word
param int offset
param int count

push count
if
push word
push offset
shiftRightUnsigned

push -1
push 32
push count
sub
shiftRightUnsigned
and
else
push 0
ifEnd int

functionEnd int
