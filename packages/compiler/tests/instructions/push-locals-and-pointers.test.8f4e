8f4e/v1

note
; @config testRuntime.enabled true

Push should resolve locals,
parameters, module memory, and
pointer dereference depth
correctly.
noteEnd

entry test
module pushLocalAssertions
local float narrow
local float64 wide

push 1.5
localSet narrow
push narrow
assertEqual 1.5

push 2.5f64
localSet wide
push wide
assertEqual 2.5f64

push narrow
castToFloat64
localSet wide
push wide
assertEqual 1.5f64

; Function locals should
; round-trip through localSet
; and push.
call readIntLocal
assertEqual 7

call readFloatLocal
assertEqual 1.5

call readFloat64Local
assertEqual 16777217.0f64

call assignFloatParameter 1.5
assertEqual 2.5

call assignFloat64Parameter 1.5f64
assertEqual 16777217.0f64

push 2.0f64
call doubleFloat64
assertEqual 4.0f64
moduleEnd

module localShadowMemoryAssertions
; Function parameters should
; shadow same-named module
; memory
; identifiers.
int value 42
push 7
call shadowValue
assertEqual 7
moduleEnd

module pointerDereferenceDepthAssertions
; A pointer-to-pointer can be
; pushed as an address or
; dereferenced to the pointee
; value.
float value 1.5
float* ptr &value
float** pptr &ptr

push *pptr
assertEqual &value

push **pptr
assertEqual 1.5
moduleEnd

module unsignedNarrowPointerAssertions
; Unsigned narrow pointers should
; preserve their pointee type
; through parameters and memory.
int8u[] bytes 2 255
int8u* cursor &bytes

push &bytes
call readUnsignedByte
assertEqual 255

push *cursor
assertEqual 255
moduleEnd
entryEnd

function readIntLocal
local int temp
push 7
localSet temp
push temp
functionEnd int

function readFloatLocal
local float temp
push 1.5
localSet temp
push temp
functionEnd float

function readFloat64Local
local float64 temp
push 16777217.0f64
localSet temp
push temp
functionEnd float64

function assignFloatParameter
param float value
push 2.5
localSet value
push value
functionEnd float

function assignFloat64Parameter
param float64 value
push 16777217.0f64
localSet value
push value
functionEnd float64

function doubleFloat64
param float64 value
push value
push 2.0f64
mul
functionEnd float64

function shadowValue
param int value
push value
functionEnd int

function readUnsignedByte
#impure
param int8u* bytes
push *bytes
functionEnd int
