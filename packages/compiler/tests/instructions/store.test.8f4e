8f4e/v1

note
; @config testRuntime.enabled true

Store writes integer and
floating values through memory
addresses.
noteEnd

entry test
module intStoreAssertions
; int stores should write the
; source value into the
; destination
; address.
int dest
int src 42

push &dest
push src
store

push dest
assertEqual 42
moduleEnd

module floatStoreAssertions
; float stores should keep the
; float32 path working.
float dest
float src 3.14

push &dest
push src
store

push dest
assertEqual 3.14
moduleEnd

module float64StoreAssertions
; float64 stores should write
; 64-bit values and keep float64
; memory aligned.
float64 dest
float64 src 1.5

push &dest
push src
store

push dest
assertEqual 1.5f64

push &dest
push 8
ensureNonZero
remainder
assertEqual 0

push &src
push 8
ensureNonZero
remainder
assertEqual 0
moduleEnd
entryEnd
