module mapFloatKeyPrecisionAssertions
; @pos 146 2
; Distinct source keys round to the
; same float32 key. The earlier row
; still wins. Float64 distinguishes
; those same source keys.
push 16777216.0
mapBegin float
map 16777216.0 10
map 16777217.0 20
default -7
mapEnd int
assertEqual 10

push 16777217.0
mapBegin float
map 16777216.0 10
map 16777217.0 20
default -7
mapEnd int
assertEqual 10

push 16777218.0
mapBegin float
map 16777216.0 10
map 16777217.0 20
default -7
mapEnd int
assertEqual -7

push 16777216.0f64
mapBegin float64
map 16777216.0f64 10
map 16777217.0f64 20
default -7
mapEnd int
assertEqual 10

push 16777217.0f64
mapBegin float64
map 16777216.0f64 10
map 16777217.0f64 20
default -7
mapEnd int
assertEqual 20

push 16777218.0f64
mapBegin float64
map 16777216.0f64 10
map 16777217.0f64 20
default -7
mapEnd int
assertEqual -7

moduleEnd
