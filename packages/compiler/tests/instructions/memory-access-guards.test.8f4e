8f4e/v1

note
; @config testRuntime.enabled true

Guarded memory access should
return zero instead of
trapping
for unsafe addresses.
noteEnd

entry test
module guardedIntLoadAssertions
; Unsafe integer loads should
; return zero instead of
; trapping.
push -1
load
assertEqual 0

push 65533
load
assertEqual 0

push 2147483647
load
assertEqual 0
moduleEnd

module guardedFloatLoadAssertions
; Unsafe float loads should
; return zero instead of
; trapping.
push -1
loadFloat
assertEqual 0.0

push 65533
loadFloat
assertEqual 0.0

push 2147483647
loadFloat
assertEqual 0.0
moduleEnd

module guardedLocalPointerDereferenceAssertions
; Unsafe pointer dereferences
; inside impure functions should
; return zero.
int value

push &value
push 4
sub
call readGuardedPointer
assertEqual 0

push &value
push 65533
add
call readGuardedPointer
assertEqual 0

push &value
push 2147483647
add
call readGuardedPointer
assertEqual 0
moduleEnd
entryEnd

function readGuardedPointer
#impure
param int* ptr

push *ptr
functionEnd int
