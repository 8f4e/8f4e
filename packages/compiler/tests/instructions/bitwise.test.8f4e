push 3
push 6
and
assertEqual 2
moduleEnd
module xorAssertions
; @pos 39 9
; `xor` should return only bits
; that differ between operands.
push 1
push 0
xor
assertEqual 1

push 3
push 6
xor
assertEqual 5
moduleEnd
module orAssertions
; @pos 82 -6
; `or` should return the bits
; present in either operand.
push 1
push 0
or
assertEqual 1

push 3
push 6
or
assertEqual 7
moduleEnd
module shiftRightAssertions
; @pos 82 9
; shiftRight moves integer bits
; right by the requested amount.
push 1
push 1
shiftRight
assertEqual 0

push 8
push 2
shiftRight
assertEqual 2

push 12
push 3
shiftRight
assertEqual 1
moduleEnd
