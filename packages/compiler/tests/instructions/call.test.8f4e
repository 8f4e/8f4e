8f4e/v1

function readScaledBlep
; @pos 14 12
#impure
param float* lut
param int phaseIndex
param float delta

local float* lutPtr

push lut
push phaseIndex
push sizeof(*lut)
mul
add
localSet lutPtr

push *lutPtr
push delta
mul
functionEnd float

function scaleInto
; @pos 14 34
#impure
param float* dst
param float* src
param float gain

push dst
push src
loadFloat
push gain
mul
store
functionEnd

function getDoublePI
; @pos 14 52
push 3.14159265358979f64
push 2.0f64
mul
functionEnd float64

