entry test
module callPointerParamsWithLocalDereference
; @pos 49 11
; Impure functions can
; dereference pointer parameters
; and use
; pointee metadata.
float[] lut 32
float delta 0.5

push &lut
push 1.0
store

push &lut
push 0
push delta
call readScaledBlep
assertEqual 0.5
moduleEnd
module callImpureFunctionWithExplicitLoadAndStore
; @pos 49 32
; Impure functions can
; explicitly load and store
; through pointer
; parameters.
float input 3.5
float output
float gain 0.5

push &output
push &input
push gain
call scaleInto

push output
assertEqual 1.75
moduleEnd
module callFloat64ReturningFunction
; @pos 49 52
; Float64-returning functions
; should keep float64 arithmetic
; in
; the callee.
call getDoublePI
assertEqual 6.28318530717958f64
moduleEnd
module callConstantFunction
; @pos 49 63
; Calling a zero-parameter
; function should push its
; return
; value.
call getFortyTwo
assertEqual 42
moduleEnd
module callMultipleFunctions
; @pos 49 74
; Multiple calls can contribute
; values to the same expression.
call getTwo
call getThree
add
assertEqual 5
moduleEnd
module callFunctionWithParameter
; @pos 49 85
; Function parameters should
; receive stack arguments in
; declaration order.
push 5
call double
assertEqual 10

push 10
call double
assertEqual 20
moduleEnd
module inlineCallArguments
; Inline call arguments should
; be pushed in source order
; before invoking the function.
call mix 2 1.5
assertEqual 3.5
moduleEnd
module callFloat64RoundTrip
; @pos 49 100
; Float64 parameters and returns
; should preserve double
; precision through calls.
push 3.141592653589793f64
call identityFloat64
assertEqual 3.141592653589793f64
moduleEnd
module callNestedFunction
; @pos 49 111
; Functions can call other
; functions after signatures and
; indexes are collected.
call compute
assertEqual 42
moduleEnd
entryEnd
