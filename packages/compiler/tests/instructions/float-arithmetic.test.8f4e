entry test
module floatDivAssertions
; @pos 14 11
; Float division checks an
; explicit absolute error bound.
push 420.001
push 69.001
ensureNonZero
div
push 6.0869
; Absolute error is bounded
; by 0.001.
sub
abs
push 0.001
lessOrEqual
assert
moduleEnd
module floatMulAssertions
; @pos 14 30
; Float multiplication is
; approximate because
; WebAssembly stores
; these values as floats.
push 4.001
push 0.5
mul
push 2.0
; Absolute error is bounded
; by 0.001.
sub
abs
push 0.001
lessOrEqual
assert
moduleEnd
module floatAbsAssertions
; @pos 14 50
; abs returns positive float
; magnitudes.
push 1.1
abs
assertEqual 1.1

push -1.1
abs
assertEqual 1.1

push -69.1
abs
assertEqual 69.1

push 420.1
abs
assertEqual 420.1
moduleEnd
module castToIntAssertions
; @pos 14 72
; castToInt truncates toward
; zero.
push 1.1
castToInt
assertEqual 1

push -69.69
castToInt
assertEqual -69

push 0.001
castToInt
assertEqual 0

push 420.99
castToInt
assertEqual 420
moduleEnd
module castToFloatAssertions
; @pos 57 11
; castToFloat should preserve
; integer magnitude when
; converting
; to float.
push 1
castToFloat
assertEqual 1.0

push -69
castToFloat
assertEqual -69.0

push 0
castToFloat
assertEqual 0.0

push 420
castToFloat
assertEqual 420.0
moduleEnd
module roundAssertions
; @pos 57 35
; round follows the compiler's
; current half-down behavior.
push 4.1
round
assertEqual 4.0

push 4.5
round
assertEqual 4.0

push 4.51
round
assertEqual 5.0

push 4.6
round
assertEqual 5.0

push 4.9
round
assertEqual 5.0
moduleEnd
module sqrtAssertions
; @pos 57 61
; sqrt returns approximate float
; square roots.
push 4.001
sqrt
push 2.0
; Absolute error is bounded
; by 0.001.
sub
abs
push 0.001
lessOrEqual
assert

push 16.001
sqrt
push 4.0
; Absolute error is bounded
; by 0.001.
sub
abs
push 0.001
lessOrEqual
assert
moduleEnd
