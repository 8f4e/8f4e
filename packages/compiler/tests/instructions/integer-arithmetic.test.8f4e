8f4e/v1

note
; @config testRuntime.enabled true

Integer arithmetic behavior is
checked with native
assertions.
noteEnd

entry test
module addAssertions
; Addition keeps signed integer
; behavior across positive,
; negative, and zero operands.
push 2
push 2
add
assertEqual 4

push -1
push 1
add
assertEqual 0

push -69
push 0
add
assertEqual -69

push 420
push 0
add
assertEqual 420
moduleEnd

module subAssertions
; Subtraction keeps signed
; integer behavior across
; positive,
; negative, and zero operands.
push 2
push 2
sub
assertEqual 0

push -1
push 1
sub
assertEqual -2

push -69
push 0
sub
assertEqual -69

push 420
push 0
sub
assertEqual 420
moduleEnd

module mulAssertions
; Multiplication handles
; ordinary products and zero
; operands.
push 2
push 2
mul
assertEqual 4

push 2
push 0
mul
assertEqual 0
moduleEnd

module divAssertions
; Division works with a non-zero
; guard on the divisor.
push 100
push 10
ensureNonZero
div
assertEqual 10
moduleEnd

module remainderAssertions
; remainder works when the
; divisor is guarded as
; non-zero.
push 4
push 2
ensureNonZero
remainder
assertEqual 0

push 3
push 2
ensureNonZero
remainder
assertEqual 1
moduleEnd

module absAssertions
; abs returns positive integer
; magnitudes.
push 1
abs
assertEqual 1

push -1
abs
assertEqual 1

push -69
abs
assertEqual 69

push 420
abs
assertEqual 420

push 8
push -2
abs
div
assertEqual 4
moduleEnd
entryEnd
