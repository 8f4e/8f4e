module mapNumericTypeAssertions
; @pos 46 0

; int keys, int results.
call mapIntToInt 1
push 10
equal
assertEqual 1
call mapIntToInt 2
push 20
equal
assertEqual 1
call mapIntToInt 3
push -7
equal
assertEqual 1

