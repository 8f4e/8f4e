8f4e/v1

note
; @config testRuntime.enabled true

Literal and constant
expressions are executed as
regular
language tests.
noteEnd

entry test
module validConstantNameAssertions
; Constants with valid names are
; available as int, float, and
; declaration defaults.
const TEST1 420
const TEST2 420.69
const TEST3 69

push TEST1
assertEqual 420

push TEST2
assertEqual 420.69

int output3 TEST3
push output3
assertEqual 69
moduleEnd

module fractionLiteralAssertions
; Fraction literals work in
; push, memory declarations, and
; constants.
push 1/16
assertEqual 0.0625

int intFraction 1/16
push intFraction
assertEqual 0

float floatFraction 1/16
push floatFraction
assertEqual 0.0625

int intWholeFraction 8/2
push intWholeFraction
assertEqual 4

float negativeFraction -1/2
push negativeFraction
assertEqual -0.5

const MY_FRACTION 1/8
push MY_FRACTION
assertEqual 0.125
moduleEnd

module literalMulDivExpressionAssertions
; Literal-only multiplication
; and division fold in const,
; push,
; and memory contexts.
const MUL_RESULT 16*2
push MUL_RESULT
assertEqual 32

const DIV_RESULT 8/2
push DIV_RESULT
assertEqual 4

push 16*2
assertEqual 32

push 1/2
assertEqual 0.5

push 0x10*2
assertEqual 32

push 0x10/2
assertEqual 8

push 3.5*4
assertEqual 14.0

int multipliedDefault 4*3
push multipliedDefault
assertEqual 12

int[] literalSizedBuffer 4*2
push count(literalSizedBuffer)
assertEqual 8
moduleEnd

module constantExpressionAssertions
; Constants can reference
; constants and shape memory
; sizes.
const SIZE 8
int[] dividedBuffer SIZE/2
push count(dividedBuffer)
assertEqual 4

int[] multipliedBuffer SIZE*2
push count(multipliedBuffer)
assertEqual 16

const HALF SIZE/2
push HALF
assertEqual 4

const SIGNED -1/SIZE
push SIGNED
assertEqual -0.125

push SIZE/2
assertEqual 4

int defaultFromExpression SIZE/2
push defaultFromExpression
assertEqual 4
moduleEnd

module sizeAndCountExpressionAssertions
; sizeof and count expressions
; work in push and buffer sizing.
int16[] samples 4
push sizeof(samples)*2
assertEqual 4

const SIZE 8
push SIZE*sizeof(samples)
assertEqual 16

push sizeof(samples)*4
assertEqual 8

push 123*sizeof(samples)
assertEqual 246

push 2*SIZE
assertEqual 16

float[] floatSamples 8
float* ptr &floatSamples
push count(*ptr)
assertEqual 8

int8[] smallSamples 4
int8* smallPtr &smallSamples
push min(*smallPtr)
assertEqual -128

moduleEnd

module exponentExpressionAssertions
; Exponent expressions are
; supported for constants, push
; values,
; and buffer sizes.
const WIDTH 2^16
push WIDTH
assertEqual 65536

const SIZE 4
const TOTAL SIZE^3
push TOTAL
assertEqual 64

const EXP 8
const RESULT 2^EXP
push RESULT
assertEqual 256

push 2^SIZE
assertEqual 16

const MEMORY_EXP 3
int defaultFromExponent MEMORY_EXP^2
push defaultFromExponent
assertEqual 9

const BUFFER_BASE 2
int[] exponentialBuffer BUFFER_BASE^3
push count(exponentialBuffer)
assertEqual 8

int32[] samples 4
push sizeof(samples)^2
assertEqual 16
moduleEnd
entryEnd
