8f4e/v1

note
; @config testRuntime.enabled true

Stack instructions should
leave modules with an empty
stack
after assertions.
noteEnd

entry test
module dropAssertions
; drop removes the top value so
; later assertions can run on a
; clean stack.
push 1
drop

push 2
push 2
add
assertEqual 4
moduleEnd

module clearStackAssertions
; clearStack removes all values
; currently on the stack.
push 1
push 1
clearStack

push 3
push 4
add
assertEqual 7
moduleEnd

module blockIntAssertions
; blockEnd can return integer
; values from a nested stack
; region.
block
 push 69
blockEnd int
assertEqual 69

block
 push 1
blockEnd int
assertEqual 1

block
 push -420
blockEnd int
assertEqual -420
moduleEnd

module blockFloatAssertions
; blockEnd can return float
; values from a nested stack
; region.
block
 push 69.1
blockEnd float
assertEqual 69.1

block
 push 1.1
blockEnd float
assertEqual 1.1

block
 push -420.1
blockEnd float
assertEqual -420.1
moduleEnd
entryEnd
