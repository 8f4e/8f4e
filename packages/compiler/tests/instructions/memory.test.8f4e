8f4e/v1

note
; @config testRuntime.enabled true

Memory declarations and loads
can be asserted directly from
the language.
noteEnd

entry test
module loadFloatAssertions
; loadFloat reads the float
; value stored at an address.
float firstInput 69.1
push &firstInput
loadFloat
assertEqual 69.1

float secondInput 0.1
push &secondInput
loadFloat
assertEqual 0.1

float thirdInput -420.1
push &thirdInput
loadFloat
assertEqual -420.1
moduleEnd

module anonymousFloatDeclarationsCompile
; Anonymous float declarations
; can be read back through
; indexed
; module references.
float
push &this:0
loadFloat
assertEqual 0.0

float 3.14
push &this:1
loadFloat
assertEqual 3.14

const PI 3.14159
float PI
push &this:2
loadFloat
assertEqual 3.14159

float -2.5
push &this:3
loadFloat
assertEqual -2.5
moduleEnd

module intDeclarationAssertions
; Integer declarations cover
; named, anonymous, string, and
; constant-backed defaults.
int
push &this:0
load
assertEqual 0

int 42
push &this:1
load
assertEqual 42

int foo 42
push foo
assertEqual 42

int charValue "e"
push charValue
assertEqual 101

int "e"
push &this:4
load
assertEqual 101

const MY_VALUE 100
int MY_VALUE
push &this:5
load
assertEqual 100

int -42
push &this:6
load
assertEqual -42
moduleEnd

module intSplitByteDeclarationAssertions
; Split-byte defaults are packed
; into 32-bit integer values.
int splitHex 0xA8 0xFF
push splitHex
assertEqual -1459683328

int splitHexFull 0xA8 0xFF 0x00 0x00
push splitHexFull
assertEqual -1459683328

int 0xA8 0xFF
push &this:2
load
assertEqual -1459683328

int splitDecimal 32 64
push splitDecimal
assertEqual 541065216

int splitString "AB"
push splitString
assertEqual 1094844416

int splitDecimalFull 32 64 0 0
push splitDecimalFull
assertEqual 541065216

int 32 64
push &this:6
load
assertEqual 541065216

int 32
push &this:7
load
assertEqual 32

int mixedBytes 0xA8 255
push mixedBytes
assertEqual -1459683328
moduleEnd

module intConstantSplitByteDeclarationAssertions
; Constants can participate in
; split-byte defaults for named
; and
; anonymous memory.
const HI 32
const LO 64
int foo HI LO
push foo
assertEqual 541065216

int HI LO
push &this:1
load
assertEqual 541065216

int mixed 0xA8 LO
push mixed
assertEqual -1472200704

int 0xA8 LO
push &this:3
load
assertEqual -1472200704
moduleEnd

module intPointerDeclarationsCompile
; Anonymous pointer declarations
; default to address zero.
int*
push &this:0
load
assertEqual 0
moduleEnd
entryEnd
