note
; @config testRuntime.enabled true

Nested group memory exposures resolve pointer defaults and metadata queries.
Aliases use the backing declaration's type without allocating additional storage.
noteEnd

entry test
group processing
entry main
module root
int* groupedValue &audio:exposedValue
int observed
int metadata

push &observed
push *groupedValue
store
push &metadata
push count(audio:exposedValue)+sizeof(audio:exposedValue)
store

push observed
assertEqual 41
push metadata
assertEqual 5
moduleEnd

group audio
expose exposedValue &source:value

entry main
module source
int value 41
moduleEnd
entryEnd
groupEnd
entryEnd
groupEnd
entryEnd
