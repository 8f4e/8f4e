8f4e/v1

note
; @config testRuntime.enabled true

Modules and groups share declaration order. Nested groups execute where they appear between their parent's modules.
Each producer writes its output during execution, so the assertions require the complete declared sequence.
noteEnd

entry test
module rootA
int output
push &output
push 1
store
moduleEnd

group synth
expose input &voiceA:input
expose output &voiceB:output
init &input &rootA:output

entry main
module voiceA
int* input
int output
push *input
assertEqual 1
push &output
push 2
store
moduleEnd

group oscillator
expose input &tick:input
expose output &tick:output
init &input &voiceA:output

entry main
module tick
int* input
int output
push *input
assertEqual 2
push &output
push 3
store
moduleEnd
entryEnd
groupEnd

module skipped
; @disabled
push 0
assert
moduleEnd

module voiceB
int* input &oscillator:output
int output
push *input
assertEqual 3
push &output
push 4
store
moduleEnd
entryEnd
groupEnd

module rootB
int* input &synth:output
int output
push *input
assertEqual 4
push &output
push 5
store
moduleEnd

group tail
expose input &last:input
expose output &last:output
init &input &rootB:output

entry main
module last
int* input
int output
push *input
assertEqual 5
push &output
push 6
store
moduleEnd
entryEnd
groupEnd

module rootC
int* input &tail:output
push *input
assertEqual 6
moduleEnd
entryEnd
