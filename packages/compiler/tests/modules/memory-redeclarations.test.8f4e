8f4e/v1

note
; @config testRuntime.enabled true
noteEnd

entry test
module tau
int foo 1
int he 2
int bar 3

int he 10
int bar 44
int bar 8
int bar 16

push foo
assertEqual 1

; The last declaration wins for each repeated name.
push he
assertEqual 10

push bar
assertEqual 16

; Indexed reads of shadowed allocations retain the winning named defaults.
push &tau:1
load
assertEqual 10
push &tau:2
load
assertEqual 16
moduleEnd

module boson
int& test2 &tau:foo
int& test1 &tau:bar
int& test3 &tau:he

; Named references also select the last declaration.
push *test2
assertEqual 1

push *test1
assertEqual 16

push *test3
assertEqual 10
moduleEnd

module anonymousStorage
int 42
int 7
int __anonymous__1 19
push &anonymousStorage:0
load
assertEqual 42
push &anonymousStorage:1
load
assertEqual 7
push __anonymous__1
assertEqual 19
moduleEnd
entryEnd
