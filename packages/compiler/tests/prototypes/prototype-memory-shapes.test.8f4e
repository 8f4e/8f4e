8f4e/v1

note
; @config testRuntime.enabled true

describes a reusable module
memory shape with defaults
noteEnd

prototype oscillatorState
float phase
float frequency 440
prototypeEnd

entry test
module oscA
shape oscillatorState
int localA 11

; it expands prototype fields
; before local declarations
push phase
assertEqual 0.0

; it preserves default values
; from prototype fields
push frequency
assertEqual 440.0

; it preserves declarations
; written in the consuming
; module
push localA
assertEqual 11

; it lays out expanded prototype
; fields in declaration order
push &phase
push &frequency
lessThan
assertEqual 1

; it lays out local declarations
; after a leading shape
; instruction
push &frequency
push &localA
lessThan
assertEqual 1
moduleEnd

module oscB
int localB 22
shape oscillatorState

; it preserves declarations that
; appear before a shape
; instruction
push localB
assertEqual 22

; it expands prototype fields
; after earlier local
; declarations
push phase
assertEqual 0.0

; it reuses prototype defaults
; in each consuming module
push frequency
assertEqual 440.0

; it lays out shape fields after
; preceding local declarations
push &localB
push &phase
lessThan
assertEqual 1

; it allocates separate storage
; for each module that uses the
; shape
push &phase
push &oscA:phase
notEqual
assertEqual 1
moduleEnd
entryEnd
