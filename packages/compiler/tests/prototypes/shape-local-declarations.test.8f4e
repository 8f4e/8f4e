entry test
module tau
shape baryon

int he 10
int bar 44
int bar 8
int bar 16

; it preserves inherited shape
; declarations that are not
; locally
; redeclared
push foo
assertEqual 1

; it uses the later local
; declaration for a shape field
; redeclared in the module
push he
assertEqual 10

; it keeps the last local
; declaration addressable when
; the same
; field is redeclared more than
; once
push bar
assertEqual 16

; Indexed reads of shadowed allocations retain the winning named defaults.
push &tau:1
load
assertEqual 10
push &tau:2
load
assertEqual 16
moduleEnd

module boson
int& test2 &tau:foo
int& test1 &tau:bar
int& test3 &tau:he

; intermodule references resolve
; to the inherited declaration
push *test2
assertEqual 1

; intermodule references resolve
; to the final local declaration
; for repeated names
push *test1
assertEqual 16

; intermodule references resolve
; to the local declaration that
; overrides a shape field
push *test3
assertEqual 10
moduleEnd

