function verifyEntries
; @pos 62 22
#impure
param int* mainValue
param int* auxValue
param int* initValue
; initDefaults runs before this
; function, but it should not
; execute the user-authored init
; entry.
push *initValue
assertEqual 0

call main
push *mainValue
assertEqual 1

call aux
push *auxValue
assertEqual 2

call init
push *initValue
assertEqual 7
functionEnd

