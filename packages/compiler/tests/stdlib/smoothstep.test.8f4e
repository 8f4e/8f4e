8f4e/v1

note
; @config testRuntime.enabled true
noteEnd

includes
include std/math/smoothstep
includesEnd

entry test
module smoothstepAssertions
; it maps 0..1 to a smooth
; eased 0..1 curve.
push 0.0
call smoothstep
push 100.0
mul
castToInt
assertEqual 0

push 0.5
call smoothstep
push 100.0
mul
castToInt
assertEqual 50

push 1.0
call smoothstep
push 100.0
mul
castToInt
assertEqual 100
moduleEnd
entryEnd
