8f4e/v1

note
; @config testRuntime.enabled true
noteEnd

includes
include std/math/smoothstep
includesEnd

entry test
module smoothstepAssertions
; it maps 0..1 to a smooth
; eased 0..1 curve.
push 0.0
call smoothstep
push 100.0
mul
castToInt
assertEqual 0

push 0.5
call smoothstep
push 100.0
mul
castToInt
assertEqual 50

push 1.0
call smoothstep
push 100.0
mul
castToInt
assertEqual 100
moduleEnd
module smoothstepDoubleAssertions
call smoothstep 0.0f64
assertEqual 0.0f64
call smoothstep 0.25f64
assertEqual 0.15625f64
call smoothstep 0.5f64
assertEqual 0.5f64
call smoothstep 0.75f64
assertEqual 0.84375f64
call smoothstep 1.0f64
assertEqual 1.0f64
; The cubic is evaluated without clamping.
call smoothstep -1.0f64
assertEqual 5.0f64
call smoothstep 2.0f64
assertEqual -4.0f64
moduleEnd

entryEnd
