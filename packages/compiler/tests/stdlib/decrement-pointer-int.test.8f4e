8f4e/v1

note
; @config testRuntime.enabled true
noteEnd

includes
include std/memory/decrementPointer
includesEnd

entry test
module decrementPointerIntAssertions
; it decrements and wraps a
; mutable int pointer within a
; circular buffer.
int[] buffer 3 1
int* pointer &buffer

push &pointer
push &buffer
push count(buffer)
call decrementPointer

push pointer
push end(buffer)
push sizeof(buffer)
sub
equal
assert

push &pointer
push &buffer
push count(buffer)
call decrementPointer

push pointer
assertEqual &buffer+sizeof(buffer)

push &pointer
push &buffer
push count(buffer)
call decrementPointer

push pointer
assertEqual &buffer
moduleEnd
entryEnd
