8f4e/v1

note
; @config testRuntime.enabled true
noteEnd

includes
include std/events/triggerToGate
includesEnd

entry test
module triggerToGateIntAssertions
; it holds an int trigger open
; for the requested duration.
int remainingSamples

push 0
push 3
call triggerToGate &remainingSamples
assertEqual 0
push remainingSamples
assertEqual 0

push 1
push 3
call triggerToGate &remainingSamples
assertEqual 1
push remainingSamples
assertEqual 2

push 0
push 3
call triggerToGate &remainingSamples
assertEqual 1
push remainingSamples
assertEqual 1

push 0
push 3
call triggerToGate &remainingSamples
assertEqual 1
push remainingSamples
assertEqual 0

push 0
push 3
call triggerToGate &remainingSamples
assertEqual 0

push 1
push 2
call triggerToGate &remainingSamples
assertEqual 1
push remainingSamples
assertEqual 1

push 1
push 4
call triggerToGate &remainingSamples
assertEqual 1
push remainingSamples
assertEqual 3
moduleEnd

module triggerToGateFloatAssertions
; it treats positive float
; values as triggers.
int remainingSamples

push 0.0
push 2
call triggerToGate &remainingSamples
assertEqual 0

push 0.5
push 2
call triggerToGate &remainingSamples
assertEqual 1
push remainingSamples
assertEqual 1

push -0.5
push 2
call triggerToGate &remainingSamples
assertEqual 1
push remainingSamples
assertEqual 0

push 0.0
push 2
call triggerToGate &remainingSamples
assertEqual 0
moduleEnd
entryEnd
