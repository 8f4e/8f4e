8f4e/v1

note
; @config testRuntime.enabled true
noteEnd

includes
include std/memory/swapPointers
includesEnd

entry test
module swapIntPointers
; Keep pointer values above one byte.
int8u[] padding 300
int guardBefore 0x12345678
int[] left 2 123456789 123456789
int[] right 2 -987654321 -987654321
int* first &left
int* second &right
int* empty
int* zero
int guardAfter 0x76543210

call swapPointers &first &second
push first
assertEqual &right
push second
assertEqual &left
; Pointee contents stay unchanged.
push *first
assertEqual -987654321
push *second
assertEqual 123456789

; A second swap restores the pair.
call swapPointers &first &second
push first
assertEqual &left
push second
assertEqual &right

; Aliased slots are safe.
call swapPointers &first &first
push first
assertEqual &left

; Null pointer values are swapped
; without dereferencing a pointee.
call swapPointers &first &empty
push first
push zero
equal
assert
push empty
assertEqual &left
call swapPointers &first &empty
push first
assertEqual &left
push empty
push zero
equal
assert

call swapPointers &empty &zero
push empty
push zero
equal
assert
push guardBefore
assertEqual 0x12345678
push guardAfter
assertEqual 0x76543210
moduleEnd

module swapInt8Pointers
; Keep pointer values above one byte.
int8u[] padding 300
int guardBefore 0x12345678
int8[] left 2 -64 -64
int8[] right 2 63 63
int8* first &left
int8* second &right
int8* empty
int8* zero
int guardAfter 0x76543210

call swapPointers &first &second
push first
assertEqual &right
push second
assertEqual &left
; Pointee contents stay unchanged.
push *first
assertEqual 63
push *second
assertEqual -64

; A second swap restores the pair.
call swapPointers &first &second
push first
assertEqual &left
push second
assertEqual &right

; Aliased slots are safe.
call swapPointers &first &first
push first
assertEqual &left

; Null pointer values are swapped
; without dereferencing a pointee.
call swapPointers &first &empty
push first
push zero
equal
assert
push empty
assertEqual &left
call swapPointers &first &empty
push first
assertEqual &left
push empty
push zero
equal
assert

call swapPointers &empty &zero
push empty
push zero
equal
assert
push guardBefore
assertEqual 0x12345678
push guardAfter
assertEqual 0x76543210
moduleEnd

