note
; @config testRuntime.enabled true
noteEnd

includes
include std/math/pow2
includesEnd

entry test
module pow2Assertions
; it raises 2 to an integer
; exponent.
push 0
call pow2
assertEqual 1

push 1
call pow2
assertEqual 2

push 5
call pow2
assertEqual 32

push 10
call pow2
assertEqual 1024
moduleEnd
entryEnd
