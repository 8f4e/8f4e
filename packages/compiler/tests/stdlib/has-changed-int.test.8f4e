8f4e/v1

note
; @config testRuntime.enabled true
noteEnd

includes
include std/events/hasChanged
includesEnd

entry test
module hasChangedIntAssertions
; it returns true when an
; integer value differs from its
; previous value and stores the
; current value.
int previousInt

push 0
call hasChanged &previousInt
assertEqual 0
push previousInt
assertEqual 0

push 4
call hasChanged &previousInt
assertEqual 1
push previousInt
assertEqual 4

push 4
call hasChanged &previousInt
assertEqual 0

push -2
call hasChanged &previousInt
assertEqual 1
push previousInt
assertEqual -2
moduleEnd
entryEnd
