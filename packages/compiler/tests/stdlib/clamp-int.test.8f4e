8f4e/v1

note
; @config testRuntime.enabled true
noteEnd

includes
include std/math/clamp
includesEnd

entry test
module clampIntAssertions
; it clamps integer values to
; the provided inclusive range.
push 7
push 0
push 5
call clamp
assertEqual 5

push -2
push 0
push 5
call clamp
assertEqual 0

push 3
push 0
push 5
call clamp
assertEqual 3
moduleEnd
entryEnd
