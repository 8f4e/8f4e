note
; @config testRuntime.enabled true
noteEnd

includes
include std/stack/swap
includesEnd

entry test
module swapAssertions
; it swaps two int values.
push 1
push 2
call swap
assertEqual 1
assertEqual 2

; it swaps an int and a float.
push 3
push 4.5
call swap
assertEqual 3
assertEqual 4.5

; it swaps a float and an int.
push 5.5
push 6
call swap
assertEqual 5.5
assertEqual 6

; it swaps two float values.
push 7.25
push 8.75
call swap
assertEqual 7.25
assertEqual 8.75
moduleEnd
entryEnd
