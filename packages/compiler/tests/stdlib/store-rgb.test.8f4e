entry test
module rgbWrites
; Two adjacent pixels with guarded, unaligned storage.
int8u[] storage 8 0xa5 0xcc 0xcc 0xcc 0xcc 0xcc 0xcc 0x5a
int8u* first &storage
int8u* next &storage

push &first
push &storage
add 1
store
push &next
push &storage
add 4
store

call storeRGB first 0x123456
push &storage
add 0
load8u
