8f4e/v1

note
; @config testRuntime.enabled true
noteEnd

includes
include std/memory/wrapPointer
includesEnd

entry test
module wrapPointerIntAssertions
; it wraps int pointer
; addresses before and after a
; circular buffer.
int[] buffer 4 7
int* pointer &buffer

push pointer
push sizeof(buffer)*2
add
push &buffer
push count(buffer)
call wrapPointer
assertEqual &buffer+8

push pointer
push count(buffer)
push sizeof(buffer)
mul
add
push &buffer
push count(buffer)
call wrapPointer
assertEqual &buffer

push pointer
push sizeof(buffer)
sub
push &buffer
push count(buffer)
call wrapPointer
assertEqual buffer&
moduleEnd
entryEnd
