8f4e/v1

note
; @config testRuntime.enabled true
noteEnd

includes
include std/memory/loadAt
includesEnd

entry test
module loadAtAssertions
; it reads an integer element
; from buffer[index].
int[] buffer 4 11 22 33 44

push &buffer
push 0
call loadAt
assertEqual 11

push &buffer
push 2
call loadAt
assertEqual 33

push &buffer
push 3
call loadAt
assertEqual 44
moduleEnd
module loadAtByteAssertions
int8u[] buffer 4 11 128 255 44

call loadAt &buffer 0
assertEqual 11
call loadAt &buffer 1
assertEqual 128
call loadAt &buffer 2
assertEqual 255
call loadAt &buffer 3
assertEqual 44
moduleEnd
entryEnd
