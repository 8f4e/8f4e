8f4e/v1

note
; @config testRuntime.enabled true
noteEnd

includes
include std/memory/loadAt
includesEnd

entry test
module loadAtAssertions
; it reads an integer element
; from buffer[index].
int[] buffer 4 11 22 33 44

push &buffer
push 0
call loadAt
assertEqual 11

push &buffer
push 2
call loadAt
assertEqual 33

push &buffer
push 3
call loadAt
assertEqual 44
moduleEnd
entryEnd
