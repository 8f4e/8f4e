8f4e/v1

note
; @config testRuntime.enabled true
noteEnd

includes
include std/math/lerp
includesEnd

entry test
module lerpAssertions
; it linearly interpolates
; between two float values.
push 10.0
push 20.0
push 0.0
call lerp
castToInt
assertEqual 10

push 10.0
push 20.0
push 0.5
call lerp
castToInt
assertEqual 15

push 10.0
push 20.0
push 1.0
call lerp
castToInt
assertEqual 20
moduleEnd
module lerpDoubleAssertions
; Double precision is retained.
call lerp 1.0000000000000002f64 1.0000000000000007f64 0.5f64
assertEqual 1.0000000000000004f64
call lerp 10.0f64 20.0f64 0.0f64
assertEqual 10.0f64
call lerp 10.0f64 20.0f64 1.0f64
assertEqual 20.0f64
call lerp 20.0f64 10.0f64 0.25f64
assertEqual 17.5f64
call lerp -10.0f64 10.0f64 0.5f64
assertEqual 0.0f64
; Like float lerp, amounts can extrapolate.
call lerp 10.0f64 20.0f64 -1.0f64
assertEqual 0.0f64
call lerp 10.0f64 20.0f64 2.0f64
assertEqual 30.0f64
moduleEnd

entryEnd
