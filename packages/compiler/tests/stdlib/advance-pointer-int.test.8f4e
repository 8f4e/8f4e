8f4e/v1

note
; @config testRuntime.enabled true
noteEnd

includes
include std/memory/advancePointer
includesEnd

entry test
module advancePointerIntAssertions
; it advances and wraps a
; mutable int pointer within a
; circular buffer.
int[] buffer 3 1
int* pointer &buffer

push &pointer
push &buffer
push count(buffer)
call advancePointer

push pointer
assertEqual &buffer+sizeof(buffer)

push &pointer
push &buffer
push count(buffer)
call advancePointer

push pointer
assertEqual buffer&

push &pointer
push &buffer
push count(buffer)
call advancePointer

push pointer
assertEqual &buffer
moduleEnd
entryEnd
