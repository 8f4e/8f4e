entry test
module cosineAssertions
; it approximates cosine at
; cardinal phase points.
push 0.0
call cosine
push 1.0
; Absolute error is bounded
; by 0.001.
sub
abs
push 0.001
lessOrEqual
assert

push 1.570796326794896
call cosine
push 0.0
; Absolute error is bounded
; by 0.001.
sub
abs
push 0.001
lessOrEqual
assert

push 3.141592653589793
call cosine
push -1.0
; Absolute error is bounded
; by 0.001.
sub
abs
push 0.001
lessOrEqual
assert

push -1.570796326794896
call cosine
push 0.0
; Absolute error is bounded
; by 0.001.
sub
abs
push 0.001
lessOrEqual
assert
moduleEnd
