8f4e/v1

note
; @config testRuntime.enabled true
noteEnd

includes
include std/math/trig/triangle
includesEnd

entry test
module triangleAssertions
; it maps [-PI, PI] to a
; triangle in [-1, 1].
push -3.141592653589793
call triangle
assertEqual -1.0

push -1.570796326794896
call triangle
assertEqual 0.0

push 0.0
call triangle
assertEqual 1.0

push 1.570796326794896
call triangle
assertEqual 0.0

push 3.141592653589793
call triangle
assertEqual -1.0
moduleEnd
entryEnd
