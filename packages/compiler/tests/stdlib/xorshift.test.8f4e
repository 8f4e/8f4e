includes
include std/random/xorshift
includesEnd

entry test
module xorshiftAssertions
; it advances and stores a
; signed 32-bit XORShift seed.
int seed 69420

push &seed
call xorshift
assertEqual 494363678
push seed
assertEqual 494363678

push &seed
call xorshift
assertEqual -814792604
push seed
assertEqual -814792604

push &seed
call xorshift
assertEqual -887510667
push seed
assertEqual -887510667
moduleEnd
entryEnd
