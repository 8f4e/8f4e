entry test
module sineAssertions
; it approximates sine at
; cardinal phase points.
push 0.0
call sine
push 0.0
; Absolute error is bounded
; by 0.001.
sub
abs
push 0.001
lessOrEqual
assert

push 1.570796326794896
call sine
push 1.0
; Absolute error is bounded
; by 0.001.
sub
abs
push 0.001
lessOrEqual
assert

push 3.141592653589793
call sine
push 0.0
; Absolute error is bounded
; by 0.001.
sub
abs
push 0.001
lessOrEqual
assert

push -1.570796326794896
call sine
push -1.0
; Absolute error is bounded
; by 0.001.
sub
abs
push 0.001
lessOrEqual
assert
moduleEnd
entryEnd
