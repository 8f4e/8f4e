constantsEnd

note
; @pos 15 38
; @config testRuntime.enabled true

Continuation lines append one
or more arguments to the
previous instruction.
noteEnd

function sumThree
param int a
param int b
param int c

push a
add b
add c
functionEnd int

entry test
module continuationPointerSource
; @pos 15 28
; The split pointer declaration
; below should resolve the same
; intermodule address as a
; single-line declaration.
float[] samples 8 0.0
moduleEnd
module splitPointerDeclarationAssertions
; @pos 57 28
; Declaration arguments can be
; continued one argument per
; line.
float* ; continued pointer declaration
- readHead ; pointer name
- &continuationPointerSource:samples ; initial address

push readHead
assertEqual &continuationPointerSource:samples
moduleEnd
module splitByteDefaultAssertions
; @pos 57 43
; Split-byte defaults can be
; supplied by continuation
; lines.
int color; continued split-byte default
- 0xA8; first byte
- 0xFF ; second byte

push color
assertEqual -1459683328
moduleEnd
module continuedNegativeLiteralAssertions
; @pos 57 58
; A continuation marker before a
; negative literal should be
; treated as syntax, not as the
; literal sign.
push ; continued negative literal
- -1; literal value
assertEqual -1
moduleEnd
module groupedArgumentAssertions
; @pos 100 28
; Groups can supply declaration
; defaults and function arguments.
int[] values ; declaration comment
- 4 1 -2 ; count and first values
- 3 4 ; remaining values

push &values
load
assertEqual 1

push &values
add sizeof(values)
load
assertEqual -2

push &values
add sizeof(values)*3
load
assertEqual 4

call sumThree
- 1 -2 3 ; all call arguments
assertEqual 2

call sumThree 1
- -2 3 ; remaining call arguments
assertEqual 2
moduleEnd
entryEnd
