8f4e/v1

note
; @config testRuntime.enabled true
noteEnd

includes
include test/recursive countdown sumDown
include test/recursive throughAlias viaAlias
include test/recursive delegate delegated
includesEnd

function descend
param int remaining
push 100
functionEnd int

function countdown
param int remaining
push 200
functionEnd int

function external
param int value
push value
push 5
add
functionEnd int

entry test
module recursiveIncludeAssertions
; Recursion follows the renamed included definition.
call sumDown 3
assertEqual 6
call viaAlias 3
assertEqual 6

; Calls in project code keep their original targets.
call descend 3
assertEqual 100
call countdown 3
assertEqual 200

; A target outside the included source stays unchanged.
call delegated 10
assertEqual 15
moduleEnd
entryEnd
