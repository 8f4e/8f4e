module nthAddressAssertions
; @pos 55 113
; &module:0 is the first memory
; item and matches the module
; base
; address.
int* first &nthAddressSource:0
int* base &nthAddressSource:
int* second &nthAddressSource:1
int* third &nthAddressSource:2

push first
push base
equal
assertEqual 1

push *first
assertEqual 10

push *second
assertEqual 20

push *third
assertEqual 30
moduleEnd
module nthArrayAssertions
; @pos 58 44
int* scalar &nthArraySource:1

push *scalar
assertEqual 60
moduleEnd
module currentModuleShorthandAssertions
; @pos 58 78
; Current-module shorthand
; references should resolve
; start, end,
; and nth declaration addresses.
int a 10
int b 20
int[] tail 2 30 40
int* moduleStart &this
int* moduleEndPtr this&
int* second &this:1

push *moduleStart
assertEqual 10

push *second
assertEqual 20

push moduleEndPtr
push &moduleEndPtr
push sizeof(moduleEndPtr)
add
equal
assertEqual 1
moduleEnd
module addressReferenceAssertions
; @pos 63 6
; Start-address references
; should point at the first
; value.
int* bufferStart &addressSource:buffer
int* moduleStart &addressSource:

push *bufferStart
assertEqual 11

push *moduleStart
assertEqual 11

; End-address references should
; point at the final
; word-aligned
; element.
int* bufferEnd addressSource:buffer&
int* scalarEnd addressSource:scalar&
int* moduleEnd addressSource:&

push *bufferEnd
assertEqual 33

push *scalarEnd
assertEqual 42

push *moduleEnd
assertEqual 99
moduleEnd
module outOfOrderAddressAssertions
; @pos 73 58
; Named start and end references
; can resolve to modules
; declared
; later in the entry.
int* start &lateAddressSource:buffer
int* end lateAddressSource:buffer&

push *start
assertEqual 5

push *end
assertEqual 8
moduleEnd
module zzFloat64First
; Leading padding must not move an end address into the next declaration.
int prefix 0
float64 padded 1.25f64
int next 99
int alignment 0
float64 aligned 1.25f64
int alignedNext 99

push padded&
load
assertEqual 1072955392
push aligned&
load
assertEqual 1072955392
moduleEnd
module zzFloat64Second
float64[] padded 2 1.25f64 1.25f64
int next 99
int alignment 0
float64[] aligned 2 1.25f64 1.25f64
int alignedNext 99

push padded&
load
assertEqual 1072955392
push aligned&
load
assertEqual 1072955392
moduleEnd
module zzFloat64Third
push zzFloat64First:padded&
load
assertEqual 1072955392
push zzFloat64First:aligned&
load
assertEqual 1072955392
push zzFloat64Second:padded&
load
assertEqual 1072955392
push zzFloat64Second:aligned&
load
assertEqual 1072955392
moduleEnd
