{
  "name": "@8f4e/editor-plugin-worker-runtime",
  "sourceRoot": "src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf dist && tsc",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.test.json",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "^build"
      ]
    }
  },
  "tags": [
    "type:library",
    "scope:editor"
  ]
}
