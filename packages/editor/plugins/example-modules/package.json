{
  "name": "@8f4e/editor-plugin-example-modules",
  "version": "0.0.12",
  "private": true,
  "description": "Example module browsing and insertion for the 8f4e editor",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    },
    "./public-block": {
      "types": "./dist/extractPublicBlockFromModuleSource.d.ts",
      "default": "./dist/extractPublicBlockFromModuleSource.js"
    }
  },
  "sideEffects": false,
  "author": "Andor Polgar",
  "license": "MIT",
  "dependencies": {
    "@8f4e/editor-core": "*",
    "@8f4e/editor-state": "*",
    "@8f4e/editor-state-types": "*",
    "@8f4e/compiler": "*",
    "@8f4e/tokenizer": "*"
  },
  "devDependencies": {
    "@8f4e/config": "*",
    "@8f4e/web-ui": "*",
    "vitest": "4.1.7",
    "@vitest/browser-playwright": "4.1.7",
    "@vitest/browser": "4.1.7"
  }
}
