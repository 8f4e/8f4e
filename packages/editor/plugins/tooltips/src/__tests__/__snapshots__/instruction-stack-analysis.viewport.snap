                                                                                                
                                                                                                
                                                                                                
                                                                                                
                                                                                                
                                                                                                
                                                                                                
                                                                                                
                         add (T T -- T)                                                         
                         Adds two numbers of the same                                           
                         type and pushes the result.                                            
                         before [-int=1, -int=2]                                                
                         after: [+int=3]                                                        
                                                                                                
                                                                                                
                                                                                                
                                                                                                
                                                                                                
                                                                                                
                                                                                                
