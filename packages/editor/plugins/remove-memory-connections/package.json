    "@8f4e/language-spec": "*",
    "@8f4e/tokenizer": "*"
  },
  "devDependencies": {
    "@8f4e/config": "*",
    "@8f4e/compiler": "*",
    "@8f4e/web-ui": "*",
    "vitest": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/browser": "4.1.12"
  }
