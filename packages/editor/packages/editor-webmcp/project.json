{
  "name": "@8f4e/editor-webmcp",
  "sourceRoot": "src",
  "projectType": "library",
  "targets": {
    "build": { "executor": "nx:run-commands", "outputs": ["{projectRoot}/dist"], "options": { "command": "tsc", "cwd": "{projectRoot}" } },
    "test": { "executor": "nx:run-commands", "dependsOn": ["^build"], "options": { "command": "vitest run", "cwd": "{projectRoot}" } },
    "typecheck": { "executor": "nx:run-commands", "options": { "command": "tsc --noEmit -p tsconfig.test.json", "cwd": "{projectRoot}" } },
    "lint": { "executor": "nx:run-commands", "options": { "command": "biome check --write packages/editor/packages/editor-webmcp/src", "cwd": "{workspaceRoot}" } }
  },
  "tags": ["type:library", "scope:editor"]
}
