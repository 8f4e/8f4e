{
  "name": "@8f4e/runtime-test-runner",
  "version": "0.2.7",
  "private": true,
  "description": "8f4e runtime that executes tests once after compilation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime-def": {
      "types": "./dist/runtimeDef.d.ts",
      "default": "./dist/runtimeDef.js"
    }
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/8f4e/8f4e.git"
  },
  "author": "Andor Polgar",
  "license": "MIT",
  "dependencies": {
    "@8f4e/language-spec": "*",
    "@8f4e/test-runner": "*"
  },
  "peerDependencies": {
    "@8f4e/editor-core": "*",
    "@8f4e/state-manager": "*"
  },
  "devDependencies": {
    "@8f4e/editor-state-testing": "*",
    "@8f4e/compiler": "*",
    "@8f4e/config": "*",
    "@types/node": "24.13.2",
    "vitest": "4.1.7"
  }
}
