{
  "name": "@8f4e/editor-website",
  "sourceRoot": "src",
  "projectType": "application",
  "targets": {
    "dev": {
      "continuous": true,
      "executor": "nx:run-commands",
      "dependsOn": ["watch-deps"],
      "options": {
        "command": "vite",
        "cwd": "{projectRoot}"
      }
    },
    "build-deps": {
      "executor": "nx:noop",
      "dependsOn": ["^build"]
    },
    "watch-deps": {
      "continuous": true,
      "executor": "nx:run-commands",
      "dependsOn": ["build-deps"],
      "options": {
        "command": "nx watch --projects=@8f4e/editor-website --includeDependencies -- nx run @8f4e/editor-website:build-deps",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome check --write packages/editor/packages/editor-website/src",
        "cwd": "{workspaceRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "vite build",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["typecheck:production", "^build"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["build"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit --project tsconfig.json",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"]
    },
    "typecheck:production": {
      "executor": "nx:run-commands",
      "inputs": ["production", "^production"],
      "cache": true,
      "options": {
        "command": "tsc --noEmit --project tsconfig.production.json",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"]
    },
    "test:browser": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "playwright test",
        "cwd": "{projectRoot}"
      }
    },
    "kill-dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "lsof -ti tcp:3000 | xargs -r kill",
        "cwd": "{workspaceRoot}"
      }
    }
  },
  "tags": ["type:application", "scope:editor"]
}
