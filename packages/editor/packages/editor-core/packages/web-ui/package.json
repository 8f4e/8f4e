  "repository": {
    "type": "git",
    "url": "git+https://github.com/8f4e/8f4e.git"
  },
  "author": "Andor Polgar",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/8f4e/8f4e/issues"
  },
  "homepage": "https://github.com/8f4e/8f4e#readme",
  "dependencies": {
    "@8f4e/editor-palette": "*",
    "@8f4e/editor-state": "*",
    "@8f4e/editor-state-types": "*",
    "@8f4e/language-spec": "*",
    "@8f4e/sprite-generator": "*",
    "@8f4e/web-ui-render-projection": "*",
    "glugglugglug": "*"
  },
  "devDependencies": {
    "@8f4e/editor-state-testing": "*",
    "@vitest/browser": "4.1.7",
    "@vitest/browser-playwright": "4.1.7",
